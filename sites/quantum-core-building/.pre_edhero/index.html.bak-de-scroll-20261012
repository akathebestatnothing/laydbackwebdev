function draw(p){
  if(!isFinite(p))p=0;
  var AZC=-0.55+p*0.25+mx*0.04+azO;
  var ca=Math.cos(AZC),sa=Math.sin(AZC);
  var el=0.28+0.04*p-my*0.025,ce=Math.cos(el),se=Math.sin(el);
  var D=(W<640?28:35)*(1-0.08*p),f=1.5*Math.min(H,W*0.8),camY=5.5,yA=0.55;
  function proj(x,y,z){
    var xa=x*ca-z*sa,za=x*sa+z*ca,yy=y-camY;
    var vy=yy*ce+za*se,vz=-yy*se+za*ce+D,s=f/Math.max(6,vz);
    return {x:W/2+xa*s,y:H*yA-vy*s,s:s,vz:vz};
  }
  /* sky + ground wash */
  var g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,'#000000');g.addColorStop(0.5,'#050505');g.addColorStop(1,'#000000');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
