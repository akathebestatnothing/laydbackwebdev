  if(gridAlpha>0.01){
    ctx.strokeStyle='rgba(255,165,0,'+(0.04*gridAlpha)+')';ctx.lineWidth=1;
    for(var x=-14;x<=14;x+=1.5){var pa=proj(x,0.01,-10);var pb=proj(x,0.01,10);ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();}
    for(var z=-10;z<=10;z+=1.5){var pa=proj(-14,0.01,z);var pb=proj(14,0.01,z);ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();}
  }
  /* scan lines sweeping across grid */
  var scanAlpha=CL(1-p*0.9,0,1);
  if(scanAlpha>0.01 && p<0.9){
    var scanY=(p*0.8)%1.0;
    var scanYworld=-10+scanY*20;
    ctx.strokeStyle='rgba(255,184,51,'+(0.3*scanAlpha)+')';ctx.lineWidth=2;
    var pa=proj(-14,0.02,scanYworld),pb=proj(14,0.02,scanYworld);
    ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();
    /* glow */
    ctx.strokeStyle='rgba(255,184,51,'+(0.08*scanAlpha)+')';ctx.lineWidth=8;
    ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();
  }
  /* ground shadow */
  var c0=proj(0,0.02,0);
  if(c0.s>0){ctx.fillStyle='rgba(0,0,0,.4)';ctx.beginPath();ctx.ellipse(c0.x,c0.y,c0.s*10,c0.s*3,0,0,6.283);ctx.fill();}
  /* pieces */
  var faces=[];
  var i,j,o,q,sp;
  for(i=0;i<pieces.length;i++){
    o=pieces[i];
    q=EZ(CL((p-o.t0)/o.dur,0,1));
    if(q<=0)continue;
    sp=o.spin*(1-q);
    var k=1-q,ox=o.fly[0]*k,oy=o.fly[1]*k,oz=o.fly[2]*k;
    var vs=[];
    for(j=0;j<8;j++){
      var l=[o.sx*((j&1)?.5:-.5),o.sy*((j&2)?.5:-.5),o.sz*((j&4)?.5:-.5)];
      if(o.rot)l=rotXv(l,o.rot);
      if(sp>0.001)l=rotAv(l,o.axis,sp);
      var wx=o.cx+ox+l[0],wy=o.cy+oy+l[1],wz=o.cz+oz+l[2];
      var pr=proj(wx,wy,wz);
      if(!isFinite(pr.x)||!isFinite(pr.y)){vs=null;break;}
      vs.push({x:pr.x,y:pr.y,vz:pr.vz,wx:wx,wy:wy,wz:wz});
    }
    if(!vs)continue;
    for(j=0;j<6;j++){
      var fc=FACES[j],a=vs[fc[0]],b=vs[fc[1]],c=vs[fc[2]],d2=vs[fc[3]];
      var e1x=b.wx-a.wx,e1y=b.wy-a.wy,e1z=b.wz-a.wz,e2x=c.wx-a.wx,e2y=c.wy-a.wy,e2z=c.wz-a.wz;
      var nx=e1y*e2z-e1z*e2y,ny=e1z*e2x-e1x*e2z,nz=e1x*e2y-e1y*e2x;
      var nl=Math.sqrt(nx*nx+ny*ny+nz*nz)||1;nx/=nl;ny/=nl;nz/=nl;
      var lam=nx*LX+ny*LY+nz*LZ;if(lam<0){nx=-nx;ny=-ny;nz=-nz;lam=-lam;}
      var sh=0.35+0.65*Math.max(0,lam);
      faces.push({a:a,b:b,c:c,d:d2,z:(a.vz+b.vz+c.vz+d2.vz)*0.25,l:o.lay||0,o:o,sh:sh});
    }
  }
  faces.sort(function(p1,p2){var dq=p1.l-p2.l;return dq!==0?dq:(p2.z-p1.z);});
  var stOn=null;
  for(i=0;i<faces.length;i++){
    var F=faces[i],oo=F.o,r2=Math.round(oo.rgb[0]*F.sh),g2=Math.round(oo.rgb[1]*F.sh),b2=Math.round(oo.rgb[2]*F.sh);
    ctx.fillStyle='rgba('+r2+','+g2+','+b2+','+oo.alpha+')';
    ctx.beginPath();ctx.moveTo(F.a.x,F.a.y);ctx.lineTo(F.b.x,F.b.y);ctx.lineTo(F.c.x,F.c.y);ctx.lineTo(F.d.x,F.d.y);ctx.closePath();ctx.fill();
    if(oo.stroke&&oo.alpha>0.85){stOn=stOn||('rgba(255,165,0,.25)');ctx.strokeStyle=stOn;ctx.lineWidth=.6;ctx.stroke();}
  }
  /* alignment flares on core walls landing */
  var flareP=CL((p-0.75)/0.15,0,1);
  if(flareP>0.01 && flareP<0.99){
    ctx.save();ctx.globalCompositeOperation='lighter';
    walls.forEach(function(w){
      var cp=proj(w.cx,w.cy,w.cz),R=cp.s*1.2;
      var rg=ctx.createRadialGradient(cp.x,cp.y,0,cp.x,cp.y,R);
      rg.addColorStop(0,'rgba(255,184,51,'+(0.4*flareP*(1-flareP)*4)+')');
      rg.addColorStop(1,'rgba(255,184,51,0)');
      ctx.fillStyle=rg;ctx.beginPath();ctx.arc(cp.x,cp.y,R,0,6.283);ctx.fill();
    });
    ctx.restore();
  }
  /* interior glow from windows/penetrations */
  var glowP=CL((p-0.85)/0.1,0,1);
  if(glowP>0.01){
    ctx.save();ctx.globalCompositeOperation='lighter';
    var gpts=[[-6,3.5,-5],[6,3.5,-5],[-6,3.5,5],[6,3.5,5],[-6,5.8,-5],[6,5.8,-5],[-6,5.8,5],[6,5.8,5]];
    for(i=0;i<gpts.length;i++){
      var gp=proj(gpts[i][0],gpts[i][1],gpts[i][2]),R=gp.s*1.5;
      var rg=ctx.createRadialGradient(gp.x,gp.y,0,gp.x,gp.y,R);
      rg.addColorStop(0,'rgba(255,127,0,'+(0.18*glowP)+')');
      rg.addColorStop(1,'rgba(255,127,0,0)');
      ctx.fillStyle=rg;ctx.beginPath();ctx.arc(gp.x,gp.y,R,0,6.283);ctx.fill();
    }
    ctx.restore();
  }
  /* vignette */
  var vg=ctx.createRadialGradient(W/2,H*0.52,Math.min(W,H)*0.3,W/2,H*0.52,Math.max(W,H)*0.8);
  vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.5)');
  ctx.fillStyle=vg;ctx.fillRect(0,0,W,H);
  /* tagline reveal at end */
  if(p>0.92){
    var tagAlpha=CL((p-0.92)/0.08,0,1);
    ctx.save();
    ctx.font='bold '+Math.round(Math.min(W,H)*0.025)+'px system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif';
    ctx.textAlign='center';ctx.textBaseline='middle';
    var txt='BUILT ON PRECISION. DELIVERED ON QUALITY.';
    var tw=ctx.measureText(txt).width;
    var tx=W/2,ty=H*0.52;
    ctx.fillStyle='rgba(255,255,255,'+tagAlpha+')';
    ctx.fillText(txt,tx,ty);
    ctx.restore();
  }
  /* hud */
  var sI=0;
  for(i=0;i<STAGES.length;i++){if(p>=STAGES[i][0])sI=i;}
  if(sI!==curStage&&stgNum){
    curStage=sI;
    stgNum.textContent=(sI<10?'0':'')+sI;
    stgName.textContent=STAGES[sI][1];
  }
  if(railFill)railFill.style.height=(p*100).toFixed(1)+'%';
  if(heroCopy){var ho=reduce?1:CL(1-p*5.2,0,1);heroCopy.style.opacity=ho;heroCopy.style.transform='translateY('+(p*40)+'px)';}
  if(hint)hint.style.opacity=reduce?0:CL(1-p*8,0,1);
  if(DBG){
    var out=[],side,ii,jj;
    for(side=0;side<2;side++){
      for(ii=0;ii<11;ii++){
        var sx2=-7+ii*1.4;
        for(jj=1;jj<6;jj++){
          var tz2=jj/6.5;
          var zz2=side?(-4.9+tz2*4.75):(4.9-tz2*4.75);
          var yy2=(side?(4.44+(zz2+2.45)*0.469):(4.44-(zz2-2.45)*0.469))+0.06;
          var q3=proj(sx2,yy2,zz2);
          var rx2=Math.round(q3.x),ry2=Math.round(q3.y);
          if(rx2>0&&ry2>0&&rx2<W&&ry2<H){
