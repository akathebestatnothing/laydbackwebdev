      else if(axs==='z'){step2=o.sz/n;c.sz=step2+0.03;
        var dir=rotXv([0,0,1],o.rot||0);
        c.cz=(o.cz||0)+dir[2]*off*step2;c.cy=(o.cy||0)+dir[1]*off*step2;}
      else{step2=o.sy/n;c.sy=step2+0.02;c.cy=(o.cy||0)+off*step2;}
      c.t0=(o.t0||0)+si*0.004;
      add(c);
    }
    return;
  }
  o.rot=o.rot||0;o.spin=o.spin||0;o.alpha=(o.alpha==null)?1:o.alpha;
  o.stroke=(o.stroke==null)?true:o.stroke;o.t0=o.t0||0;o.dur=o.dur||0.12;
  o.fly=o.fly||[0,0,0];o.axis=o.axis||[rr(-1,1),rr(0.35,1),rr(-1,1)];o.lay=(o.lay==null)?LAY:o.lay;
  o.rgb=hex2rgb(Array.isArray(o.c)?o.c[Math.floor(rnd()*o.c.length)]:o.c);
  o.cx=o.cx||0;o.cy=o.cy||0;o.cz=o.cz||0;
  pieces.push(o);
}

/* base slab (cement skin) */
LAY=1;
add({cx:0,cy:SLAB_T/2,cz:0,sx:SLAB_W,sy:SLAB_T,sz:SLAB_D,c:'#3a3836',t0:0.02,dur:0.18,fly:[0,-6,0],spin:0.8,split:['x',4]});

/* aggregate stones embedded in slab */
LAY=2;
var AGG_COLORS=['#8b7d6b','#9a8c7a','#7d7060','#a89986','#6e6356','#b8a894'];
for(var ax=0;ax<12;ax++){
  for(var az=0;az<8;az++){
    var cx=-SLAB_W/2+0.6+ax*1.35+rr(-0.15,0.15);
    var cz=-SLAB_D/2+0.5+az*1.3+rr(-0.12,0.12);
    var sx=0.35+rr(0,0.25), sy=0.25+rr(0,0.2), sz=0.35+rr(0,0.25);
    add({cx:cx,cy:SLAB_T/2+rr(-SLAB_T*0.4,SLAB_T*0.4),cz:cz,sx:sx,sy:sy,sz:sz,c:AGG_COLORS,t0:0.08+rnd()*0.15,dur:0.14,fly:[rr(-2,2),rr(4,8),rr(-2,2)],spin:rr(1.2,3)});
  }
}

/* cement skin layer (washes away) */
LAY=3;
add({cx:0,cy:SLAB_T*0.92,cz:0,sx:SLAB_W*1.02,sy:0.04,sz:SLAB_D*1.02,c:'#4a4642',t0:0.10,dur:0.22,fly:[0,-4,0],spin:0.5,split:['x',4]});

/* wash water sweep */
LAY=4;
var WASH_STRIPS=8;
for(var ws=0;ws<WASH_STRIPS;ws++){
  var wz=-SLAB_D/2-0.5+ws*(SLAB_D+1)/WASH_STRIPS;
  add({cx:0,cy:SLAB_T+0.03,cz:wz,sx:SLAB_W*1.1,sy:0.02,sz:0.15,c:'#6ba3d6',t0:0.22+ws*0.04,dur:0.18,fly:[0,6,wz>0?4:-4],spin:0.3,alpha:0.6,stroke:false});
}

/* polished finish highlight */
LAY=5;
add({cx:0,cy:SLAB_T+0.06,cz:0,sx:SLAB_W*0.95,sy:0.01,sz:SLAB_D*0.95,c:'#e8b83a',t0:0.65,dur:0.20,fly:[0,-2,0],spin:0.2,alpha:0.35,stroke:false});

/* formwork boards (fade out) */
LAY=0;
add({cx:0,cy:SLAB_T/2,cz:-(SLAB_D/2+0.2),sx:SLAB_W+0.4,sy:SLAB_T+0.1,sz:0.15,c:'#5d4e3d',t0:0.01,dur:0.12,fly:[-4,-8,0],spin:1,split:['x',3]});
add({cx:0,cy:SLAB_T/2,cz:(SLAB_D/2+0.2),sx:SLAB_W+0.4,sy:SLAB_T+0.1,sz:0.15,c:'#5d4e3d',t0:0.015,dur:0.12,fly:[4,-8,0],spin:1,split:['x',3]});
add({cx:-(SLAB_W/2+0.2),cy:SLAB_T/2,cz:0,sx:0.15,sy:SLAB_T+0.1,sz:SLAB_D+0.4,c:'#5d4e3d',t0:0.02,dur:0.12,fly:[-8,-6,2],spin:1,split:['z',3]});
add({cx:(SLAB_W/2+0.2),cy:SLAB_T/2,cz:0,sx:0.15,sy:SLAB_T+0.1,sz:SLAB_D+0.4,c:'#5d4e3d',t0:0.025,dur:0.12,fly:[8,-6,-2],spin:1,split:['z',3]});

/* ===== render ===== */
var FACES=[[0,2,3,1],[4,5,7,6],[0,4,6,2],[1,3,7,5],[0,1,5,4],[2,6,7,3]];
var LX=0.42,LY=0.80,LZ=0.42;
function rotXv(p,a){var c=Math.cos(a),s=Math.sin(a);return [p[0],p[1]*c-p[2]*s,p[1]*s+p[2]*c];}
function rotAv(p,ax,a){var c=Math.cos(a),s=Math.sin(a),d=1-c,x=p[0],y=p[1],z=p[2],x0=ax[0],x1=ax[1],x2=ax[2];
 return [x*(x0*x0*d+c)+y*(x0*x1*d-x2*s)+z*(x0*x2*d+x1*s),
         x*(x1*x0*d+x2*s)+y*(x1*x1*d+c)+z*(x1*x2*d-x0*s),
         x*(x2*x0*d-x1*s)+y*(x2*x1*d+x0*s)+z*(x2*x2*d+c)];}

var smoothP=0,sP=-1,mx=0,my=0,tmx=0,tmy=0,curStage=-1;
var stgNum=document.getElementById('stgNum'),stgName=document.getElementById('stgName'),
    railFill=document.getElementById('railFill'),hint=document.getElementById('scrollHint'),
    heroCopy=document.getElementById('heroCopy');
var STAGES=[[0,'Slab poured'],[0.15,'Aggregate placed'],[0.35,'Wash pass sweeping'],[0.60,'Cement skin dissolving'],[0.80,'Polished & sealed']];

function draw(p){
  if(!isFinite(p))p=0;
  var AZC=-0.66+p*0.30+mx*0.045+azO;
  var ca=Math.cos(AZC),sa=Math.sin(AZC);
  var el=0.30+0.05*p-my*0.028,ce=Math.cos(el),se=Math.sin(el);
  var D=(W<640?26.5:33)*(1-0.10*p),f=1.55*Math.min(H,W*0.8),camY=2.8,yA=0.55;
  function proj(x,y,z){
    var xa=x*ca-z*sa,za=x*sa+z*ca,yy=y-camY;
    var vy=yy*ce+za*se,vz=-yy*se+za*ce+D,s=f/Math.max(6,vz);
    return {x:W/2+xa*s,y:H*yA-vy*s,s:s,vz:vz};
  }
  /* sky + ground wash */
  var g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,'#0a0a09');g.addColorStop(.55,'#0f0e0c');g.addColorStop(1,'#0a0a09');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  /* perspective grid */
  ctx.strokeStyle='rgba(242,239,232,.045)';ctx.lineWidth=1;
  var x,z,pa,pb;
  for(x=-12;x<=12;x+=2){pa=proj(x,0,-7);pb=proj(x,0,16);ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();}
  for(z=-6;z<=16;z+=2){pa=proj(-12,0,z);pb=proj(12,0,z);ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();}
  /* ground shadow */
  var c0=proj(0,0.01,0);
  if(c0.s>0){ctx.fillStyle='rgba(0,0,0,.30)';ctx.beginPath();ctx.ellipse(c0.x,c0.y,c0.s*9.2,c0.s*2.9,0,0,6.283);ctx.fill();}
  /* pieces */
  var faces=[];
  var i,j,o,q,sp;
  for(i=0;i<pieces.length;i++){
    o=pieces[i];
    q=EZ(CL((p-o.t0)/o.dur,0,1));
    if(q<=0)continue;
    sp=o.spin*(1-q);
    var k=1-q,ox=o.fly[0]*k,oy=o.fly[1]*k,oz=o.fly[2]*k;
    var vs=[];
    for(j=0;j<8;j++){
      var l=[o.sx*((j&1)?.5:-.5),o.sy*((j&2)?.5:-.5),o.sz*((j&4)?.5:-.5)];
      if(o.rot)l=rotXv(l,o.rot);
      if(sp>0.001)l=rotAv(l,o.axis,sp);
      var wx=o.cx+ox+l[0],wy=o.cy+oy+l[1],wz=o.cz+oz+l[2];
      var pr=proj(wx,wy,wz);
      if(!isFinite(pr.x)||!isFinite(pr.y)){vs=null;break;}
      vs.push({x:pr.x,y:pr.y,vz:pr.vz,wx:wx,wy:wy,wz:wz});
    }
    if(!vs)continue;
    for(j=0;j<6;j++){
      var fc=FACES[j],a=vs[fc[0]],b=vs[fc[1]],c=vs[fc[2]],d2=vs[fc[3]];
      var e1x=b.wx-a.wx,e1y=b.wy-a.wy,e1z=b.wz-a.wz,e2x=c.wx-a.wx,e2y=c.wy-a.wy,e2z=c.wz-a.wz;
      var nx=e1y*e2z-e1z*e2y,ny=e1z*e2x-e1x*e2z,nz=e1x*e2y-e1y*e2x;
      var nl=Math.sqrt(nx*nx+ny*ny+nz*nz)||1;nx/=nl;ny/=nl;nz/=nl;
      var lam=nx*LX+ny*LY+nz*LZ;if(lam<0){nx=-nx;ny=-ny;nz=-nz;lam=-lam;}
      var sh=0.40+0.60*Math.max(0,lam);
      faces.push({a:a,b:b,c:c,d:d2,z:(a.vz+b.vz+c.vz+d2.vz)*0.25,l:o.lay||0,o:o,sh:sh});
    }
  }
  faces.sort(function(p1,p2){var dq=p1.l-p2.l;return dq!==0?dq:(p2.z-p1.z);});
  var stOn=null;
  for(i=0;i<faces.length;i++){
    var F=faces[i],oo=F.o,r2=Math.round(oo.rgb[0]*F.sh),g2=Math.round(oo.rgb[1]*F.sh),b2=Math.round(oo.rgb[2]*F.sh);
    ctx.fillStyle='rgba('+r2+','+g2+','+b2+','+oo.alpha+')';
    ctx.beginPath();ctx.moveTo(F.a.x,F.a.y);ctx.lineTo(F.b.x,F.b.y);ctx.lineTo(F.c.x,F.c.y);ctx.lineTo(F.d.x,F.d.y);ctx.closePath();ctx.fill();
    if(oo.stroke&&oo.alpha>0.9){stOn=stOn||('rgba(12,9,6,.5)');ctx.strokeStyle=stOn;ctx.lineWidth=.7;ctx.stroke();}
  }
  /* polished highlight sweep */
  var hl=CL((p-0.65)/0.25,0,1);
  if(hl>0.01){
    ctx.save();ctx.globalCompositeOperation='lighter';
    var cp=proj(0,SLAB_T+0.06,0),R=cp.s*8;
    var rg=ctx.createRadialGradient(cp.x,cp.y,0,cp.x,cp.y,R);
    rg.addColorStop(0,'rgba(232,184,58,'+(0.18*hl)+')');rg.addColorStop(1,'rgba(232,184,58,0)');
    ctx.fillStyle=rg;ctx.beginPath();ctx.arc(cp.x,cp.y,R,0,6.283);ctx.fill();
    ctx.restore();
  }
  /* vignette */
  var vg=ctx.createRadialGradient(W/2,H*0.52,Math.min(W,H)*0.32,W/2,H*0.52,Math.max(W,H)*0.78);
  vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.42)');
  ctx.fillStyle=vg;ctx.fillRect(0,0,W,H);
  /* hud */
  var sI=0;
  for(i=0;i<STAGES.length;i++){if(p>=STAGES[i][0])sI=i;}
  if(sI!==curStage&&stgNum){
    curStage=sI;
    stgNum.textContent=(sI<10?'0':'')+sI;
    stgName.textContent=STAGES[sI][1];
  }
  if(railFill)railFill.style.height=(p*100).toFixed(1)+'%';
  if(heroCopy){var ho=reduce?1:CL(1-p*5.2,0,1);heroCopy.style.opacity=ho;heroCopy.style.transform='translateY('+(p*40)+'px)';}
  if(hint)hint.style.opacity=reduce?0:CL(1-p*8,0,1);
  if(DBG){
    var out=[],side,ii,jj;
    for(side=0;side<2;side++){
      for(ii=0;ii<11;ii++){
        var sx2=-7+ii*1.4;
        for(jj=1;jj<6;jj++){
          var tz2=jj/6.5;
          var zz2=side?(-4.9+tz2*4.75):(4.9-tz2*4.75);
          var yy2=(side?(4.44+(zz2+2.45)*0.469):(4.44-(zz2-2.45)*0.469))+0.06;
          var q3=proj(sx2,yy2,zz2);
          var rx2=Math.round(q3.x),ry2=Math.round(q3.y);
          if(rx2>0&&ry2>0&&rx2<W&&ry2<H){
            var dtx=ctx.getImageData(rx2,ry2,1,1).data;
            var lum=(dtx[0]+dtx[1]+dtx[2])/3;
            if(lum>92)out.push((side?'R':'L')+ii+''+jj);
          }
        }
      }
    }
    document.title='BRIGHT:'+(out.length?out.join(','):'none');
  }
}
window.__buildTo=function(x){draw(CL(+x||0,0,1));};

function animate(ts){
  if(!isFinite(ts))ts=0;
  var rect=wrap.getBoundingClientRect();
  var span=wrap.offsetHeight-sticky.offsetHeight;
  var p=CL(-rect.top/Math.max(1,span),0,1);
  smoothP+=(p-smoothP)*0.10;
  if(Math.abs(smoothP-p)<0.0004)smoothP=p;
  mx+=(tmx-mx)*0.06;my+=(tmy-my)*0.06;
  draw(smoothP);
  requestAnimationFrame(animate);
}
window.addEventListener('pointermove',function(e){tmx=(e.clientX/window.innerWidth)*2-1;tmy=(e.clientY/window.innerHeight)*2-1;},{passive:true});

resize();
window.addEventListener('resize',function(){resize();if(forceP!=null||reduce)draw(forceP!=null?CL(parseFloat(forceP)||0,0,1):1);});
if(forceP!=null){draw(CL(parseFloat(forceP)||0,0,1));}
else if(reduce){draw(1);}
else{requestAnimationFrame(animate);}
})();

/* ===== process canvas — exposed aggregate sequence ===== */
(function(){
  var c=document.getElementById('processCanvas');if(!c)return;
  var x=c.getContext('2d'),w=c.width,h=c.height;
  x.clearRect(0,0,w,h);
  x.lineCap='round';
  // stage 1: pour
  x.strokeStyle='#daa520';x.lineWidth=2;
  x.beginPath();x.moveTo(w*0.1,h*0.7);x.lineTo(w*0.9,h*0.7);x.stroke();
  x.fillStyle='#4a4642';
  x.beginPath();x.moveTo(w*0.1,h*0.7);x.lineTo(w*0.15,h*0.5);x.lineTo(w*0.85,h*0.5);x.lineTo(w*0.9,h*0.7);x.closePath();x.fill();
  // stage 2: wash lines
  x.strokeStyle='rgba(107,163,214,0.7)';x.lineWidth=3;x.setLineDash([8,6]);
  for(var i=0;i<5;i++){
    var yy=h*0.5+i*8;
    x.beginPath();x.moveTo(w*0.15,yy);x.lineTo(w*0.85,yy);x.stroke();
  }
  x.setLineDash([]);
  // stage 3: aggregate speckle
  var agg=['#8b7d6b','#9a8c7a','#7d7060','#a89986','#6e6356'];
  for(var s=0;s<120;s++){
    x.fillStyle=agg[Math.floor(rnd()*agg.length)];
    var px=w*0.15+rnd()*w*0.7, py=h*0.5+rnd()*h*0.15;
    x.beginPath();x.arc(px,py,1.5+rnd()*2,0,6.283);x.fill();
  }
  // stage 4: seal highlight
  var g=x.createLinearGradient(0,h*0.5,0,h*0.7);
  g.addColorStop(0,'rgba(232,184,58,0.15)');g.addColorStop(1,'rgba(232,184,58,0)');
  x.fillStyle=g;x.fillRect(w*0.15,h*0.5,w*0.7,h*0.2);
  // labels
  x.fillStyle='#a89f8e';x.font='11px ui-monospace,Menlo,Consolas,monospace';
  x.fillText('POUR',w*0.08,h*0.42);
  x.fillText('WASH',w*0.08,h*0.52);
  x.fillText('AGGREGATE',w*0.08,h*0.62);
  x.fillText('SEAL',w*0.08,h*0.72);
})();

/* ===== reveals + year ===== */
(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
