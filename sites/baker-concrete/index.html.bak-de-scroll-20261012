add({cx:0,cy:PANEL_H+0.12,cz:(FD/2),sx:FW,sy:0.1,sz:0.15,c:C.timber_dark,t0:0.355,dur:0.08,fly:[0,-3,-4],spin:0.8,split:['x',2]});
add({cx:-(FW/2),cy:PANEL_H+0.12,cz:0,sx:0.15,sy:0.1,sz:FD,c:C.timber_dark,t0:0.36,dur:0.08,fly:[-4,-2,0],spin:0.8,split:['z',2]});
add({cx:(FW/2),cy:PANEL_H+0.12,cz:0,sx:0.15,sy:0.1,sz:FD,c:C.timber_dark,t0:0.365,dur:0.08,fly:[4,-2,0],spin:0.8,split:['z',2]});

