  add({cx:pxPos,cy:PANEL_H+0.04,cz:frontZ+PANEL_TH/2,sx:PANEL_W-PANEL_GAP,sy:0.08,sz:PANEL_TH+0.04,c:C.timber_dark,t0:0.89+delay,dur:0.2,fly:[0,0,8],spin:rr(2,4),axis:[-1,0,0],lay:8});
  add({cx:pxPos,cy:-0.04,cz:frontZ+PANEL_TH/2,sx:PANEL_W-PANEL_GAP,sy:0.08,sz:PANEL_TH+0.04,c:C.timber_dark,t0:0.895+delay,dur:0.2,fly:[0,0,8],spin:rr(2,4),axis:[-1,0,0],lay:8});
