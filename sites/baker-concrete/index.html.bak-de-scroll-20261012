var CONCRETE_TH=0.25;         /* concrete wall thickness inside formwork */

var pieces=[];
var LAY=0;
function add(o){
  if(o.split){
    var sp2=o.split,n=sp2[1],axs=sp2[0];delete o.split;
    for(var si=0;si<n;si++){
      var c={},k2;for(k2 in o)c[k2]=o[k2];
      var off=si-(n-1)/2,step2;
      if(axs==='x'){step2=o.sx/n;c.sx=step2+0.01;c.cx=(o.cx||0)+off*step2;}
      else if(axs==='z'){step2=o.sz/n;c.sz=step2+0.01;
        var dir=rotXv([0,0,1],o.rot||0);
        c.cz=(o.cz||0)+dir[2]*off*step2;c.cy=(o.cy||0)+dir[1]*off*step2;}
      else{step2=o.sy/n;c.sy=step2+0.01;c.cy=(o.cy||0)+off*step2;}
      c.t0=(o.t0||0)+si*0.003;
      add(c);
    }
    return;
  }
  o.rot=o.rot||0;o.spin=o.spin||0;o.alpha=(o.alpha==null)?1:o.alpha;
  o.stroke=(o.stroke==null)?true:o.stroke;o.t0=o.t0||0;o.dur=o.dur||0.12;
  o.fly=o.fly||[0,0,0];o.axis=o.axis||[rr(-1,1),rr(0.35,1),rr(-1,1)];o.lay=(o.lay==null)?LAY:o.lay;
  o.rgb=hex2rgb(Array.isArray(o.c)?o.c[Math.floor(rnd()*o.c.length)]:o.c);
  o.cx=o.cx||0;o.cy=o.cy||0;o.cz=o.cz||0;
  pieces.push(o);
}

/* deterministic prng */
var _s=1301;function rnd(){_s=(_s*1103515245+12345)%2147483648;return _s/2147483648;}
function rr(a,b){return a+(b-a)*rnd();}
function hex2rgb(h){return [parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)];}

