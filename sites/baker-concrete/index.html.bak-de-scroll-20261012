/* Top walers/bracing fall last */
add({cx:0,cy:PANEL_H+0.12,cz:-(FD/2),sx:FW,sy:0.1,sz:0.15,c:C.timber_dark,t0:0.95,dur:0.15,fly:[0,-5,0],spin:rr(2,5),lay:8});
add({cx:0,cy:PANEL_H+0.12,cz:(FD/2),sx:FW,sy:0.1,sz:0.15,c:C.timber_dark,t0:0.955,dur:0.15,fly:[0,-5,0],spin:rr(2,5),lay:8});
add({cx:-(FW/2),cy:PANEL_H+0.12,cz:0,sx:0.15,sy:0.1,sz:FD,c:C.timber_dark,t0:0.96,dur:0.15,fly:[0,-5,0],spin:rr(2,5),lay:8});
add({cx:(FW/2),cy:PANEL_H+0.12,cz:0,sx:0.15,sy:0.1,sz:FD,c:C.timber_dark,t0:0.965,dur:0.15,fly:[0,-5,0],spin:rr(2,5),lay:8});

/* Steel props fall */
for(var ti=0;ti<8;ti++){
