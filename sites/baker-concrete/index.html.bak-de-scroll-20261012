/* Stage 9: Final - concrete wall stands alone with soft raking light */
LAY=9;
/* Concrete wall already placed at stage 7 - it stays */
/* Add subtle grain texture indication on concrete face */
for(var gx=0;gx<12;gx++){
  for(var gz=0;gz<8;gz++){
    add({cx:-(FW/2)+0.5+gx*0.45,cy:0.2+gz*0.35,cz:CONCRETE_TH/2+0.01,sx:0.35,sy:0.25,sz:0.01,c:C.board_grain,t0:0.99+gx*0.002+gz*0.001,dur:0.05,fly:[0,0,0],spin:0,alpha:0.15,stroke:false,lay:9});
