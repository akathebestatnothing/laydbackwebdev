</div>
</footer>

<script>
(function(){
  var b = document.getElementById('burger'), n = document.getElementById('navlinks');
  if (b && n){
    b.addEventListener('click', function(){
      var open = n.classList.toggle('open');
      b.classList.toggle('open', open);
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    n.addEventListener('click', function(e){
      if (e.target.tagName === 'A'){ n.classList.remove('open'); b.classList.remove('open'); b.setAttribute('aria-expanded','false'); }
    });
  }
})();
(function(){
  var els = document.querySelectorAll('.drop');
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold: 0.12, rootMargin: '0px 0px -40px 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }
})();
setTimeout(function(){ document.querySelectorAll('.drop').forEach(function(el){ el.classList.add('in'); }); }, 1100);
/* 3D hero — cleansing bubble field (cleaning/detailing) */
(function(){var c=document.getElementById('heroCanvas');if(!c||!c.getContext)return;var ctx=c.getContext('2d');var DPR=Math.min(window.devicePixelRatio||1,2);var W=0,H=0,reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var px=0,py=0;window.addEventListener('pointermove',function(e){px=(e.clientX/innerWidth-.5)*18;py=(e.clientY/innerHeight-.5)*12;},{passive:true});
function resize(){W=c.clientWidth||c.offsetWidth;H=c.clientHeight||c.offsetHeight;if(!W||!H)return;c.width=Math.round(W*DPR);c.height=Math.round(H*DPR);ctx.setTransform(DPR,0,0,DPR,0,0);}
function loop(t){if(!W||!H){resize();return;}frame(t||0);if(!reduce)requestAnimationFrame(loop);}
function frame(t){var time=t*.001;ctx.clearRect(0,0,W,H);var g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#ffffff');g.addColorStop(.55,'#f9d3d5');g.addColorStop(1,'#ffffff');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
for(var i=0;i<46;i++){var bx=(i*173+time*14*(0.6+(i%5)*.3))%W;var by=(i*97+time*26)%H;var r=8+(i%7)*10+(Math.sin(time*0.8+i)*3);var al=0.06+((i*13)%28)*0.012;ctx.strokeStyle='rgba(229,25,36,'+al+')';ctx.lineWidth=1.4;ctx.beginPath();ctx.arc(bx,by,r,0,Math.PI*2);ctx.stroke();ctx.strokeStyle='rgba(255,255,255,'+(al*0.35)+')';ctx.beginPath();ctx.arc(bx-r*0.28,by-r*0.32,r*0.16,0,Math.PI*2);ctx.stroke();}
for(var k=0;k<26;k++){var sx=(k*157+time*10)%W;var sy=H*0.1+((k*79+time*18)%(H*0.8));var tw=0.5+0.5*Math.sin(time*1.7+k*2.1);ctx.fillStyle='rgba(229,25,36,'+(0.05+tw*0.14)+')';ctx.beginPath();ctx.arc(sx+px*0.4,sy+py*0.4,1.1+tw*1.7,0,Math.PI*2);ctx.fill();}
var rg=ctx.createRadialGradient(W*0.2,H*0.7,10,W*0.2,H*0.7,W*0.55);rg.addColorStop(0,'rgba(229,25,36,0.14)');rg.addColorStop(1,'rgba(229,25,36,0)');ctx.fillStyle=rg;ctx.fillRect(0,0,W,H);}
resize();window.addEventListener('resize',resize);requestAnimationFrame(loop);})();
var hg = document.querySelector('.hgal');
if (hg) {
  var step = function(){ return Math.min(hg.clientWidth * 0.8, 600); };
  var prev = document.getElementById('hgPrev');
  var next = document.getElementById('hgNext');
  if (prev) prev.addEventListener('click', function(){ hg.scrollBy({ left: -step(), behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function(){ hg.scrollBy({ left: step(), behavior: 'smooth' }); });
}
</script>
</body>
</html>