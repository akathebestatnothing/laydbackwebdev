<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Allards Auto Detailing — Car Detailing & Graphene Paint Protection | West Gosford</title>
<meta name="description" content="Allards Auto Detailing — full interior and exterior detailing, paint enhancement and long-life graphene protection at our West Gosford workshop. Cars, 4WDs, boats and motorhomes. Call 0405 733 769.">
<meta property="og:title" content="Allards Auto Detailing — West Gosford, Central Coast">
<meta property="og:description" content="Detailing, paint correction & graphene protection — cars, boats & motorhomes, West Gosford.">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/logo.png">
<link rel="icon" href="assets/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800;900&family=Saira+Condensed:wght@400;700;800;900&display=swap" rel="stylesheet">
<style>
:root {
  --paper: #ffffff; --paper2: #f9d3d5; --ink: #060607; --ink2: #767676;
  --acc: #e51924; --acc2: #ea4b54; --line: rgba(6,6,7,.16); --chip: #f9d3d5;
  --deep: #000000; --light: #ffffff;
  --acc-text: #ffffff;
  --fluid: clamp(44px, 9vw, 118px);
  --disp: 'Saira Condensed', 'Arial Narrow', sans-serif; --body-font: 'Inter', sans-serif;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
html, body { overflow-x: hidden; }
body { font-family: 'Inter', sans-serif; background: var(--paper); color: var(--ink); line-height: 1.55; -webkit-font-smoothing: antialiased; }
h1, h2, h3 { font-family: 'Saira Condensed', 'Arial Narrow', sans-serif; }
h1 { text-transform: uppercase; }
.mono { font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; }
a { color: inherit; }
::selection { background: var(--acc); color: #ffffff; }
html.js .drop { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
html.js .drop.in { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) { html.js .drop { opacity: 1; transform: none; transition: none; } * { animation-duration: .001s !important; transition-duration: .001s !important; } }
.nav { position: fixed; inset: 0 0 auto 0; z-index: 60; background: rgba(255,255,255,.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
.nav-in { display: flex; align-items: center; gap: 1.4rem; height: 80px; max-width: 1360px; margin: 0 auto; padding: 0 40px; }
.brand { display: flex; align-items: center; gap: .9rem; color: var(--ink); text-decoration: none; }
.brand img{height:52px;width:auto;object-fit:contain;border-radius:6px}
.brand-name { font-family: 'Saira Condensed', 'Arial Narrow', sans-serif; font-size: 1.22rem; line-height: 1; font-weight: 900; letter-spacing: .01em; }
.brand-sub { font-size: .58rem; letter-spacing: .2em; text-transform: uppercase; color: var(--acc); font-weight: 700; }
.nav-links { display: flex; gap: 1.3rem; margin-left: auto; align-items: center; }
.nav-links a { color: var(--ink2); text-decoration: none; font-size: .9rem; font-weight: 600; letter-spacing: .03em; }
.nav-links a:hover { color: var(--acc); }
.nav-cta { display: flex; gap: .8rem; align-items: center; }
.nav-p { font-size: .82rem; font-weight: 700; color: var(--ink); }
.burger { display: none; margin-left: auto; background: none; border: 1px solid var(--line); border-radius: 6px; padding: .4rem .6rem; cursor: pointer; }
.burger span { display: block; width: 20px; height: 2px; background: var(--ink); margin: 4px 0; transition: .3s; }
.burger.open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
.burger.open span:nth-child(2) { opacity: 0; }
.burger.open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
@media(max-width:920px){
  .nav-links { position: fixed; inset: 80px 0 auto 0; background: rgba(255,255,255,.92); flex-direction: column; padding: 1.2rem; gap: 1rem; transform: translateY(-140%); transition: transform .35s ease; border-bottom: 1px solid var(--line); }
  .nav-links.open { transform: none; }
  .nav-links a { width: 100%; text-align: center; padding: .5rem 0; }
  .nav-cta { display: none; }
  .burger { display: block; }
}
.hero { position: relative; min-height: 92vh; display: flex; align-items: center; overflow: hidden; padding-top: 80px; }
.hero canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: .72; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.05) 0%, rgba(0,0,0,.10) 40%, #ffffff 100%); pointer-events: none; }
.hero-in { position: relative; z-index: 2; padding: 11vh 40px 3.4rem; width: 100%; max-width: 1360px; margin: 0 auto; display: grid; grid-template-columns: 1.06fr .94fr; gap: 3.2rem; align-items: center; }
.hero-copy { min-width: 0; }
.hero-visual { position: relative; }
.hero-visual figure { position: relative; margin: 0; border-radius: 16px; overflow: hidden; box-shadow: 0 30px 70px rgba(0,0,0,.26); border: 1px solid var(--line); background: var(--paper2); }
.hero-visual img { width: 100%; height: min(66vh, 580px); object-fit: cover; object-position: center 46%; display: block; }
.hero-visual .hero-tag { position: absolute; top: 16px; left: 16px; background: var(--acc); color: var(--acc-text); padding: 7px 15px; font-size: 11px; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; border-radius: 5px; z-index: 3; box-shadow: 0 6px 18px rgba(0,0,0,.22); }
.hero-visual .hv-motif { position: absolute; left: 0; right: 0; bottom: 0; height: 12px; opacity: .95; background-repeat: repeat-x; }
.hero-kicker { display: inline-flex; align-items: center; gap: .65rem; color: var(--acc); font-size: .72rem; letter-spacing: .26em; text-transform: uppercase; font-weight: 800; margin-bottom: 1rem; }
.hero-kicker::before { content: ""; width: 36px; height: 2px; background: var(--acc); }
.hero h1 { font-family: 'Saira Condensed', 'Arial Narrow', sans-serif; font-size: clamp(2.3rem, 5.6vw, 4.6rem); line-height: 1.04; color: var(--ink); font-weight: 900; max-width: 22ch; letter-spacing: -.01em; }
.hero h1 .acc { color: var(--acc); }
.hero h1 .thin { font-weight: 400; display: block; font-size: clamp(1.1rem, 2vw, 1.5rem); color: var(--ink2); text-transform: none; letter-spacing: 0; margin-top: 8px; }
.hero-sub { margin-top: 1.1rem; color: var(--ink2); font-size: clamp(.98rem, 1.5vw, 1.12rem); max-width: 58ch; }
.hero-cta { display: flex; gap: .9rem; margin-top: 1.8rem; flex-wrap: wrap; }
.btn { display: inline-flex; align-items: center; gap: .5rem; padding: .85rem 1.55rem; border-radius: 6px; text-decoration: none; font-weight: 800; font-size: .95rem; transition: transform .15s ease, filter .15s ease; }
.btn:hover { transform: translateY(-1px); filter: brightness(1.06); }
.btn-primary { background: var(--acc); color: #ffffff; }
.btn-ghost { border: 1.5px solid var(--ink); color: var(--ink); background: transparent; }
.hero-strip { margin-top: 2.4rem; display: flex; gap: 2.4rem; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 1.2rem; }
.hero-strip p { color: var(--ink2); font-size: .7rem; letter-spacing: .13em; text-transform: uppercase; font-weight: 700; }
.hero-strip strong { display: block; color: var(--ink); font-family: 'Saira Condensed', 'Arial Narrow', sans-serif; font-size: 1.02rem; margin-top: .2rem; font-weight: 800; }
.hero-photo { max-width: 1360px; margin: 1.4rem auto 0; padding: 0 40px; }
@media (max-width: 1000px) { .hero-in { grid-template-columns: 1fr; gap: 1.4rem; } .hero-visual { order: -1; } .hero-visual img { height: min(38vh, 320px); } }
@media (max-width: 820px) { .hero-in { padding: 9vh 20px 2rem; } .hero-photo { padding: 0 20px; } }
@media (max-width: 640px) { .brand-sub { display: none; } .brand-name { font-size: 1.06rem; } .brand img{height:42px;width:auto;object-fit:contain;border-radius:6px} .nav-in { padding: 0 18px; gap: .9rem; } .hero-visual img { height: min(33vh, 250px); } .hero-in { padding: 8vh 20px 1.6rem; } .hero h1 { font-size: clamp(1.9rem, 8.4vw, 2.4rem); } .hero-strip { margin-top: 1.6rem; gap: 1.6rem; } }
section { padding: 5.4rem 0; }
.wrap { max-width: 1320px; margin: 0 auto; padding: 0 44px; }
.sec-head { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 2.6rem; }
.sec-head::before { content: ""; width: 40px; height: 3px; background: var(--acc); flex: none; align-self: center; }
.sec-idx { font-size: .78rem; letter-spacing: .24em; text-transform: uppercase; color: var(--acc); font-weight: 800; margin-bottom: 1rem; }
.sec-kicker { font-size: .7rem; letter-spacing: .3em; text-transform: uppercase; color: var(--acc); font-weight: 800; }
.sec-title { font-family: 'Saira Condensed', 'Arial Narrow', sans-serif; font-size: clamp(1.8rem, 3.6vw, 2.9rem); font-weight: 900; line-height: 1.1; margin-top: .3rem; max-width: 28ch; letter-spacing: -.01em; }
.lead { color: var(--ink2); max-width: 60ch; margin-top: .9rem; }
.svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(292px, 1fr)); gap: 1.15rem; }
.svc { background: var(--chip); border: 1px solid var(--line); border-radius: 10px; padding: 1.65rem 1.5rem; position: relative; overflow: hidden; transition: border-color .2s ease, transform .2s ease; }
.svc:hover { border-color: var(--acc); transform: translateY(-3px); }
.svc::after { content: ""; position: absolute; top: 0; left: 0; width: 44px; height: 3px; background: var(--acc); transition: width .3s ease; }
.svc:hover::after { width: 100%; }
.svc h3 { font-family: 'Saira Condensed', 'Arial Narrow', sans-serif; font-weight: 800; font-size: 1.12rem; margin-bottom: .35rem; }
.svc p { color: var(--ink2); font-size: .94rem; }
.svc-n { font-size: .8rem; font-weight: 800; color: var(--acc); letter-spacing: .1em; }
.svc-arrow { color: var(--acc); font-size: 1.2rem; position: absolute; right: 18px; top: 18px; }
.steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(292px, 1fr)); gap: 1.15rem; }
.step { background: var(--chip); border: 1px solid var(--line); border-radius: 10px; padding: 1.55rem 1.45rem; }
.step-n { font-family: 'Saira Condensed', 'Arial Narrow', sans-serif; font-size: 1.75rem; line-height: 1; color: var(--acc); margin-bottom: .5rem; font-weight: 900; }
.step h3 { font-family: 'Saira Condensed', 'Arial Narrow', sans-serif; font-weight: 800; font-size: 1.06rem; margin-bottom: .3rem; }
.step p { color: var(--ink2); font-size: .92rem; }
.faq-wrap { max-width: 900px; }
details.faq { border-top: 1px solid var(--line); padding: 22px 0; }
details.faq:last-of-type { border-bottom: 1px solid var(--line); }
details.faq summary { font-size: 19px; font-weight: 800; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
details.faq summary::after { content: "+"; font-size: 26px; color: var(--acc); font-weight: 400; transition: transform .2s; }
details.faq[open] summary::after { transform: rotate(45deg); }
details.faq .a { color: var(--ink2); padding: 14px 0 4px; max-width: 700px; }
.tst-grid, .trust-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
.tst { background: var(--chip); border: 1px solid var(--line); padding: 30px; position: relative; }
.tst-q { font-size: 56px; line-height: 1; color: var(--acc); font-weight: 900; height: 30px; }
.tst p { font-size: 16px; line-height: 1.6; margin-top: 8px; }
.tst-a { margin-top: 20px; }
.tst-a b { font-size: 15px; }
.tst-a span { display: block; font-size: 12px; color: var(--ink2); letter-spacing: .08em; text-transform: uppercase; margin-top: 2px; }
.band { background: var(--paper2); border-block: 1px solid var(--line); }
.trust-strip .tr-i { display: flex; gap: 14px; align-items: flex-start; }
.tr-t { width: 32px; height: 32px; border-radius: 50%; background: var(--acc); color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
.tr-i b { font-size: 15px; display: block; }
.tr-i span { font-size: 13px; color: var(--ink2); }
.stat-band .wrap { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
.stat { border-top: 3px solid var(--acc); padding-top: 18px; }
.stat b { font-size: clamp(36px, 4.6vw, 60px); font-weight: 900; letter-spacing: -.03em; display: block; line-height: 1; color: var(--acc); }
.stat span { font-size: 13px; color: var(--ink2); letter-spacing: .06em; text-transform: uppercase; font-weight: 700; margin-top: 6px; display: block; }
@media (max-width: 900px) { .stat-band .wrap { grid-template-columns: repeat(2, 1fr); } }
.hgal { overflow-x: auto; scrollbar-width: none; cursor: grab; }
.hgal::-webkit-scrollbar { display: none; }
.hgal .track { display: inline-flex; gap: 22px; padding: 0 44px; }
.hg-item { flex: 0 0 auto; width: min(560px, 78vw); margin: 0; }
.hg-item img { width: 100%; height: 380px; object-fit: cover; display: block; border-radius: 8px; }
.hg-item figcaption { display: flex; justify-content: space-between; padding: 12px 2px; font-size: 13px; color: var(--ink2); }
.hgal-nav { display: flex; gap: 12px; justify-content: flex-end; padding: 0 44px; margin-top: 18px; }
.hgal-btn { width: 52px; height: 52px; border: 1.5px solid var(--ink); background: transparent; font-size: 20px; cursor: pointer; color: var(--ink); transition: background .15s, color .15s; }
.hgal-btn:hover { background: var(--acc); border-color: var(--acc); color: #ffffff; }
footer { border-top: 1px solid var(--line); padding: 70px 0 0; background: var(--paper); }
footer .wrap { max-width: 1360px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; }
footer h4 { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--acc); margin-bottom: 16px; }
footer a { display: block; text-decoration: none; color: var(--ink2); font-size: 14.5px; padding: 5px 0; }
footer a:hover { color: var(--acc); }
.fbrand { display: flex; align-items: center; gap: 14px; }
.fbrand img{height:56px;width:auto;object-fit:contain;border-radius:6px}
.footer-bar { max-width: 1360px; margin: 50px auto 0; padding: 22px 40px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; font-size: 12.5px; color: var(--ink2); }
@media (max-width: 900px) { footer .wrap { grid-template-columns: 1fr 1fr; } }
.hv-motif{background-image:radial-gradient(circle at 7px 6px, var(--acc) 3px, transparent 3.5px) 0 0/22px 12px;}.hero-kicker::before{background:var(--acc)}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
<script>document.documentElement.className+=' js';</script>
<nav class="nav"><div class="nav-in">
  <a class="lb-brand" href="#top" aria-label="ALLARDS - Home" style="--lb-disp:Montserrat;--lb-sub:Inter;--lb-acc:#e4243c;"><span class="lb-brand__mark"><img src="assets/lb-mark_allards-auto-detailing.png" alt="" aria-hidden="true" decoding="async"></span><span class="lb-brand__word"><span class="lb-brand__name">ALLARDS</span><span class="lb-brand__sub"><span class="lb-acc">AUTO</span> DETAILING</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
