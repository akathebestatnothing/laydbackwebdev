    var sg = ctx.createLinearGradient(0, 0, 0, S.horizon + 8);
    sg.addColorStop(0, '#0e2c46'); sg.addColorStop(0.45, '#2d5473'); sg.addColorStop(0.78, '#8d7a72'); sg.addColorStop(1, '#e0a06a');
    ctx.fillStyle = sg; ctx.fillRect(0, 0, W, S.horizon + 8);
    for (var ci = 0; ci < 11; ci++) {
      var cy = S.horizon * (0.10 + ci * 0.075), cw = W * (0.34 + 0.10 * ci), cx = W * (0.02 + ((ci * 0.29 + time * 0.00001) % 1) * 0.96);
      var cg = ctx.createLinearGradient(0, cy - 20, 0, cy + 22), ca = 0.07 + 0.09 * Math.abs(Math.sin(ci * 1.7));
      cg.addColorStop(0, 'rgba(255,224,196,0)'); cg.addColorStop(0.42, PS.rgba(ci % 3 === 0 ? '#ffe6cf' : '#ffcfae', ca));
      cg.addColorStop(0.62, PS.rgba('#ffd0aa', ca * 0.6)); cg.addColorStop(1, 'rgba(255,208,170,0)');
      ctx.fillStyle = cg; ctx.beginPath(); ctx.ellipse(cx, cy, cw * 0.5, 8 + ci * 2.6, ci * 0.008 - 0.02, 0, 6.2832); ctx.fill();
    }
    var sunX = W * 0.30, sunY = S.horizon - S.H * 0.055;
    var ag = ctx.createRadialGradient(sunX, sunY, 0, sunX, sunY, Math.max(W, S.H) * 0.42);
    ag.addColorStop(0, 'rgba(255,224,182,.85)'); ag.addColorStop(0.18, 'rgba(255,190,132,.34)'); ag.addColorStop(1, 'rgba(255,170,110,0)');
    ctx.fillStyle = ag; ctx.fillRect(0, 0, W, S.horizon + 40);
    ctx.fillStyle = 'rgba(255,242,214,.95)'; ctx.beginPath(); ctx.arc(sunX, sunY, Math.max(11, S.H * 0.022), 0, 6.2832); ctx.fill();
    treeLine(78, 0.02, 3.0, PS.mix(S.skyCols[2], '#54606c', 0.30), 0.30);
    treeLine(52, 0.01, 2.4, PS.mix(S.skyCols[2], '#22323f', 0.5), 0.5);
    S.haze(0.85);
    var vh = ctx.createLinearGradient(0, S.horizon - S.H * 0.012, 0, S.horizon + S.H * 0.075);
    vh.addColorStop(0, 'rgba(255,206,164,.30)'); vh.addColorStop(1, 'rgba(255,206,164,0)');
    ctx.fillStyle = vh; ctx.fillRect(0, S.horizon - S.H * 0.012, W, S.H * 0.09);
    var gN = S.project(0, 0, 2.0), gF = S.project(0, 0, 60);
    var gg = ctx.createLinearGradient(0, gF[1], 0, gN[1]);
    gg.addColorStop(0, PS.mix('#c98b5e', GROUND, 0.72)); gg.addColorStop(0.3, PS.mix(GROUND, '#7a5c3c', 0.35)); gg.addColorStop(1, GROUND);
    ctx.fillStyle = gg; ctx.fillRect(0, gF[1] - 1, W, gN[1] - gF[1] + 2);
    var ls = ctx.createLinearGradient(W * 0.30 - 240, 0, W * 0.30 + 240, 0);
    ls.addColorStop(0, 'rgba(255,196,138,0)'); ls.addColorStop(0.5, 'rgba(255,196,138,.13)'); ls.addColorStop(1, 'rgba(255,196,138,0)');
    ctx.fillStyle = ls; ctx.fillRect(0, gF[1] - 1, W, gN[1] - gF[1] + 2);
    S.texture([S.project(-60, 0, 58), S.project(60, 0, 58), S.project(60, 0, 2), S.project(-60, 0, 2)], 'grain', 420, .03);
  }
  function grade(time) {
    var ctx = S.ctx;
    var rim = ctx.createLinearGradient(0, 0, S.W, S.H);
    rim.addColorStop(0, 'rgba(255,196,138,.06)'); rim.addColorStop(0.5, 'rgba(255,196,138,0)'); rim.addColorStop(1, 'rgba(60,90,120,.05)');
    ctx.fillStyle = rim; ctx.fillRect(0, 0, S.W, S.H);
    S.dust(34, time);
    S.grade();
  }

  /* ---------- SUBJECT: wall rising, three coat passes (base → acrylic → texture) ---------- */
  function drawSubject(p, time) {
    var ctx = S.ctx;
    var X0 = -6.0, X1 = 6.0, Y0 = -4.5, Y1 = 4.5, Z_WALL = 12.0, WALL_THICK = 0.25;

    // Stage timings
    var tWall   = PS.stage(p, 0.00, 0.18, 'place');     // substrate appears
    var tBase   = PS.stage(p, 0.15, 0.28, 'place');     // base coat laid
    var tTrowel = PS.stage(p, 0.38, 0.28, 'release');   // trowel sweep across base
    var tAcryl  = PS.stage(p, 0.55, 0.28, 'place');     // acrylic coat laid
    var tSweep2 = PS.stage(p, 0.72, 0.18, 'release');   // trowel sweep across acrylic
    var tTex    = PS.stage(p, 0.80, 0.20, 'place');     // texture finish speckles

    /* ---- Ground contact shadow for the whole wall ---- */
    S.shadow(0, Z_WALL, 7.0, 5.5, 0.55);
    S.contactAO(0, Z_WALL, 6.5, 5.0, 0.35);

    /* ---- SUBSTRATE (brick/block wall) ---- */
    if (tWall > 0) {
      var wallPts = [
        S.project(X0, Y0, Z_WALL),
        S.project(X1, Y0, Z_WALL),
        S.project(X1, Y1, Z_WALL),
        S.project(X0, Y1, Z_WALL)
      ];
      var wallFace = ctx.createLinearGradient(0, wallPts[0][1], 0, wallPts[2][1]);
      wallFace.addColorStop(0, PS.lighten(WALL, 0.12));
      wallFace.addColorStop(0.5, WALL);
      wallFace.addColorStop(1, PS.darken(WALL_D, 0.15));
      S.poly(wallPts, wallFace, null, tWall);
      S.mottle(wallPts, WALL, 0.08, 18);
      S.texture(wallPts, 'grain', 300, 0.04);

      // Mortar joints (horizontal lines)
      ctx.save();
      ctx.beginPath(); ctx.moveTo(wallPts[0][0], wallPts[0][1]); ctx.lineTo(wallPts[1][0], wallPts[1][1]); ctx.closePath(); ctx.clip();
      for (var mj = 0; mj < 12; mj++) {
        var my = Y0 + 0.15 + mj * 0.75;
        var p1 = S.project(X0 - 0.1, my, Z_WALL + 0.01);
        var p2 = S.project(X1 + 0.1, my, Z_WALL + 0.01);
        ctx.strokeStyle = PS.rgba(MORTAR, 0.7 * tWall);
        ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(p1[0], p1[1]); ctx.lineTo(p2[0], p2[1]); ctx.stroke();
      }
      ctx.restore();

      // Vertical joints (staggered)
      ctx.save();
      ctx.beginPath(); ctx.moveTo(wallPts[0][0], wallPts[0][1]); ctx.lineTo(wallPts[1][0], wallPts[1][1]); ctx.closePath(); ctx.clip();
      for (var vj = 0; vj < 10; vj++) {
        var mx = X0 + 0.2 + vj * 1.2 + (vj % 2 ? 0.6 : 0);
        var p1 = S.project(mx, Y0 - 0.1, Z_WALL + 0.01);
        var p2 = S.project(mx, Y1 + 0.1, Z_WALL + 0.01);
        ctx.strokeStyle = PS.rgba(MORTAR, 0.5 * tWall);
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(p1[0], p1[1]); ctx.lineTo(p2[0], p2[1]); ctx.stroke();
      }
      ctx.restore();

      // Sun-side rim (left edge)
      S.rim(wallPts[0], wallPts[3], 'rgba(255,226,186,.6)', 0.6, 1.5);
    }

    /* ---- BASE COAT (scratch coat) - rough, sandy, warm beige ---- */
    if (tBase > 0) {
      var baseZ = Z_WALL + WALL_THICK + 0.04;
      var basePts = [
        S.project(X0 - 0.1, Y0 - 0.1, baseZ),
        S.project(X1 + 0.1, Y0 - 0.1, baseZ),
        S.project(X1 + 0.1, Y1 + 0.1, baseZ),
        S.project(X0 - 0.1, Y1 + 0.1, baseZ)
      ];
      var baseGrad = ctx.createLinearGradient(0, basePts[0][1], 0, basePts[2][1]);
      baseGrad.addColorStop(0, PS.lighten(BASE_COAT, 0.10));
      baseGrad.addColorStop(0.5, BASE_COAT);
      baseGrad.addColorStop(1, PS.darken(BASE_D, 0.12));
      S.poly(basePts, baseGrad, null, tBase);

      // Materiality: mottle + grain texture (sandy feel)
      S.mottle(basePts, BASE_COAT, 0.12, 22);
      S.texture(basePts, 'grain', 400, 0.05);
      S.texture(basePts, 'aggregate', 180, 0.03);

      // Contact shadow on wall face
      S.shadow(0, baseZ, 6.5, 5.0, 0.35 * tBase);
      S.contactAO(0, baseZ, 6.2, 4.8, 0.25 * tBase);

      // Sun-side highlight (top edge of base coat)
      S.rim(basePts[0], basePts[1], 'rgba(255,238,214,.55)', 0.7 * tBase, 1.2);
    }

    /* ---- TROWEL SWEEP 1: across base coat ---- */
    if (tTrowel > 0) {
      // Trowel position sweeps bottom-to-top
      var trowelY = PS.lerp(Y0 - 0.3, Y1 + 0.3, PS.ease.out(tTrowel));
      var trowelZ = baseZ + 0.08;
      var trowelW = 2.2, trowelH = 0.35;

      // Trowel tool (steel blade)
      var tp1 = S.project(X0 - 1.5, trowelY, trowelZ);
      var tp2 = S.project(X0 - 1.5 + trowelW, trowelY, trowelZ);
      var tp3 = S.project(X0 - 1.5 + trowelW, trowelY + trowelH, trowelZ);
      var tp4 = S.project(X0 - 1.5, trowelY + trowelH, trowelZ);
      var trowelGrad = ctx.createLinearGradient(0, tp1[1], 0, tp3[1]);
      trowelGrad.addColorStop(0, PS.lighten('#9aa6b4', 0.2));
      trowelGrad.addColorStop(0.5, '#9aa6b4');
      trowelGrad.addColorStop(1, PS.darken('#7a8494', 0.2));
      S.poly([tp1, tp2, tp3, tp4], trowelGrad, 'rgba(60,70,80,.8)', tTrowel);

      // Trowel handle
      var hp1 = S.project(X0 - 1.5 - 0.4, trowelY + trowelH * 0.5, trowelZ + 0.15);
      var hp2 = S.project(X0 - 1.5 - 1.2, trowelY + trowelH * 0.5, trowelZ + 0.15);
      ctx.strokeStyle = PS.rgba('#3a3530', tTrowel);
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(hp1[0], hp1[1]); ctx.lineTo(hp2[0], hp2[1]); ctx.stroke();

      // Fresh sweep mark behind trowel (wet sheen)
      if (tTrowel < 0.9) {
        var sweepY = trowelY - 0.6;
        var sw1 = S.project(X0 - 0.5, sweepY, baseZ + 0.01);
        var sw2 = S.project(X1 + 0.5, sweepY, baseZ + 0.01);
        var sw3 = S.project(X1 + 0.5, sweepY + 0.4, baseZ + 0.01);
        var sw4 = S.project(X0 - 0.5, sweepY + 0.4, baseZ + 0.01);
        var sheen = ctx.createLinearGradient(0, sw1[1], 0, sw3[1]);
        sheen.addColorStop(0, 'rgba(255,242,214,0)');
        sheen.addColorStop(0.5, 'rgba(255,238,206,.18)');
        sheen.addColorStop(1, 'rgba(255,242,214,0)');
        ctx.globalAlpha = tTrowel * 0.8;
        S.poly([sw1, sw2, sw3, sw4], sheen, null, 1);
        ctx.globalAlpha = 1;
      }
    }

    /* ---- ACRYLIC COAT - smoother, cooler/whiter tone ---- */
    if (tAcryl > 0) {
      var acrylZ = Z_WALL + WALL_THICK + 0.04 + 0.08 + 0.06;
      var acrylPts = [
        S.project(X0 - 0.15, Y0 - 0.15, acrylZ),
        S.project(X1 + 0.15, Y0 - 0.15, acrylZ),
        S.project(X1 + 0.15, Y1 + 0.15, acrylZ),
        S.project(X0 - 0.15, Y1 + 0.15, acrylZ)
      ];
      var acrylGrad = ctx.createLinearGradient(0, acrylPts[0][1], 0, acrylPts[2][1]);
      acrylGrad.addColorStop(0, PS.lighten(ACRYLIC, 0.14));
      acrylGrad.addColorStop(0.5, ACRYLIC);
      acrylGrad.addColorStop(1, PS.darken(ACRYLIC_D, 0.10));
      S.poly(acrylPts, acrylGrad, null, tAcryl);

      // Materiality: finer grain, less aggregate, more streaks (smoother)
      S.mottle(acrylPts, ACRYLIC, 0.08, 16);
      S.texture(acrylPts, 'streak', 220, 0.04);
      S.texture(acrylPts, 'grain', 180, 0.025);

      // Contact shadow
      S.shadow(0, acrylZ, 6.8, 5.2, 0.32 * tAcryl);
      S.contactAO(0, acrylZ, 6.5, 5.0, 0.22 * tAcryl);

      // Sun-side rim (top edge)
      S.rim(acrylPts[0], acrylPts[1], 'rgba(255,246,232,.7)', 0.8 * tAcryl, 1.8);

      // Subtle wet sheen while fresh
      if (tAcryl < 0.7) {
        var glintX = S.project(0, 0, acrylZ)[0];
        var glintY = (acrylPts[0][1] + acrylPts[2][1]) * 0.5;
        var gl = ctx.createRadialGradient(glintX, glintY, 0, glintX, glintY, Math.max(80, (acrylPts[2][1] - acrylPts[0][1]) * 0.5));
        gl.addColorStop(0, 'rgba(255,246,232,' + (0.22 * (1 - tAcryl)) + ')');
        gl.addColorStop(1, 'rgba(255,246,232,0)');
        S.poly(acrylPts, gl, null, 1);
      }
    }

    /* ---- TROWEL SWEEP 2: across acrylic coat (finishing pass) ---- */
    if (tSweep2 > 0) {
      var trowelY2 = PS.lerp(Y0 - 0.3, Y1 + 0.3, PS.ease.out(tSweep2));
      var trowelZ2 = acrylZ + 0.06;

      // Trowel blade
      var tp1 = S.project(X0 - 1.5, trowelY2, trowelZ2);
      var tp2 = S.project(X0 - 1.5 + 2.2, trowelY2, trowelZ2);
      var tp3 = S.project(X0 - 1.5 + 2.2, trowelY2 + 0.35, trowelZ2);
      var tp4 = S.project(X0 - 1.5, trowelY2 + 0.35, trowelZ2);
      var trowelGrad = ctx.createLinearGradient(0, tp1[1], 0, tp3[1]);
      trowelGrad.addColorStop(0, PS.lighten('#9aa6b4', 0.25));
      trowelGrad.addColorStop(0.5, '#9aa6b4');
      trowelGrad.addColorStop(1, PS.darken('#7a8494', 0.25));
      S.poly([tp1, tp2, tp3, tp4], trowelGrad, 'rgba(60,70,80,.85)', tSweep2);

      // Handle
      var hp1 = S.project(X0 - 1.5 - 0.4, trowelY2 + 0.17, trowelZ2 + 0.15);
      var hp2 = S.project(X0 - 1.5 - 1.2, trowelY2 + 0.17, trowelZ2 + 0.15);
      ctx.strokeStyle = PS.rgba('#3a3530', tSweep2);
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(hp1[0], hp1[1]); ctx.lineTo(hp2[0], hp2[1]); ctx.stroke();

      // Finishing sheen
      if (tSweep2 < 0.85) {
        var sweepY = trowelY2 - 0.5;
        var sw1 = S.project(X0 - 0.5, sweepY, acrylZ + 0.01);
        var sw2 = S.project(X1 + 0.5, sweepY, acrylZ + 0.01);
        var sw3 = S.project(X1 + 0.5, sweepY + 0.35, acrylZ + 0.01);
        var sw4 = S.project(X0 - 0.5, sweepY + 0.35, acrylZ + 0.01);
        var sheen = ctx.createLinearGradient(0, sw1[1], 0, sw3[1]);
        sheen.addColorStop(0, 'rgba(255,242,214,0)');
        sheen.addColorStop(0.5, 'rgba(255,246,232,.22)');
        sheen.addColorStop(1, 'rgba(255,242,214,0)');
        ctx.globalAlpha = tSweep2 * 0.85;
        S.poly([sw1, sw2, sw3, sw4], sheen, null, 1);
        ctx.globalAlpha = 1;
      }
    }

    /* ---- TEXTURE FINISH - fine speckle/grain, visible texture ---- */
    if (tTex > 0) {
      var texZ = Z_WALL + WALL_THICK + 0.04 + 0.08 + 0.06 + 0.06 + 0.05;
      var texPts = [
        S.project(X0 - 0.2, Y0 - 0.2, texZ),
        S.project(X1 + 0.2, Y0 - 0.2, texZ),
        S.project(X1 + 0.2, Y1 + 0.2, texZ),
        S.project(X0 - 0.2, Y1 + 0.2, texZ)
      ];
      var texGrad = ctx.createLinearGradient(0, texPts[0][1], 0, texPts[2][1]);
      texGrad.addColorStop(0, PS.lighten(TEXTURE, 0.12));
      texGrad.addColorStop(0.5, TEXTURE);
      texGrad.addColorStop(1, PS.darken(TEXTURE_D, 0.08));
      S.poly(texPts, texGrad, null, tTex);

      // Materiality: visible texture - aggregate speckles + fine grain
      S.mottle(texPts, TEXTURE, 0.06, 14);
      S.texture(texPts, 'aggregate', 320, 0.06);  // visible sand/aggregate
      S.texture(texPts, 'grain', 260, 0.035);
      S.texture(texPts, 'streak', 120, 0.02);     // subtle tool marks

      // Contact shadow
      S.shadow(0, texZ, 7.0, 5.5, 0.38 * tTex);
      S.contactAO(0, texZ, 6.8, 5.3, 0.28 * tTex);

      // Strong sun-side rim (final coat catches light)
      S.rim(texPts[0], texPts[1], 'rgba(255,246,232,.85)', 0.9 * tTex, 2.2);
      S.rim(texPts[3], texPts[2], 'rgba(255,214,170,.45)', 0.5 * tTex, 1.4);
    }

    /* ---- Scale cue: person at base of wall ---- */
    S.scaleCue(-7.5, Z_WALL + 4, 'person');
  }

  function frame(S_, p, time) {
    S = S_;
    env(time);
    drawSubject(p, time);
    grade(time);
    var idx = p < 0.15 ? 0 : p < 0.40 ? 1 : p < 0.55 ? 2 : p < 0.72 ? 3 : p < 0.80 ? 4 : 5;
    if (stgNum) stgNum.textContent = (idx < 10 ? '0' : '') + (idx + 1);
    if (stgName) stgName.textContent = ['Substrate', 'Base coat', 'Trowel pass', 'Acrylic coat', 'Finish pass', 'Texture coat'][idx];
    if (railFill) railFill.style.width = Math.round(p * 100) + '%';
    if (heroCopy) heroCopy.style.opacity = PS.clamp(1 - p * 2.4, 0, 1);
  }
  S.start();
})();
</script>

<script>
// ===== reveals + year =====
(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
</body>
