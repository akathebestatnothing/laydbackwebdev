<script>
// ===== FRAME HERO — timber wall frame assembling in perspective =====
(() => {
  const canvas = document.getElementById('frameCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W = 0, H = 0, raf = 0, reduce = false;
  const TIMBER = '#c89a6b', TIMBER2 = '#a8560f';

  function resize(){
    const host = canvas.parentElement;
    W = Math.max(320, host.clientWidth || window.innerWidth);
    H = Math.max(420, host.clientHeight || window.innerHeight);
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = Math.floor(W * dpr); canvas.height = Math.floor(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  function project(x, z){
    // floor-plane projection: camera above the floor looking down.
    // Visible band = z where y lands between horizon (~0.60H) and screen bottom.
    const f = 1.15 * H;
    const horizon = H * 0.60;
    const camH = (W < 640) ? 1.9 : 1.0;
    const zz = Math.max(0.9, z);
    const s = f / zz;
    return { x: W * 0.42 + x * s, y: horizon + camH * f / zz };
  }
  function drawFrame(t){
    ctx.clearRect(0, 0, W, H);
    const time = (t || 0) / 1000;
    const prog = Math.min(1, (time - 0.2) / 6);
    const ease = prog <= 0 ? 0 : 1 - Math.pow(1 - prog, 3);

    // floor plane: warm timber-toned ground with perspective plank lines
    const ground = ctx.createLinearGradient(0, H * 0.55, 0, H);
    ground.addColorStop(0, 'rgba(201,111,31,.12)');
    ground.addColorStop(1, 'rgba(201,111,31,.22)');
    ctx.fillStyle = ground;
    ctx.fillRect(0, H * 0.52, W, H * 0.48);
    ctx.strokeStyle = 'rgba(168,86,15,.30)';
    ctx.lineWidth = 1.4;
    for (let z = 2.2; z <= 14; z += 0.9){
      const a = project(-3.0, z), b = project(3.0, z);
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
    }
    // vertical guides (stud shadows/layout lines)
    ctx.strokeStyle = 'rgba(168,86,15,.15)';
    for (let r = 0; r <= 6; r++){
      const x = -2.6 + r * 0.8;
      const a = project(x, 2.4), b = project(x, 11.0);
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
    }

    // RIGHT-of-text timber wall frame: a full wall panel elevation —
        // top plate, sole plate, and evenly spaced studs between them (a real
        // timber-framing diagram), assembling with a slight stagger.
        const wallH = Math.min(H * 0.40, 320);
        const wallTop = H * 0.30 + (1 - ease) * 40;
        // panel x-range on the right side, clear of the headline
        const panXL = W * 0.56, panXR = W * 0.92;
        const panW = panXR - panXL;
        // sole plate and top plate (thick timber bars)
        ctx.fillStyle = '#a8560f';
        ctx.fillRect(panXL, wallTop + wallH - 12, panW, 12);
        ctx.fillRect(panXL, wallTop, panW, 12);
        // studs with noggins (diagonal bracing + mid rail)
        const nStuds = 7;
        const gap = panW / (nStuds + 1);
        for (let s = 1; s <= nStuds; s++){
          const sxl = panXL + s * gap - 6;
          const appear = Math.min(1, ease * 2.2 - (s - 1) * 0.1 + 0.2);
          ctx.fillStyle = (s % 2) ? '#c89a6b' : '#b9875a';
          ctx.globalAlpha = Math.max(0.15, appear);
          ctx.fillRect(sxl, wallTop + 8, 12, wallH - 20);
          ctx.globalAlpha = 1;
        }
        // mid rail (noggins line)
        ctx.fillStyle = '#b9875a';
        ctx.fillRect(panXL + 4, wallTop + wallH * 0.52, panW - 8, 9);
        // layout tick marks on the sole plate
        ctx.fillStyle = '#8a6a3c';
        for (let s = 1; s <= nStuds; s++){
          ctx.fillRect(panXL + s * gap - 1, wallTop + wallH, 2, 6);
        }
        // dimension annotation
        if (ease > 0.25){
          ctx.fillStyle = 'rgba(168,86,15,.95)';
          ctx.font = '11px monospace';
          ctx.fillText('90 x 45 STUDS', panXL, wallTop - 14);
          ctx.fillText('S=600  TOP/SOLE PLATE', panXL, wallTop - 2);
        }
  }
  function loop(t){ drawFrame(t); if (!reduce) raf = requestAnimationFrame(loop); }
  reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  resize(); window.addEventListener('resize', resize);
  if (reduce) drawFrame(0); else raf = requestAnimationFrame(loop);
})();

// ===== JOINT DETAIL — lap joint line drawing =====
(() => {
  const c = document.getElementById('jointCanvas');
  if (!c) return;
  const cx = c.getContext('2d');
  const w = c.width, h = c.height;
  cx.strokeStyle = '#a8560f'; cx.lineWidth = 2.5; cx.lineCap = 'round';
  cx.beginPath(); cx.moveTo(w*0.42, h*0.08); cx.lineTo(w*0.42, h*0.92); cx.stroke();
  cx.beginPath(); cx.moveTo(w*0.09, h*0.30); cx.lineTo(w*0.42, h*0.24);
  cx.lineTo(w*0.42, h*0.36);
  cx.lineTo(w*0.58, h*0.30); cx.lineTo(w*0.91, h*0.30); cx.stroke();
  cx.fillStyle = '#c96f1f';
  cx.beginPath(); cx.arc(w*0.42, h*0.30, 4, 0, 6.283); cx.fill();
  cx.fillStyle = '#2b2620'; cx.font = '12px monospace';
  cx.fillText('2 / 4.2mm fix', w*0.50, h*0.44);
  cx.fillText('GLUE + SCREW', w*0.10, h*0.22);
  cx.strokeStyle = 'rgba(43,38,32,.2)';
  cx.setLineDash([6,4]); cx.lineWidth = 1;
  cx.beginPath(); cx.moveTo(w*0.06, h*0.5); cx.lineTo(w*0.94, h*0.5); cx.stroke();
})();
</script>

