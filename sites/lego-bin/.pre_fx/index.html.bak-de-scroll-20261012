    [-1,1].forEach(function(side){
      [-1,1].forEach(function(ax){
        var wx=driveX+side*(BED_W/2+0.12),wz=TRUCK_Z+ax*(BED_L/2-0.5);
        var whl=S.project(wx,TRUCK_Y-WHEEL_R,wz),ws=S.focal/wz;
        ctx.save();ctx.translate(whl[0],whl[1]);
        ctx.fillStyle=TRUCK_WHEEL;ctx.beginPath();ctx.ellipse(0,0,WHEEL_W*ws,WHEEL_R*ws*0.5,0,0,6.2832);ctx.fill();
        ctx.strokeStyle=PS.rgba('#1a1a1a',0.6);ctx.lineWidth=1.5;ctx.stroke();
        ctx.restore();
        S.shadow(wx,wz,WHEEL_W*0.6,WHEEL_R*0.4,0.5);
      });
    });

    /* Bin on truck bed (lifted) */
    if(t4>0){
      var liftProg=1;
      var liftY=curBinY+4.5;
      var binOnTruckPts=[
        S.project(driveX-BIN_W/2,liftY-BIN_H/2,BIN_Z-BIN_L/2),
        S.project(driveX+BIN_W/2,liftY-BIN_H/2,BIN_Z-BIN_L/2),
        S.project(driveX+BIN_W/2,liftY+BIN_H/2,BIN_Z-BIN_L/2),
        S.project(driveX-BIN_W/2,liftY+BIN_H/2,BIN_Z-BIN_L/2),
        S.project(driveX-BIN_W/2,liftY-BIN_H/2,BIN_Z+BIN_L/2),
        S.project(driveX+BIN_W/2,liftY-BIN_H/2,BIN_Z+BIN_L/2),
        S.project(driveX+BIN_W/2,liftY+BIN_H/2,BIN_Z+BIN_L/2),
        S.project(driveX-BIN_W/2,liftY+BIN_H/2,BIN_Z+BIN_L/2)
      ];
      faces=[[0,1,2,3],[4,5,6,7],[0,4,7,3],[1,2,6,5],[0,1,5,4],[2,3,7,6]];
      sideCol=[BIN_SIDE,BIN_SIDE,BIN_YELLOW,BIN_YELLOW_DARK,BIN_SIDE,BIN_YELLOW];
      faces.forEach(function(fc,fi){
        var pfc=[binOnTruckPts[fc[0]],binOnTruckPts[fc[1]],binOnTruckPts[fc[2]],binOnTruckPts[fc[3]]];
        var faceGrad=ctx.createLinearGradient(0,pfc[0][1],0,pfc[2][1]);
        faceGrad.addColorStop(0,PS.lighten(sideCol[fi],0.15));
        faceGrad.addColorStop(0.6,sideCol[fi]);
        faceGrad.addColorStop(1,PS.darken(sideCol[fi],0.3));
        S.poly(pfc,faceGrad,PS.rgba('#1a1400',0.5),1);
        S.mottle(pfc,sideCol[fi],0.08,10);
        S.texture(pfc,fi<2?'streak':'grain',fi<2?80:60,.04);
      });
    }
  }

  /* Scale cue - traffic cone near bin */
  if(p<0.7){
    S.scaleCue(BIN_X+3.5,BIN_Z+1,'cone');
  }
}

function frame(S_,p,time){
  S=S_;
  env(time);
  drawSubject(p,time);
  grade(time);

  /* HUD updates */
  var idx=p<0.18?0:p<0.38?1:p<0.66?2:p<0.8?3:p<0.95?4:5;
  if(stgNum)stgNum.textContent='0'+(idx+1);
  if(stgName)stgName.textContent=STG_NAMES[idx];
  if(railFill)railFill.style.width=Math.round(p*100)+'%';
  if(heroCopy)heroCopy.style.opacity=PS.clamp(1-p*2.4,0,1);
}

S.start();
})();

/* ===== reveals + year ===== */
(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
