    S.texture(cabPts2,'streak',100,.05);
    S.rim(cabPts2[2],cabPts2[3],PS.rgba('#ffd600',0.35),0.7,1.5);

    /* Bed leaving */
    var bedPts2=[
      S.project(driveX-BED_W/2,TRUCK_Y+BED_H/2,TRUCK_Z-BED_L/2),
      S.project(driveX+BED_W/2,TRUCK_Y+BED_H/2,TRUCK_Z-BED_L/2),
      S.project(driveX+BED_W/2,TRUCK_Y+BED_H/2,TRUCK_Z+BED_L/2),
      S.project(driveX-BED_W/2,TRUCK_Y+BED_H/2,TRUCK_Z+BED_L/2)
    ];
    S.shadow(driveX,TRUCK_Z,BED_W/2,BED_L/2,0.38);
    var bedGrad2=ctx.createLinearGradient(0,bedPts2[0][1],0,bedPts2[3][1]);
    bedGrad2.addColorStop(0,PS.lighten(TRUCK_BED,0.12));bedGrad2.addColorStop(1,PS.darken(TRUCK_BED,0.28));
    S.poly(bedPts2,bedGrad2,PS.rgba('#060608',0.5),1);
    S.texture(bedPts2,'grain',120,.04);

