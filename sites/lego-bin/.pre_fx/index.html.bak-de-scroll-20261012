      S.project(armBaseX+0.08,TRUCK_Y+BED_H,armBaseZ),
      S.project(armBaseX+0.08,liftY-BIN_H/2-0.2,armBaseZ),
      S.project(armBaseX-0.08,liftY-BIN_H/2-0.2,armBaseZ)
    ];
    S.poly(armPts,HYDRAULIC,PS.rgba('#aa8800',0.6),1);
    S.texture(armPts,'streak',80,.06);

    /* Chain hooks */
    [-1,1].forEach(function(s){
      var hx=BIN_X+s*BIN_W/2*0.7,hy=liftY+BIN_H/2;
      var chainPts=[
