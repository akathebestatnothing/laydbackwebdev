/* ---------- SUBJECT: SKIP BIN LIFECYCLE ---------- */
function drawSubject(p,time){
  var ctx=S.ctx;
  var t1=PS.stage(p,0.00,0.18,'place'),
      t2=PS.stage(p,0.18,0.20,'place'),
      t3=PS.stage(p,0.38,0.32,'release'),
      t4=PS.stage(p,0.66,0.34,'place'),
      t5=PS.stage(p,0.80,0.20,'release');

  /* Scene bounds */
  var TRUCK_X_START=-20, TRUCK_X_PARK=-3, TRUCK_Y=0.65, TRUCK_Z=0.5;
  var CAB_W=2.6, CAB_H=2.3, CAB_L=2.6;
  var BED_W=2.4, BED_H=0.35, BED_L=6.8;
  var WHEEL_R=0.55, WHEEL_W=0.3;
  var BIN_W=3.0, BIN_H=1.5, BIN_L=5.2;
  var BIN_X=-3, BIN_Y=BIN_H/2, BIN_Z=0.5;

  /* --- PHASE 1: Truck arrives (0.00 - 0.20) --- */
  var truckX=PS.lerp(TRUCK_X_START,TRUCK_X_PARK,t1);
  /* Cab */
  var cabPts=[
    S.project(truckX-CAB_W/2,TRUCK_Y,TRUCK_Z-CAB_L/2),
    S.project(truckX+CAB_W/2,TRUCK_Y,TRUCK_Z-CAB_L/2),
    S.project(truckX+CAB_W/2,TRUCK_Y+CAB_H,TRUCK_Z-CAB_L/2),
    S.project(truckX-CAB_W/2,TRUCK_Y+CAB_H,TRUCK_Z-CAB_L/2)
  ];
  S.shadow(truckX,TRUCK_Z,CAB_W/2,CAB_L/2,0.45);
  S.castShadow(truckX,TRUCK_Z,CAB_W/2,CAB_H,4.0,0.22);
  var cabGrad=ctx.createLinearGradient(0,cabPts[2][1],0,cabPts[0][1]);
  cabGrad.addColorStop(0,PS.lighten(TRUCK_DARK,0.18));cabGrad.addColorStop(1,PS.darken(TRUCK_DARK,0.35));
  S.poly(cabPts,cabGrad,PS.rgba('#08080a',0.55),1);
  S.texture(cabPts,'streak',100,.05);
  S.rim(cabPts[2],cabPts[3],PS.rgba('#ffd600',0.35),0.7,1.5);

  /* Cab roof */
  var roofPts=[
    S.project(truckX-CAB_W/2*0.9,TRUCK_Y+CAB_H,TRUCK_Z-CAB_L/2),
    S.project(truckX+CAB_W/2*0.9,TRUCK_Y+CAB_H,TRUCK_Z-CAB_L/2),
    S.project(truckX+CAB_W/2*0.9,TRUCK_Y+CAB_H,TRUCK_Z+CAB_L/2),
    S.project(truckX-CAB_W/2*0.9,TRUCK_Y+CAB_H,TRUCK_Z+CAB_L/2)
  ];
  S.poly(roofPts,TRUCK_DARK,PS.rgba('#08080a',0.5),1);

  /* Bed */
  var bedPts=[
    S.project(truckX-BED_W/2,TRUCK_Y+BED_H/2,TRUCK_Z-BED_L/2),
    S.project(truckX+BED_W/2,TRUCK_Y+BED_H/2,TRUCK_Z-BED_L/2),
    S.project(truckX+BED_W/2,TRUCK_Y+BED_H/2,TRUCK_Z+BED_L/2),
    S.project(truckX-BED_W/2,TRUCK_Y+BED_H/2,TRUCK_Z+BED_L/2)
  ];
  S.shadow(truckX,TRUCK_Z,BED_W/2,BED_L/2,0.38);
  var bedGrad=ctx.createLinearGradient(0,bedPts[0][1],0,bedPts[3][1]);
  bedGrad.addColorStop(0,PS.lighten(TRUCK_BED,0.12));bedGrad.addColorStop(1,PS.darken(TRUCK_BED,0.28));
  S.poly(bedPts,bedGrad,PS.rgba('#060608',0.5),1);
  S.texture(bedPts,'grain',120,.04);

  /* Wheels */
  [-1,1].forEach(function(side){
    [-1,1].forEach(function(ax){
      var wx=truckX+side*(BED_W/2+0.12),wz=TRUCK_Z+ax*(BED_L/2-0.5);
      var whl=S.project(wx,TRUCK_Y-WHEEL_R,wz),ws=S.focal/wz;
      ctx.save();ctx.translate(whl[0],whl[1]);ctx.rotate(0);
      ctx.fillStyle=TRUCK_WHEEL;ctx.beginPath();ctx.ellipse(0,0,WHEEL_W*ws,WHEEL_R*ws*0.5,0,0,6.2832);ctx.fill();
      ctx.strokeStyle=PS.rgba('#1a1a1a',0.6);ctx.lineWidth=1.5;ctx.stroke();
      ctx.restore();
      S.shadow(wx,wz,WHEEL_W*0.6,WHEEL_R*0.4,0.5);
    });
  });

  /* Hydraulic arm (folded on truck during arrival) */
  if(t1<0.9){
    var armBaseX=truckX,armBaseZ=TRUCK_Z+BED_L/2-0.9;
    var armY=TRUCK_Y+BED_H+1.5;
    var armPts=[
      S.project(armBaseX-0.08,TRUCK_Y+BED_H,armBaseZ),
      S.project(armBaseX+0.08,TRUCK_Y+BED_H,armBaseZ),
      S.project(armBaseX+0.08,armY,armBaseZ),
      S.project(armBaseX-0.08,armY,armBaseZ)
    ];
    S.poly(armPts,HYDRAULIC,PS.rgba('#aa8800',0.6),1);
    S.texture(armPts,'streak',60,.06);
  }

  /* --- PHASE 2: Bin set down (0.20 - 0.40) --- */
  if(t2>0){
    var binDropY=PS.lerp(TRUCK_Y+BED_H+BIN_H/2+1.0,BIN_Y,t2);
    var binSettle=PS.ease.out(t2);
    var curBinY=binDropY-(1-binSettle)*0.15;
    var binAngle=(1-t2)*0.15;

    /* Bin body */
    var binPts=[
      S.project(BIN_X-BIN_W/2,curBinY-BIN_H/2,BIN_Z-BIN_L/2),
      S.project(BIN_X+BIN_W/2,curBinY-BIN_H/2,BIN_Z-BIN_L/2),
      S.project(BIN_X+BIN_W/2,curBinY+BIN_H/2,BIN_Z-BIN_L/2),
      S.project(BIN_X-BIN_W/2,curBinY+BIN_H/2,BIN_Z-BIN_L/2),
      S.project(BIN_X-BIN_W/2,curBinY-BIN_H/2,BIN_Z+BIN_L/2),
      S.project(BIN_X+BIN_W/2,curBinY-BIN_H/2,BIN_Z+BIN_L/2),
      S.project(BIN_X+BIN_W/2,curBinY+BIN_H/2,BIN_Z+BIN_L/2),
      S.project(BIN_X-BIN_W/2,curBinY+BIN_H/2,BIN_Z+BIN_L/2)
    ];
    if(t2<1){
      S.shadow(BIN_X,BIN_Z,BIN_W/2,BIN_L/2,0.55*(1-binSettle)+0.25*binSettle);
    }else{
      S.shadow(BIN_X,BIN_Z,BIN_W/2,BIN_L/2,0.35);
      S.contactAO(BIN_X,BIN_Z,BIN_W/2,BIN_L/2,0.32);
    }

    var faces=[[0,1,2,3],[4,5,6,7],[0,4,7,3],[1,2,6,5],[0,1,5,4],[2,3,7,6]];
    var sideCol=[BIN_SIDE,BIN_SIDE,BIN_YELLOW,BIN_YELLOW_DARK,BIN_SIDE,BIN_YELLOW];
    faces.forEach(function(fc,fi){
      var pfc=[binPts[fc[0]],binPts[fc[1]],binPts[fc[2]],binPts[fc[3]]];
      var faceGrad=ctx.createLinearGradient(0,pfc[0][1],0,pfc[2][1]);
      faceGrad.addColorStop(0,PS.lighten(sideCol[fi],0.15));
      faceGrad.addColorStop(0.6,sideCol[fi]);
      faceGrad.addColorStop(1,PS.darken(sideCol[fi],0.3));
      S.poly(pfc,faceGrad,PS.rgba('#1a1400',0.5),1);
      S.mottle(pfc,sideCol[fi],0.08,10);
      S.texture(pfc,fi<2?'streak':'grain',fi<2?80:60,.04);
    });

    /* Top rim */
    if(t2>0.3){
      var rimPts=[
        S.project(BIN_X-BIN_W/2*1.02,curBinY+BIN_H/2,BIN_Z-BIN_L/2*1.02),
        S.project(BIN_X+BIN_W/2*1.02,curBinY+BIN_H/2,BIN_Z-BIN_L/2*1.02),
        S.project(BIN_X+BIN_W/2*1.02,curBinY+BIN_H/2,BIN_Z+BIN_L/2*1.02),
        S.project(BIN_X-BIN_W/2*1.02,curBinY+BIN_H/2,BIN_Z+BIN_L/2*1.02)
      ];
      S.poly(rimPts,BIN_YELLOW,PS.rgba('#aa8800',0.6),1);
    }
  }

  /* --- PHASE 3: Bin fills with rubble (0.40 - 0.70) --- */
  if(t3>0){
    var rubbleCount=80;
    for(var i=0;i<rubbleCount;i++){
      var prog=PS.clamp((t3*(rubbleCount+10)-i)/10,0,1);
      if(prog<=0)continue;
      var rng=new (function(seed){var s=seed;return function(){s=(s*1103515245+12345)&0x7fffffff;return s/0x7fffffff;};})(i*1007);
      var rx=rng()*BIN_W*0.75-BIN_W*0.375;
      var rz=rng()*BIN_L*0.75-BIN_L*0.375;
      var ry=BIN_H*0.85*(1-prog*0.6)+rng()*0.15;
      var settle=PS.ease.out(prog);
      var rsx=0.12+rng()*0.25,rsy=0.08+rng()*0.2,rsz=0.12+rng()*0.25;
      var rubCol=RUBBLE_MIX[Math.floor(rng()*RUBBLE_MIX.length)];
      var rubPts=[
        S.project(BIN_X+rx-rsx/2,curBinY-BIN_H/2+ry-rsy/2,BIN_Z+rz-rsz/2),
        S.project(BIN_X+rx+rsx/2,curBinY-BIN_H/2+ry-rsy/2,BIN_Z+rz-rsz/2),
        S.project(BIN_X+rx+rsx/2,curBinY-BIN_H/2+ry+rsy/2,BIN_Z+rz-rsz/2),
        S.project(BIN_X+rx-rsx/2,curBinY-BIN_H/2+ry+rsy/2,BIN_Z+rz-rsz/2),
        S.project(BIN_X+rx-rsx/2,curBinY-BIN_H/2+ry-rsy/2,BIN_Z+rz+rsz/2),
        S.project(BIN_X+rx+rsx/2,curBinY-BIN_H/2+ry-rsy/2,BIN_Z+rz+rsz/2),
        S.project(BIN_X+rx+rsx/2,curBinY-BIN_H/2+ry+rsy/2,BIN_Z+rz+rsz/2),
        S.project(BIN_X+rx-rsx/2,curBinY-BIN_H/2+ry+rsy/2,BIN_Z+rz+rsz/2)
      ];
      var rubGrad=ctx.createLinearGradient(0,rubPts[0][1],0,rubPts[2][1]);
      rubGrad.addColorStop(0,PS.lighten(rubCol,0.12));
      rubGrad.addColorStop(1,PS.darken(rubCol,0.25));
      ctx.globalAlpha=prog;
      S.poly([rubPts[0],rubPts[1],rubPts[2],rubPts[3]],rubGrad,PS.rgba('#1a140a',0.4),1);
      ctx.globalAlpha=1;
