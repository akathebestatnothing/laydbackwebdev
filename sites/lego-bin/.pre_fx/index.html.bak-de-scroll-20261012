      S.project(BIN_X-BIN_W/2,liftY-BIN_H/2,BIN_Z-BIN_L/2),
      S.project(BIN_X+BIN_W/2,liftY-BIN_H/2,BIN_Z-BIN_L/2),
      S.project(BIN_X+BIN_W/2,liftY+BIN_H/2,BIN_Z-BIN_L/2),
      S.project(BIN_X-BIN_W/2,liftY+BIN_H/2,BIN_Z-BIN_L/2),
      S.project(BIN_X-BIN_W/2,liftY-BIN_H/2,BIN_Z+BIN_L/2),
      S.project(BIN_X+BIN_W/2,liftY-BIN_H/2,BIN_Z+BIN_L/2),
      S.project(BIN_X+BIN_W/2,liftY+BIN_H/2,BIN_Z+BIN_L/2),
      S.project(BIN_X-BIN_W/2,liftY+BIN_H/2,BIN_Z+BIN_L/2)
    ];
    faces=[[0,1,2,3],[4,5,6,7],[0,4,7,3],[1,2,6,5],[0,1,5,4],[2,3,7,6]];
    sideCol=[BIN_SIDE,BIN_SIDE,BIN_YELLOW,BIN_YELLOW_DARK,BIN_SIDE,BIN_YELLOW];
    faces.forEach(function(fc,fi){
      var pfc=[liftedBinPts[fc[0]],liftedBinPts[fc[1]],liftedBinPts[fc[2]],liftedBinPts[fc[3]]];
      var faceGrad=ctx.createLinearGradient(0,pfc[0][1],0,pfc[2][1]);
      faceGrad.addColorStop(0,PS.lighten(sideCol[fi],0.15));
      faceGrad.addColorStop(0.6,sideCol[fi]);
      faceGrad.addColorStop(1,PS.darken(sideCol[fi],0.3));
      S.poly(pfc,faceGrad,PS.rgba('#1a1400',0.5),1);
      S.mottle(pfc,sideCol[fi],0.08,10);
      S.texture(pfc,fi<2?'streak':'grain',fi<2?80:60,.04);
    });

    /* Rubble inside lifted bin */
    if(t3>0){
      rubbleCount=80;
      for(var i=0;i<rubbleCount;i++){
        var rng=new (function(seed){var s=seed;return function(){s=(s*1103515245+12345)&0x7fffffff;return s/0x7fffffff;};})(i*1007);
        var rx=rng()*BIN_W*0.75-BIN_W*0.375;
        var rz=rng()*BIN_L*0.75-BIN_L*0.375;
        var ry=BIN_H*0.85;
        var rsx=0.12+rng()*0.25,rsy=0.08+rng()*0.2,rsz=0.12+rng()*0.25;
        var rubCol=RUBBLE_MIX[Math.floor(rng()*RUBBLE_MIX.length)];
        var rubPts=[
          S.project(BIN_X+rx-rsx/2,liftY-BIN_H/2+ry-rsy/2,BIN_Z+rz-rsz/2),
          S.project(BIN_X+rx+rsx/2,liftY-BIN_H/2+ry-rsy/2,BIN_Z+rz-rsz/2),
          S.project(BIN_X+rx+rsx/2,liftY-BIN_H/2+ry+rsy/2,BIN_Z+rz-rsz/2),
          S.project(BIN_X+rx-rsx/2,liftY-BIN_H/2+ry+rsy/2,BIN_Z+rz-rsz/2),
          S.project(BIN_X+rx-rsx/2,liftY-BIN_H/2+ry-rsy/2,BIN_Z+rz+rsz/2),
          S.project(BIN_X+rx+rsx/2,liftY-BIN_H/2+ry-rsy/2,BIN_Z+rz+rsz/2),
          S.project(BIN_X+rx+rsx/2,liftY-BIN_H/2+ry+rsy/2,BIN_Z+rz+rsz/2),
          S.project(BIN_X+rx-rsx/2,liftY-BIN_H/2+ry+rsy/2,BIN_Z+rz+rsz/2)
        ];
        var rubGrad=ctx.createLinearGradient(0,rubPts[0][1],0,rubPts[2][1]);
        rubGrad.addColorStop(0,PS.lighten(rubCol,0.12));
        rubGrad.addColorStop(1,PS.darken(rubCol,0.25));
        S.poly([rubPts[0],rubPts[1],rubPts[2],rubPts[3]],rubGrad,PS.rgba('#1a140a',0.4),1);
      }
    }
  }

  /* --- PHASE 5: Truck drives out with bin (0.80 - 1.00) --- */
  if(t5>0){
    var driveX=PS.lerp(TRUCK_X_PARK,TRUCK_X_START-5,t5);
    
    /* Cab leaving */
    var cabPts2=[
      S.project(driveX-CAB_W/2,TRUCK_Y,TRUCK_Z-CAB_L/2),
      S.project(driveX+CAB_W/2,TRUCK_Y,TRUCK_Z-CAB_L/2),
      S.project(driveX+CAB_W/2,TRUCK_Y+CAB_H,TRUCK_Z-CAB_L/2),
      S.project(driveX-CAB_W/2,TRUCK_Y+CAB_H,TRUCK_Z-CAB_L/2)
    ];
    S.shadow(driveX,TRUCK_Z,CAB_W/2,CAB_L/2,0.45);
    S.castShadow(driveX,TRUCK_Z,CAB_W/2,CAB_H,4.0,0.22);
    var cabGrad2=ctx.createLinearGradient(0,cabPts2[2][1],0,cabPts2[0][1]);
    cabGrad2.addColorStop(0,PS.lighten(TRUCK_DARK,0.18));cabGrad2.addColorStop(1,PS.darken(TRUCK_DARK,0.35));
