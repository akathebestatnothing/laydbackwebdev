      var off=si-(n-1)/2,step2;
      if(axs==='x'){step2=o.sx/n;c.sx=step2+0.02;c.cx=(o.cx||0)+off*step2;}
      else if(axs==='z'){step2=o.sz/n;c.sz=step2+0.02;
        var dir=rotXv([0,0,1],o.rot||0);
        c.cz=(o.cz||0)+dir[2]*off*step2;c.cy=(o.cy||0)+dir[1]*off*step2;}
      else{step2=o.sy/n;c.sy=step2+0.01;c.cy=(o.cy||0)+off*step2;}
      c.t0=(o.t0||0)+si*0.003;
      add(c);
    }
    return;
  }
  o.rot=o.rot||0;o.spin=o.spin||0;o.alpha=(o.alpha==null)?1:o.alpha;
  o.stroke=(o.stroke==null)?true:o.stroke;o.t0=o.t0||0;o.dur=o.dur||0.12;
  o.fly=o.fly||[0,0,0];o.axis=o.axis||[rr(-1,1),rr(0.35,1),rr(-1,1)];o.lay=(o.lay==null)?LAY:o.lay;
  o.rgb=hex2rgb(Array.isArray(o.c)?o.c[Math.floor(rnd()*o.c.length)]:o.c);
  o.cx=o.cx||0;o.cy=o.cy||0;o.cz=o.cz||0;
  pieces.push(o);
}

/* --- BUILD THE PIPE RUN --- */
/* Layout: supply from left → horizontal → elbow up → vertical → elbow right → horizontal → elbow down → outlet */
/* Coordinates in normalized space: x -8..8, y 0..3, z -3..3 */

LAY=1; /* supply entry and first horizontal */
add({cx:-7.5,cy:1.5,cz:0,sx:0.14,sy:PIPE_D,sz:PIPE_D,c:C.pipe,t0:0.02,dur:0.10,fly:[-4,-6,2],spin:1.2}); /* supply stub */
add({cx:-5.5,cy:1.5,cz:0,sx:4.0,sy:PIPE_D,sz:PIPE_D,c:C.pipe,t0:0.04,dur:0.12,fly:[-3,-5,1],spin:1.0,split:['x',4]}); /* horizontal run 1 */

/* first elbow (up) at x≈-1.5 */
LAY=2;
add({cx:-1.5,cy:1.5,cz:0,sx:PIPE_D,sy:PIPE_D,sz:PIPE_D,rot:Math.PI/2,c:C.pipe,t0:0.14,dur:0.10,fly:[2,-3,0],spin:1.5}); /* elbow */

/* vertical rise */
add({cx:-1.5,cy:2.1,cz:0,sx:PIPE_D,sy:1.0,sz:PIPE_D,c:C.pipe,t0:0.16,dur:0.12,fly:[1,-2,0],spin:1.2,split:['y',3]});

/* second elbow (right) at y≈2.6 */
add({cx:-1.5,cy:2.65,cz:0,sx:PIPE_D,sy:PIPE_D,sz:PIPE_D,rot:0,c:C.pipe,t0:0.26,dur:0.10,fly:[0,2,0],spin:1.5});

/* horizontal run 2 (along top) */
LAY=3;
add({cx:0.5,cy:2.65,cz:0,sx:4.0,sy:PIPE_D,sz:PIPE_D,c:C.pipe,t0:0.28,dur:0.14,fly:[-2,3,-1],spin:1.0,split:['x',4]});

/* third elbow (down) at x≈4.5 */
add({cx:4.5,cy:2.65,cz:0,sx:PIPE_D,sy:PIPE_D,sz:PIPE_D,rot:-Math.PI/2,c:C.pipe,t0:0.40,dur:0.10,fly:[3,2,0],spin:1.5});

/* vertical drop to outlet */
LAY=4;
add({cx:4.5,cy:2.0,cz:0,sx:PIPE_D,sy:1.0,sz:PIPE_D,c:C.pipe,t0:0.42,dur:0.12,fly:[2,1,0],spin:1.2,split:['y',3]});

/* outlet elbow + stub */
add({cx:4.5,cy:1.5,cz:0,sx:PIPE_D,sy:PIPE_D,sz:PIPE_D,rot:0,c:C.pipe,t0:0.52,dur:0.10,fly:[4,0,0],spin:1.5});
add({cx:6.5,cy:1.5,cz:0,sx:1.0,sy:PIPE_D,sz:PIPE_D,c:C.pipe,t0:0.54,dur:0.10,fly:[5,0,0],spin:1.0}); /* outlet */

/* pressure gauge on the first horizontal run */
LAY=5;
add({cx:-5.5,cy:1.2,cz:0,sx:0.6,sy:0.6,sz:0.6,c:C.gauge,t0:0.58,dur:0.15,fly:[-4,-4,3],spin:0.8,stroke:false});
/* gauge needle - special handling */

/* wall backdrop */
LAY=0;
add({cx:0,cy:1.5,cz:0,sx:17,sy:2.8,sz:0.08,c:C.wall,t0:0.00,dur:0.08,fly:[0,-5,0],spin:0,alpha:1,stroke:false});

/* ===== render ===== */
var FACES=[[0,2,3,1],[4,5,7,6],[0,4,6,2],[1,3,7,5],[0,1,5,4],[2,6,7,3]];
var LX=0.42,LY=0.80,LZ=0.42;
function rotXv(p,a){var c=Math.cos(a),s=Math.sin(a);return [p[0],p[1]*c-p[2]*s,p[1]*s+p[2]*c];}
function rotAv(p,ax,a){var c=Math.cos(a),s=Math.sin(a),d=1-c,x=p[0],y=p[1],z=p[2],x0=ax[0],x1=ax[1],x2=ax[2];
 return [x*(x0*x0*d+c)+y*(x0*x1*d-x2*s)+z*(x0*x2*d+x1*s),
         x*(x1*x0*d+x2*s)+y*(x1*x1*d+c)+z*(x1*x2*d-x0*s),
         x*(x2*x0*d-x1*s)+y*(x2*x1*d+x0*s)+z*(x2*x2*d+c)];}

var smoothP=0,sP=-1,mx=0,my=0,tmx=0,tmy=0,curStage=-1;
var stgNum=document.getElementById('stgNum'),stgName=document.getElementById('stgName'),
    railFill=document.getElementById('railFill'),hint=document.getElementById('scrollHint'),
    heroCopy=document.getElementById('heroCopy');
var STAGES=[[0,'Supply line'],[0.10,'Horizontal run'],[0.18,'First elbow'],[0.30,'Vertical rise'],[0.35,'Second elbow'],[0.48,'Top horizontal'],[0.55,'Third elbow'],[0.65,'Vertical drop'],[0.75,'Outlet'],[0.85,'Gauge & flow']];

function draw(p){
  if(!isFinite(p))p=0;
  var AZC=-0.66+p*0.30+mx*0.045+azO;
  var ca=Math.cos(AZC),sa=Math.sin(AZC);
  var el=0.30+0.05*p-my*0.028,ce=Math.cos(el),se=Math.sin(el);
  var D=(W<640?26.5:33)*(1-0.10*p),f=1.55*Math.min(H,W*0.8),camY=4.35,yA=0.575;
  function proj(x,y,z){
    var xa=x*ca-z*sa,za=x*sa+z*ca,yy=y-camY;
    var vy=yy*ce+za*se,vz=-yy*se+za*ce+D,s=f/Math.max(6,vz);
    return {x:W/2+xa*s,y:H*yA-vy*s,s:s,vz:vz};
  }
  /* background */
  var g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,'#ffffff');g.addColorStop(.55,'#f8fafc');g.addColorStop(1,'#eef3f8');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  /* subtle grid */
  ctx.strokeStyle='rgba(0,51,102,.04)';ctx.lineWidth=1;
  var x,z,pa,pb;
  for(x=-12;x<=12;x+=2){pa=proj(x,0,-5);pb=proj(x,3,5);ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();}
  for(z=-4;z<=4;z+=2){pa=proj(-10,0,z);pb=proj(10,0,z);ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();}
  /* ground shadow */
  var c0=proj(0,0.01,0);
  if(c0.s>0){ctx.fillStyle='rgba(0,0,0,.10)';ctx.beginPath();ctx.ellipse(c0.x,c0.y,c0.s*9.2,c0.s*2.9,0,0,6.283);ctx.fill();}

  /* pieces */
  var faces=[];
  var i,j,o,q,sp;
  for(i=0;i<pieces.length;i++){
    o=pieces[i];
    q=EZ(CL((p-o.t0)/o.dur,0,1));
    if(q<=0)continue;
    sp=o.spin*(1-q);
    var k=1-q,ox=o.fly[0]*k,oy=o.fly[1]*k,oz=o.fly[2]*k;
    var vs=[];
    for(j=0;j<8;j++){
      var l=[o.sx*((j&1)?.5:-.5),o.sy*((j&2)?.5:-.5),o.sz*((j&4)?.5:-.5)];
      if(o.rot)l=rotXv(l,o.rot);
      if(sp>0.001)l=rotAv(l,o.axis,sp);
      var wx=o.cx+ox+l[0],wy=o.cy+oy+l[1],wz=o.cz+oz+l[2];
      var pr=proj(wx,wy,wz);
      if(!isFinite(pr.x)||!isFinite(pr.y)){vs=null;break;}
      vs.push({x:pr.x,y:pr.y,vz:pr.vz,wx:wx,wy:wy,wz:wz});
    }
    if(!vs)continue;
    for(j=0;j<6;j++){
      var fc=FACES[j],a=vs[fc[0]],b=vs[fc[1]],c=vs[fc[2]],d2=vs[fc[3]];
      var e1x=b.wx-a.wx,e1y=b.wy-a.wy,e1z=b.wz-a.wz,e2x=c.wx-a.wx,e2y=c.wy-a.wy,e2z=c.wz-a.wz;
      var nx=e1y*e2z-e1z*e2y,ny=e1z*e2x-e1x*e2z,nz=e1x*e2y-e1y*e2x;
      var nl=Math.sqrt(nx*nx+ny*ny+nz*nz)||1;nx/=nl;ny/=nl;nz/=nl;
      var lam=nx*LX+ny*LY+nz*LZ;if(lam<0){nx=-nx;ny=-ny;nz=-nz;lam=-lam;}
      var sh=0.40+0.60*Math.max(0,lam);
      faces.push({a:a,b:b,c:c,d:d2,z:(a.vz+b.vz+c.vz+d2.vz)*0.25,l:o.lay||0,o:o,sh:sh});
    }
  }
  faces.sort(function(p1,p2){var dq=p1.l-p2.l;return dq!==0?dq:(p2.z-p1.z);});
  var stOn=null;
  for(i=0;i<faces.length;i++){
    var F=faces[i],oo=F.o,r2=Math.round(oo.rgb[0]*F.sh),g2=Math.round(oo.rgb[1]*F.sh),b2=Math.round(oo.rgb[2]*F.sh);
    ctx.fillStyle='rgba('+r2+','+g2+','+b2+','+oo.alpha+')';
    ctx.beginPath();ctx.moveTo(F.a.x,F.a.y);ctx.lineTo(F.b.x,F.b.y);ctx.lineTo(F.c.x,F.c.y);ctx.lineTo(F.d.x,F.d.y);ctx.closePath();ctx.fill();
    if(oo.stroke&&oo.alpha>0.9){stOn=stOn||('rgba(0,51,102,.3)');ctx.strokeStyle=stOn;ctx.lineWidth=.7;ctx.stroke();}
  }

  /* --- GAUGE NEEDLE (overlay, screen-space) --- */
  if(p>0.58){
    var gaugeCenter=proj(-5.5,1.2,0);
    if(isFinite(gaugeCenter.x)&&isFinite(gaugeCenter.y)&&gaugeCenter.s>0){
      var r=gaugeCenter.s*0.28;
      var needleAngle=-Math.PI*0.75 + p*Math.PI*1.5; /* sweeps from -135° to +135° */
      if(reduce) needleAngle=Math.PI*0.25; /* settled at ~45° */
      var nx=gaugeCenter.x+Math.cos(needleAngle)*r*0.85;
      var ny=gaugeCenter.y+Math.sin(needleAngle)*r*0.85;
      ctx.strokeStyle='#00ffff';ctx.lineWidth=Math.max(2,r*0.08);ctx.lineCap='round';
      ctx.beginPath();ctx.moveTo(gaugeCenter.x,gaugeCenter.y);ctx.lineTo(nx,ny);ctx.stroke();
      /* gauge center dot */
      ctx.fillStyle='#00ffff';ctx.beginPath();ctx.arc(gaugeCenter.x,gaugeCenter.y,r*0.12,0,Math.PI*2);ctx.fill();
      /* gauge label */
      ctx.fillStyle='#003366';ctx.font='bold '+Math.max(10,r*0.25)+'px ui-monospace,Menlo,Consolas,monospace';ctx.textAlign='center';
      ctx.fillText('kPa',gaugeCenter.x,gaugeCenter.y+r*0.6);
    }
  }

  /* --- FLOW PULSE (travels along the pipe path) --- */
  if(p>0.85 && !reduce){
    var flowPhase=(p-0.85)*8; /* cycles */
    var flowPos=Math.sin(flowPhase)*0.5+0.5; /* 0..1 along path */
    /* simplified: draw a cyan pulse at a position along the main horizontal */
    var fx=-5.5+flowPos*4.0; /* along first horizontal */
    var fp=proj(fx,1.5,0);
    if(isFinite(fp.x)&&isFinite(fp.y)&&fp.s>0){
      var pr=fp.s*0.35;
      var rg=ctx.createRadialGradient(fp.x,fp.y,0,fp.x,fp.y,pr);
      rg.addColorStop(0,'rgba(0,255,255,0.8)');rg.addColorStop(1,'rgba(0,255,255,0)');
      ctx.fillStyle=rg;ctx.beginPath();ctx.arc(fp.x,fp.y,pr,0,Math.PI*2);ctx.fill();
    }
  }

  /* --- DROPLET at outlet --- */
  if(p>0.75){
    var dropY=1.5 - Math.min(1,(p-0.75)*4)*0.8; /* falls down */
    var dp=proj(6.5,dropY,0);
    if(isFinite(dp.x)&&isFinite(dp.y)&&dp.s>0){
      var dr=dp.s*0.25;
      ctx.fillStyle='#00ffff';
      ctx.beginPath();
      ctx.moveTo(dp.x,dp.y-dr*0.5);
      ctx.bezierCurveTo(dp.x-dr,dp.y-dr,dp.x-dr,dp.y+dr*0.5,dp.x,dp.y+dr);
      ctx.bezierCurveTo(dp.x+dr,dp.y+dr*0.5,dp.x+dr,dp.y-dr,dp.x,dp.y-dr*0.5);
      ctx.fill();
    }
  }

  /* vignette */
  var vg=ctx.createRadialGradient(W/2,H*0.52,Math.min(W,H)*0.32,W/2,H*0.52,Math.max(W,H)*0.78);
  vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.18)');
  ctx.fillStyle=vg;ctx.fillRect(0,0,W,H);

  /* hud */
  var sI=0;
  for(i=0;i<STAGES.length;i++){if(p>=STAGES[i][0])sI=i;}
  if(sI!==curStage&&stgNum){
    curStage=sI;
    stgNum.textContent=(sI<10?'0':'')+sI;
    stgName.textContent=STAGES[sI][1];
  }
  if(railFill)railFill.style.height=(p*100).toFixed(1)+'%';
  if(heroCopy){var ho=reduce?1:CL(1-p*5.2,0,1);heroCopy.style.opacity=ho;heroCopy.style.transform='translateY('+(p*40)+'px)';}
  if(hint)hint.style.opacity=reduce?0:CL(1-p*8,0,1);
  if(DBG){
    var out=[],side,ii,jj;
    for(side=0;side<2;side++){
      for(ii=0;ii<11;ii++){
        var sx2=-7+ii*1.4;
        for(jj=1;jj<6;jj++){
          var tz2=jj/6.5;
          var zz2=side?(-4.9+tz2*4.75):(4.9-tz2*4.75);
          var q3=proj(sx2,1.5,zz2);
          var rx2=Math.round(q3.x),ry2=Math.round(q3.y);
          if(rx2>0&&ry2>0&&rx2<W&&ry2<H){
            var dtx=ctx.getImageData(rx2,ry2,1,1).data;
            var lum=(dtx[0]+dtx[1]+dtx[2])/3;
            if(lum>92)out.push((side?'R':'L')+ii+''+jj);
          }
        }
      }
    }
    document.title='BRIGHT:'+(out.length?out.join(','):'none');
  }
}
window.__buildTo=function(x){draw(CL(+x||0,0,1));};

function animate(ts){
  if(!isFinite(ts))ts=0;
  var rect=wrap.getBoundingClientRect();
  var span=wrap.offsetHeight-sticky.offsetHeight;
  var p=CL(-rect.top/Math.max(1,span),0,1);
  smoothP+=(p-smoothP)*0.10;
  if(Math.abs(smoothP-p)<0.0004)smoothP=p;
  mx+=(tmx-mx)*0.06;my+=(tmy-my)*0.06;
  draw(smoothP);
  requestAnimationFrame(animate);
}
window.addEventListener('pointermove',function(e){tmx=(e.clientX/window.innerWidth)*2-1;tmy=(e.clientY/window.innerHeight)*2-1;},{passive:true});

resize();
window.addEventListener('resize',function(){resize();if(forceP!=null||reduce)draw(forceP!=null?CL(parseFloat(forceP)||0,0,1):1);});
if(forceP!=null){draw(CL(parseFloat(forceP)||0,0,1));}
else if(reduce){draw(1);}
else{requestAnimationFrame(animate);} /* <-- REQUIRED: start rAF via requestAnimationFrame(animate) */
})();

/* ===== pressure gauge detail canvas ===== */
(function(){
  var c=document.getElementById('gaugeCanvas');if(!c)return;
  var x=c.getContext('2d'),w=c.width,h=c.height;
  x.clearRect(0,0,w,h);
  x.lineCap='round';
  var cx=w/2,cy=h/2,r=Math.min(w,h)*0.38;
  /* gauge face */
  var g=x.createRadialGradient(cx,cy,r*0.1,cx,cy,r);
  g.addColorStop(0,'#f8fafc');g.addColorStop(1,'#eef3f8');
  x.fillStyle=g;x.beginPath();x.arc(cx,cy,r,0,Math.PI*2);x.fill();
  x.strokeStyle='#003366';x.lineWidth=3;x.beginPath();x.arc(cx,cy,r,0,Math.PI*2);x.stroke();
  /* ticks */
  x.strokeStyle='#003366';x.lineWidth=2;
  for(var i=0;i<=10;i++){
    var a=-Math.PI*0.75+i*Math.PI*1.5/10;
    var r1=r*0.85,r2=r*0.95;
    if(i%5===0){r1=r*0.78;x.lineWidth=3;}
    x.beginPath();x.moveTo(cx+Math.cos(a)*r1,cy+Math.sin(a)*r1);x.lineTo(cx+Math.cos(a)*r2,cy+Math.sin(a)*r2);x.stroke();
    x.lineWidth=2;
  }
  /* needle at 500 kPa (~45°) */
  var needleA=Math.PI*0.25;
  x.strokeStyle='#00ffff';x.lineWidth=3;
  x.beginPath();x.moveTo(cx,cy);x.lineTo(cx+Math.cos(needleA)*r*0.78,cy+Math.sin(needleA)*r*0.78);x.stroke();
  x.fillStyle='#00ffff';x.beginPath();x.arc(cx,cy,6,0,Math.PI*2);x.fill();
  /* label */
  x.fillStyle='#003366';x.font='bold 16px ui-monospace,Menlo,Consolas,monospace';x.textAlign='center';
  x.fillText('500 kPa',cx,cy+r*0.45);
  x.font='11px ui-monospace,Menlo,Consolas,monospace';
  x.fillText('TEST PRESSURE',cx,cy+r*0.65);
})();

/* ===== reveals + year ===== */
(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200); /* ~1200ms safety net */
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
