  <!-- JavaScript: IntersectionObserver reveal + safety net -->
  <script>
    (function() {
      'use strict';
      
      // Mark JS as loaded for CSS reveal
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      
      // IntersectionObserver reveal
      var revealElements = document.querySelectorAll('.rv');
      
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('on');
              observer.unobserve(entry.target);
            }
          });
        }, {
          rootMargin: '0px 0px -10% 0px',
          threshold: 0.1
        });
        
        revealElements.forEach(function(el) { observer.observe(el); });
      } else {
        // Fallback for browsers without IntersectionObserver
        revealElements.forEach(function(el) { el.classList.add('on'); });
      }
      
      // Safety net: force-reveal all after ~1100ms
      setTimeout(function() {
        revealElements.forEach(function(el) { el.classList.add('on'); });
      }, 1100);
      
      // Pause decorative hero SVG when reduced motion is preferred
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var cone = document.querySelector('.hero-cone');
        if (cone && cone.pauseAnimations) cone.pauseAnimations();
      }
    })();
  </script>
</body>
</html>