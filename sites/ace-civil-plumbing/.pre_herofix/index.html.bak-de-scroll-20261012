    vh.addColorStop(0, 'rgba(244,226,214,.34)'); vh.addColorStop(1, 'rgba(244,226,214,0)');
    ctx.fillStyle = vh; ctx.fillRect(0, S.horizon - S.H * 0.014, W, S.H * 0.08);
