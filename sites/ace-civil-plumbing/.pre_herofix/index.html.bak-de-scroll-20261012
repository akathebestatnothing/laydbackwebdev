    ag.addColorStop(0, 'rgba(255,214,182,.75)'); ag.addColorStop(0.2, 'rgba(255,185,138,.30)');
    ag.addColorStop(1, 'rgba(255,150,110,0)');
    ctx.fillStyle = ag; ctx.fillRect(0, 0, W, S.horizon + 40);
    ctx.fillStyle = 'rgba(255,236,214,.92)';
    ctx.beginPath(); ctx.arc(sunX, sunY, Math.max(10, S.H * 0.02), 0, 6.2832); ctx.fill();
    treeLine(86, 0.02, 3.2, PS.mix(S.skyCols[2], '#5a6a7c', 0.42), 0.26);
    treeLine(56, 0.01, 2.6, PS.mix(S.skyCols[2], '#2c3b4c', 0.55), 0.42);
