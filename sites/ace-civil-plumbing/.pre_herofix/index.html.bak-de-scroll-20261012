    gg.addColorStop(1, DIRT_D);
    ctx.fillStyle = gg; ctx.fillRect(0, gF[1] - 1, W, gN[1] - gF[1] + 2);
    /* mist band lying low over the ground (dawn-cool) */
    var mb = ctx.createLinearGradient(0, S.horizon + S.H * 0.012, 0, S.horizon + S.H * 0.16);
    mb.addColorStop(0, 'rgba(238,226,220,.20)'); mb.addColorStop(0.55, 'rgba(236,222,216,.11)');
    mb.addColorStop(1, 'rgba(238,226,220,0)');
    ctx.fillStyle = mb; ctx.fillRect(0, S.horizon + S.H * 0.012, W, S.H * 0.15);
