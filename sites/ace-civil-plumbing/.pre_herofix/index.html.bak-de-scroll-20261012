    S.castShadow(xs, zs, 1.0, 0.95, 2.4, .16);
  }

  function drawSetout(p, cutX) {
    var ctx = S.ctx, fade = PS.clamp(1 - (p - 0.9) / 0.08, 0, 1);
    if (fade <= 0.01) return;
    var pegs = [-9, -6, -3, 0, 3, 6, 9], i, x;
    for (i = 0; i < pegs.length; i++) {
      for (var side = 0; side < 2; side++) {
        x = pegs[i];
        var z = side ? ZL1 + 0.35 : ZL0 - 0.35;
        var b = pr(x, 0, z), s = S.focal / z, hh = 0.45 * s * 0.30;
        S.shadow(x, z, 0.16, 0.10, .22 * fade);
        S.poly([[b[0] - 0.045 * s * 0.30, b[1]], [b[0] + 0.045 * s * 0.30, b[1]],
                [b[0] + 0.045 * s * 0.30, b[1] - hh], [b[0] - 0.045 * s * 0.30, b[1] - hh]],
               PS.rgba(TIMB, 0.92 * fade));
