        ctx.beginPath(); ctx.moveTo(a2[0], a2[1]); ctx.lineTo(b2[0], b2[1]); ctx.stroke();
      }
    }
  }

  function drawCompactor(cx, time) {
    var ctx = S.ctx, jx = Math.sin(time * 0.045) * 0.012, jy = Math.sin(time * 0.062) * 0.008;
    var x = cx + jx, z0 = 6.95, z1 = 7.55;
