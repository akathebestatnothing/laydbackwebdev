    ctx.strokeStyle = '#2c3238'; ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(h1[0], h1[1]); ctx.lineTo(h2[0], h2[1]); ctx.stroke();
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(h2[0], h2[1]); ctx.lineTo(h3[0], h3[1]); ctx.stroke();
    /* dust kicked around the plate */
    for (var k = 0; k < 6; k++) {
      var ph = (time * 0.0012 + k * 0.37) % 1;
