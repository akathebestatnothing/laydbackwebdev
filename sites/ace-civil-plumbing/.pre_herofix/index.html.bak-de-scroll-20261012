  }

  function env(time) {
    var ctx = S.ctx, W = S.W;
    S.sky(0);
    var sg = ctx.createLinearGradient(0, 0, 0, S.horizon + 8);
    sg.addColorStop(0, '#0d1f33'); sg.addColorStop(0.45, '#33546f'); sg.addColorStop(0.72, '#46688a');
    sg.addColorStop(0.9, '#9c7a6c'); sg.addColorStop(1, '#c98f7a');
