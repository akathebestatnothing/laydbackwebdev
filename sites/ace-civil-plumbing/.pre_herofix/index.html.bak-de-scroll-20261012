  /* =============== SUBJECT - trench + pipelay =============== */
  function drawPipeBar(xa, xb, yc, z, r, ring, bottomY) {
    var ctx = S.ctx;
    var yT = yc + r, yB = (bottomY !== undefined && bottomY > yc - r) ? bottomY : yc - r;
    var zF = z - r, zB = z + r;
    var top = [pr(xa, yT, zF), pr(xb, yT, zF), pr(xb, yT, zB), pr(xa, yT, zB)];
    S.poly(top, PIPE_TOP, null, 1);
    var fr = [pr(xa, yT, zF), pr(xb, yT, zF), pr(xb, yB, zF), pr(xa, yB, zF)];
    var g = ctx.createLinearGradient(0, fr[0][1], 0, fr[3][1]);
    g.addColorStop(0, PIPE_FRONT[0]); g.addColorStop(0.45, PIPE_FRONT[1]); g.addColorStop(1, PIPE_FRONT[2]);
    S.poly(fr, g, null, 1);
    S.rim(top[0], top[1], 'rgba(255,216,172,.55)', 0.55, 1.6);
    if (ring) {
      var r2 = r + 0.06, yTR = yc + r2, yBR = Math.max(yc - r2, yB);
      var zFR = z - r2, zBR = z + r2;
      var rt = [pr(xa - 0.02, yTR, zFR), pr(xa + 0.20, yTR, zFR), pr(xa + 0.20, yTR, zBR), pr(xa - 0.02, yTR, zBR)];
      S.poly(rt, '#98a2ab', null, 1);
      var rf = [pr(xa - 0.02, yTR, zFR), pr(xa + 0.20, yTR, zFR), pr(xa + 0.20, yBR, zFR), pr(xa - 0.02, yBR, zFR)];
      S.poly(rf, '#828c96', 'rgba(40,46,54,.6)', 1, 1);
      S.rim(rf[0], rf[3], 'rgba(255,216,172,.5)', 0.5, 1.4);
      S.rim(pr(xa + 0.24, yT, zF), pr(xa + 0.24, yB, zF), 'rgba(30,34,40,.45)', 0.5, 1.2);
    }
  }

  function fillLevelAt(xc) {
    for (var j = 3; j >= 0; j--) { if (fillEdgeX[j] >= xc - 0.001) return FILL_LV[j]; }
    return FLOORY;
  }

  function drawSegment(i, p, time) {
    var ctx = S.ctx;
    var s0 = 0.38 + i * 0.047;
    var k1 = PS.stage(p, s0, 0.058, 'place');
    if (k1 <= 0) return;
    var k2 = PS.stage(p, s0 + 0.05, 0.055, 'settle');
    var xa = SEGX0 + i * SEGL, xb = xa + SEGL, xc = (xa + xb) / 2;
    var yc = PY + (1.6 - PY) * (1 - k1);
    var xoff = 0.55 * (1 - k2);
    xa += xoff; xb += xoff; xc += xoff;
    var bottom = -1.05, landed = k1 >= 1;
    if (landed) {
      bottom = Math.max(bottom, fillLevelAt(xc));
      if (bottom >= PTOP - 0.02) return;         /* buried by backfill: nothing to see */
      Tshadow(xc, PZ + 0.02, 0.46, 0.30);
    } else {
      Tshadow(xc, PZ + 0.05, 0.52 - 0.12 * k1, 0.08 + 0.30 * k1);
    }
    drawPipeBar(xa, xb, yc, PZ, PR, i > 0, landed ? bottom : undefined);
    var u = (p - (s0 + 0.058)) / 0.06;             /* landing dust */
    if (u > 0 && u < 1) {
      var cdp = pr(xc, FLOORY + 0.1, PZ), sc = S.focal / PZ;
      for (var j = 0; j < 7; j++) {
        var ang = j * 0.9 + i, rad = (0.15 + 0.55 * u) * sc;
        ctx.globalAlpha = (1 - u) * 0.30;
        ctx.fillStyle = j % 3 === 0 ? SAND : '#6b5a44';
        ctx.beginPath();
        ctx.arc(cdp[0] + Math.cos(ang) * rad * 0.55, cdp[1] + 3 - Math.sin(ang) * rad * 0.28 - u * 12,
                1.1 + (j % 2), 0, 6.2832);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }
  }

  function drawSpoil(cutX, time) {
    var ctx = S.ctx;
    var spoilEnd = Math.min(X_T, cutX);
    if (spoilEnd <= -X_T + 0.4) return;
    var ptsFar = [], ptsNear = [], leafy = [];
    for (var xs = -X_T; xs <= spoilEnd + 0.01; xs += 0.7) {
      var h = 0.12 + 0.10 * Math.sin(xs * 1.1) + 0.06 * Math.sin(xs * 2.7 + 1.3);
      var d = Math.max(0, xs - (cutX - 1.6));
      h += Math.min(0.28, 0.16 * d) * (cutX < X_T - 0.2 ? 1 : 0);
      leafy.push([xs, 0.12 + h * 0.55]);
    }
    var i;
    for (i = 0; i < leafy.length; i++) ptsFar.push(pr(leafy[i][0], leafy[i][1], 4.7));
    for (i = leafy.length - 1; i >= 0; i--) ptsFar.push(pr(leafy[i][0], 0, 5.45));
    for (i = 0; i < leafy.length; i++) ptsNear.push(pr(leafy[i][0], leafy[i][1], 4.7));
    for (i = leafy.length - 1; i >= 0; i--) ptsNear.push(pr(leafy[i][0], 0, 4.15));
    S.shadow((spoilEnd - X_T) / 2, 4.8, 9.2, 0.95, .20);
    S.poly(ptsFar, PS.mix(DIRT_D, '#000', 0.25), null, 1);
    var g = ctx.createLinearGradient(0, pr(0, 0.4, 4.7)[1], 0, pr(0, 0, 4.15)[1]);
    g.addColorStop(0, PS.mix(DIRT, '#8a6a42', 0.30)); g.addColorStop(1, PS.darken(DIRT, 0.30));
    S.poly(ptsNear, g, null, 1);
    S.texture(ptsNear, 'grain', 150, .05);
    var crest = [];
    for (i = 0; i < leafy.length; i++) crest.push(pr(leafy[i][0], leafy[i][1], 4.7));
    for (i = 0; i + 1 < crest.length; i += 2) {
      S.rim(crest[i], crest[i + 1], 'rgba(255,205,160,.5)', 0.5, 1.5);
    }
    for (i = 2; i < crest.length - 1; i += 3) {           /* clods on the crest */
      ctx.fillStyle = 'rgba(70,56,38,.6)';
      ctx.beginPath(); ctx.arc(crest[i][0], crest[i][1] + 1, 2.2 + (i % 3), 0, 6.2832); ctx.fill();
    }
    S.castShadow((spoilEnd - X_T) / 2, 4.8, 7.5, 0.4, 2.6, .13);
  }

  function drawStack(n, time) {
    if (n <= 0) return;
    var ctx = S.ctx, xs = -7.9, zs = 4.85, sl = 1.9;
    S.shadow(xs, zs, 1.5, 0.75, .32);
