  }

  function drawSubject(p, time) {
    var ctx = S.ctx;
    var tCut = PS.stage(p, 0.00, 0.22, 'place');
    var tSand = PS.stage(p, 0.20, 0.20, 'place');
    var tFill = PS.stage(p, 0.68, 0.22, 'place');
    var tComp = PS.stage(p, 0.88, 0.11, 'place');
    var cutX = -X_T + 2 * X_T * tCut;
    var sandEdge = -X_T + 2 * X_T * tSand;
    var compX = -8 + 18 * tComp;
    var nLip = pr(0, 0, ZL0)[1];
    var i, j;

    /* ---- trench interior (clipped so nothing paints over the near ground) ---- */
    ctx.save();
    ctx.beginPath(); ctx.rect(-40, -40, S.W + 80, nLip + 40); ctx.clip();

    /* void under everything */
    S.poly([pr(-X_T, 0, ZL0), pr(X_T, 0, ZL0), pr(X_T, 0, ZL1), pr(-X_T, 0, ZL1)], DIRT_VOID, null, 1);

    /* far wall (battered): lip at ZL1, base at ZB1 */
    var fwT1 = pr(-X_T, 0, ZL1), fwT2 = pr(X_T, 0, ZL1), fwB2 = pr(X_T, -DEPTH, ZB1), fwB1 = pr(-X_T, -DEPTH, ZB1);
    var fwg = ctx.createLinearGradient(0, fwT1[1], 0, fwB1[1]);
    fwg.addColorStop(0, PS.mix(DIRT, '#8a6c4e', 0.38));
    fwg.addColorStop(0.55, PS.mix(DIRT, '#5c442c', 0.25));
    fwg.addColorStop(1, PS.darken(DIRT_D, 0.15));
    S.poly([fwT1, fwT2, fwB2, fwB1], fwg, null, 1);
    S.mottle([fwT1, fwT2, fwB2, fwB1], '#5c4a34', .12, 20);
    S.texture([fwT1, fwT2, fwB2, fwB1], 'streak', 260, .05);
    for (i = 0; i < 3; i++) {                                 /* strata */
      var ly = -0.3 - i * 0.3, lz = ZL1 + ly;
      S.rim(pr(-X_T, ly, lz), pr(X_T, ly, lz), 'rgba(24,17,10,.35)', 0.5, 1.4);
      S.rim(pr(-X_T, ly + 0.045, lz + 0.045), pr(X_T, ly + 0.045, lz + 0.045), 'rgba(255,224,186,.10)', 0.5, 1.1);
    }
    for (i = 0; i < 5; i++) {                                 /* tooling marks */
      var mx = -7 + i * 3.4, my1 = -0.15 - (i % 3) * 0.28;
      S.rim(pr(mx, my1, ZL1 + my1), pr(mx + 0.35, my1 - 0.3, ZL1 + my1 - 0.3), 'rgba(26,18,10,.28)', 0.5, 1.2);
    }
    S.rim(fwT1, fwT2, 'rgba(255,220,180,.55)', 0.5, 1.6);      /* far lip catching dawn light */

    /* trench floor */
    var fl = [pr(-X_T, FLOORY, ZB0 + 0.1), pr(X_T, FLOORY, ZB0 + 0.1), pr(X_T, FLOORY, ZB1 - 0.05), pr(-X_T, FLOORY, ZB1 - 0.05)];
    var flg = ctx.createLinearGradient(0, fl[3][1], 0, fl[0][1]);
    flg.addColorStop(0, PS.mix(DIRT_D, '#3a2e1e', 0.4)); flg.addColorStop(1, '#1b150e');
    S.poly(fl, flg, null, 1);
    S.mottle(fl, '#2e2517', .10, 12);
    S.texture(fl, 'grain', 220, .05);

    /* bedding sand (revealed left -> right) */
    if (tSand > 0.002) {
      ctx.save();
      if (tSand < 0.999) {
        var sxs = pr(sandEdge, -1.2, 9.4)[0];
        ctx.beginPath(); ctx.rect(-40, -40, sxs + 40, nLip + 40); ctx.clip();
      }
      var sq = [pr(-X_T, BEDY, ZB0 + 0.1), pr(X_T, BEDY, ZB0 + 0.1), pr(X_T, BEDY, ZB1 - 0.05), pr(-X_T, BEDY, ZB1 - 0.05)];
      var sdg = ctx.createLinearGradient(0, sq[3][1], 0, sq[0][1]);
      sdg.addColorStop(0, PS.mix(SAND, '#ffd9a0', 0.30)); sdg.addColorStop(1, PS.mix(SAND_D, '#000', 0.12));
      S.poly(sq, sdg, null, 1);
      S.mottle(sq, SAND, .13, 18);
      S.texture(sq, 'grain', 240, .07);
      ctx.restore();
      if (tSand < 0.999) {
        var e1 = pr(sandEdge, BEDY, ZB0 + 0.15), e2 = pr(sandEdge, BEDY, ZB1 - 0.1);
        S.rim(e1, e2, 'rgba(190,150,90,.65)', 0.6, 2);
        for (i = 0; i < 4; i++) {
          var cl = pr(sandEdge + 0.25 + i * 0.22, BEDY + 0.03, 8.6 + (i % 3) * 0.6);
          ctx.fillStyle = 'rgba(200,164,100,.6)';
          ctx.beginPath(); ctx.arc(cl[0], cl[1], 1.8 + (i % 2), 0, 6.2832); ctx.fill();
        }
      }
    }

    /* backfill layers (staggered left -> right) */
    for (j = 0; j < 4; j++) {
      var fj = PS.clamp(tFill * 4.6 - j, 0, 1);
      fillEdgeX[j] = fj > 0 ? (-X_T + 2 * X_T * fj) : -999;
      if (fj <= 0) continue;
      var L = FILL_LV[j];
      var xe = fillEdgeX[j];
      var xes = pr(xe, 0, 9.4)[0];
      var zn = ZL0 + 0.1, zf = ZL1 - 0.1;
      var lq = [pr(-X_T, L, zn), pr(X_T, L, zn), pr(X_T, L, zf), pr(-X_T, L, zf)];
      ctx.save();
      ctx.beginPath(); ctx.rect(-40, -40, xes + 40, nLip + 40); ctx.clip();
      var lg = ctx.createLinearGradient(0, lq[3][1], 0, lq[0][1]);
      lg.addColorStop(0, PS.mix(FILL_C[j], '#c98f7a', 0.10));
      lg.addColorStop(1, PS.darken(FILL_C[j], 0.22));
      S.poly(lq, lg, null, 1);
      S.mottle(lq, FILL_C[j], .10, 16);
      S.texture(lq, 'grain', 240, .05);
      S.rim(pr(-X_T, L, zf), pr(Math.min(xe, X_T), L, zf), 'rgba(30,22,14,.35)', 0.4, 1.3);
      if (fj < 0.99) {
        var fq = [pr(xe, L, zn), pr(xe, L, zf), pr(xe, L - 0.30, zf), pr(xe, L - 0.30, zn)];
        S.poly(fq, PS.darken(FILL_C[j], 0.32), null, 1);
        S.rim(fq[0], fq[1], 'rgba(255,210,170,.35)', 0.45, 1.2);
        for (i = 0; i < 4; i++) {
          var cd2 = pr(xe + 0.2 + i * 0.2, L - 0.04, 8.4 + (i % 3) * 0.55);
          ctx.fillStyle = 'rgba(96,78,54,.6)';
          ctx.beginPath(); ctx.arc(cd2[0], cd2[1], 2 + (i % 2), 0, 6.2832); ctx.fill();
        }
        var dp = pr(xe, L + 0.45, 8.8);
        for (i = 0; i < 5; i++) {
          ctx.globalAlpha = 0.09 + 0.09 * Math.abs(Math.sin(time * 0.002 + i + j));
          ctx.fillStyle = '#cbb89a';
          ctx.beginPath();
          ctx.arc(dp[0] - i * 7 + Math.sin(time * 0.003 + i) * 5, dp[1] - i * 9 - ((time * 0.012) % 26),
                  2.2 + (i % 3), 0, 6.2832);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      }
      ctx.restore();
    }

    /* pipe segments - descend, then slide into the socket one by one */
    for (i = 0; i < SEGN; i++) drawSegment(i, p, time);

    /* inner shadow under the near lip + lit lip edge */
    var ish = ctx.createLinearGradient(0, nLip - S.H * 0.05, 0, nLip);
    ish.addColorStop(0, 'rgba(6,7,9,0)'); ish.addColorStop(1, 'rgba(6,7,9,.30)');
    ctx.fillStyle = ish; ctx.fillRect(0, nLip - S.H * 0.05, S.W, S.H * 0.05);
    ctx.restore();

    var lgrad = ctx.createLinearGradient(0, 0, S.W, 0);
    lgrad.addColorStop(0, 'rgba(255,222,186,.55)'); lgrad.addColorStop(0.55, 'rgba(255,222,186,.30)');
    lgrad.addColorStop(1, 'rgba(255,222,186,.22)');
    ctx.strokeStyle = lgrad; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(0, nLip); ctx.lineTo(S.W, nLip); ctx.stroke();

    /* ---- foreground + grade-level objects ---- */
    drawSpoil(cutX, time);
    var laid = 0;
    for (i = 0; i < SEGN; i++) { if (PS.stage(p, 0.38 + i * 0.047, 0.058, 'place') >= 1) laid++; }
    drawStack(Math.max(0, 4 - Math.min(4, laid)), time);
    drawSetout(p, cutX);
    S.scaleCue(-8.6, 5.05, 'cone');

    /* reinstated surface closing behind the compactor */
    var stripEdge = compX - 0.7;
    if (tComp > 0.002) {
      var ses = pr(stripEdge, 0, 9.4)[0];
      if (ses > 0) {
        ctx.save();
        ctx.beginPath(); ctx.rect(-40, -40, ses + 40, nLip + 40); ctx.clip();
        var rq = [pr(-X_T + 0.08, 0.004, ZL0 + 0.1), pr(X_T - 0.08, 0.004, ZL0 + 0.1),
                  pr(X_T - 0.08, 0.004, ZL1 - 0.1), pr(-X_T + 0.08, 0.004, ZL1 - 0.1)];
        var rg2 = ctx.createLinearGradient(0, rq[3][1], 0, rq[0][1]);
        rg2.addColorStop(0, PS.mix(GRAVEL, '#d9a284', 0.14)); rg2.addColorStop(1, PS.mix(GRAVEL, '#241d14', 0.35));
        S.poly(rq, rg2, null, 1);
        S.mottle(rq, GRAVEL, .12, 16);
        S.texture(rq, 'aggregate', 300, .07);
        ctx.restore();
        S.rim(pr(-X_T + 0.08, 0.012, ZL0 + 0.1), pr(stripEdge, 0.012, ZL0 + 0.1), 'rgba(28,22,15,.4)', 0.5, 1.4);
        S.rim(pr(stripEdge, 0.004, ZL0 + 0.1), pr(stripEdge, 0.004, ZL1 - 0.1), 'rgba(255,222,186,.30)', 0.5, 1.4);
      }
    }
    if (tComp > 0.01 && tComp < 0.995) drawCompactor(compX, time);
  }

  /* ---------- grade (always last before the HUD) ---------- */
  function grade(time) {
    var ctx = S.ctx;
    var rg = ctx.createLinearGradient(0, 0, S.W, S.H);
    rg.addColorStop(0, 'rgba(255,185,138,.06)'); rg.addColorStop(0.5, 'rgba(255,185,138,0)');
    rg.addColorStop(1, 'rgba(50,80,120,.06)');
    ctx.fillStyle = rg; ctx.fillRect(0, 0, S.W, S.H);
    S.dust(30, time);
    S.grade();
  }

  function frame(S_, p, time) {
    S = S_;
    env(time);
    var dx = Math.sin(time * 0.00005) * 5 + (p - 0.5) * -12;
    S.ctx.save(); S.ctx.translate(dx, 0);
    drawSubject(p, time);
    S.ctx.restore();
    grade(time);
    var idx = p < 0.26 ? 0 : p < 0.48 ? 1 : p < 0.72 ? 2 : 3;
    if (stgNum) stgNum.textContent = '0' + (idx + 1);
    if (stgName) stgName.textContent = NAMES[idx];
    if (railFill) railFill.style.height = (p * 100).toFixed(1) + '%';
    if (heroCopy) {
      heroCopy.style.opacity = S.reduce ? 1 : PS.clamp(1 - p * 4.8, 0, 1);
      heroCopy.style.transform = 'translateY(' + (p * 35) + 'px)';
    }
    if (hint) hint.style.opacity = S.reduce ? 0 : String(PS.clamp(1 - p * 7, 0, 1));
  }

  window.__buildTo = function (x) { S.drawOnce(PS.clamp(+x || 0, 0, 1), 0); };
  S.start();
})();

</script>
<script>
/* ---- page glue (reveal + nav) preserved through the scene retrofit ---- */
(function(){var rvs=[].slice.call(document.querySelectorAll('.rv'));
if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting){en.target.classList.add('on');io.unobserve(en.target);}});},{rootMargin:'0px 0px -12% 0px',threshold:0.08});rvs.forEach(function(el){io.observe(el);});}else{rvs.forEach(function(el){el.classList.add('on');});}
setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200);
var b=document.getElementById('burger'),n=document.getElementById('navlinks');if(b&&n){b.addEventListener('click',function(){var o=n.classList.toggle('open');b.setAttribute('aria-expanded',o?'true':'false');});n.addEventListener('click',function(e){if(e.target.tagName==='A')n.classList.remove('open');});}var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();})();
</script>

