    S.poly([pr(x - 0.38, 0.52, z0), pr(x + 0.38, 0.52, z0), pr(x + 0.38, 0.52, z1), pr(x - 0.38, 0.52, z1)],
           '#b98d3f', null, 1);
    S.rim(pr(x - 0.38, 0.52, z0), pr(x + 0.38, 0.52, z0), 'rgba(255,214,170,.55)', 0.6, 1.6);
    /* handle + grip */
