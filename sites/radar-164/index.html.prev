    <li><a href="#services">Services</a></li>
    <li><a href="#process">Process</a></li>
    <li><a href="#faq">FAQ</a></li>
    <li><a href="#work">Work</a></li>
    <li><a href="#quote">Quote</a></li>
  </ul>
  <div class="nav__cta">
    <span class="mono nav__p">0488 237 917</span>
    <a class="btn btn--p" href="#quote">Get a quote</a>
  </div>
</nav>

<header id="top">
<div id="sceneWrap" aria-label="Scroll to watch the excavator dig">
  <div id="sceneSticky">
    <canvas id="digCanvas" aria-hidden="true"></canvas>

    <div class="hero-copy" id="heroCopy">
      <p class="k"><i></i>Earthworks &amp; property maintenance · Gippsland, VIC</p>
      <h1>Ground work, <em>done properly</em>.</h1>
      <p class="d">Tight-access excavation, drainage, trenching, driveways, land clearing and retaining walls across Gippsland. One operator for the cut, the drainage and the finished levels.</p>
      <div class="cta">
        <a class="btn btn--p" href="#quote">Get a free quote</a>
        <a class="btn btn--o" href="tel:+61488237917" aria-label="Call 0488 237 917">Call 0488 237 917</a>
      </div>
      <div class="strip">
        <p><b>Owner operated</b>Steve, on the tools</p>
        <p><b>Tight access</b>2.6T machine</p>
        <p><b>Gippsland</b>local &amp; insured</p>
      </div>
    </div>

    <div class="hud" aria-hidden="true">
      <div class="stg"><b id="stgNum">00</b><span id="stgName">On site</span></div>
      <div class="rail"><i id="railFill"></i></div>
      <div class="scroll-hint" id="scrollHint">Scroll · the machine digs</div>
    </div>
  </div>
</div>
</header>

<section class="sec" id="services">
  <div class="sec-head rv"><span class="sec-idx">01</span><div><h2 class="sec-title">What we do.</h2><p class="lead">One operator for the cut, the drainage and the finished levels, so the site is left ready for what comes next.</p></div></div>
  <div class="svc-grid">
    <article class="svc rv"><span class="n">01</span><div><h3>Tight-access excavation</h3><p>Excavation with a compact 2.6T machine where a full-size digger will not fit: tight blocks and backyards.</p></div></article>
    <article class="svc rv"><span class="n">02</span><div><h3>Drainage &amp; trenching</h3><p>Surface and sub-surface drainage, agi lines and trenching cut to the right falls.</p></div></article>
    <article class="svc rv"><span class="n">03</span><div><h3>Driveways &amp; site cuts</h3><p>Driveway cuts, site levelling and bulk earthworks graded to the plan.</p></div></article>
    <article class="svc rv"><span class="n">04</span><div><h3>Land clearing &amp; retaining</h3><p>Land clearing, retaining walls and property maintenance that finishes the job.</p></div></article>
  </div>
</section>

<section class="sec sec--tint" id="process">
  <div class="sec-head rv"><span class="sec-idx">02</span><div><h2 class="sec-title">How a job runs.</h2></div></div>
  <div class="steps">
    <div class="step rv"><b>01</b><h3>Site visit &amp; scope</h3><p>Access, levels and soil checked. The job defined before any machinery moves.</p></div>
    <div class="step rv"><b>02</b><h3>Firm quote</h3><p>Bulk, hours and finish priced in writing.</p></div>
    <div class="step rv"><b>03</b><h3>Excavate &amp; prepare</h3><p>Cut, trench, drain, compact: a level, sound base for what comes next.</p></div>
    <div class="step rv"><b>04</b><h3>Finish &amp; clean up</h3><p>Final grade, finished levels, site left clean.</p></div>
  </div>
</section>

<section class="sec" id="faq">
  <div class="sec-head rv"><span class="sec-idx">03</span><div><h2 class="sec-title">Asked on every site.</h2></div></div>
  <div class="faq">
  <details class="faq rv"><summary>Do you handle tight-access jobs?</summary><div class="a">Yes. A compact 2.6T machine that gets into tight blocks and backyards a full-size digger cannot reach.</div></details>
  <details class="faq rv"><summary>Are you licensed and insured?</summary><div class="a">Yes. Owner operated and fully insured.</div></details>
  <details class="faq rv"><summary>Which areas do you cover?</summary><div class="a">Gippsland and surrounding areas, VIC.</div></details>
  <details class="faq rv"><summary>Do you quote before starting?</summary><div class="a">Always. A firm written quote before any work starts.</div></details>
  </div>
</section>

<section class="sec--tint" aria-label="At a glance">
  <div class="band rv">
    <div class="b-i"><b>Owner operated</b><span>Steve, on the tools</span></div>
    <div class="b-i"><b>2.6T machine</b><span>tight-access ready</span></div>
    <div class="b-i"><b>Drainage</b><span>&amp; trenching</span></div>
    <div class="b-i"><b>Gippsland</b><span>local operator</span></div>
  </div>
</section>

<section class="sec" id="work">
  <div class="sec-head rv"><span class="sec-idx">04</span><div><h2 class="sec-title">On site.</h2><p class="lead">Recent jobs from around Gippsland.</p></div></div>
  <div class="gal">
    <figure class="rv"><img src="assets/gal_1.jpg" alt="Excavator and retaining wall" loading="lazy"><figcaption><span>Excavator &amp; retaining wall</span><span class="mono">/01</span></figcaption></figure>
    <figure class="rv"><img src="assets/gal_2.jpg" alt="Site cut and levelling" loading="lazy"><figcaption><span>Site cut &amp; levelling</span><span class="mono">/02</span></figcaption></figure>
    <figure class="rv"><img src="assets/gal_3.jpg" alt="Trenching and drainage" loading="lazy"><figcaption><span>Trenching &amp; drainage</span><span class="mono">/03</span></figcaption></figure>
    <figure class="rv"><img src="assets/gal_4.jpg" alt="Driveway preparation" loading="lazy"><figcaption><span>Driveway preparation</span><span class="mono">/04</span></figcaption></figure>
    <figure class="rv"><img src="assets/gal_5.jpg" alt="Bulk earthworks" loading="lazy"><figcaption><span>Bulk earthworks</span><span class="mono">/05</span></figcaption></figure>
    <figure class="rv"><img src="assets/gal_6.jpg" alt="Land clearing" loading="lazy"><figcaption><span>Land clearing</span><span class="mono">/06</span></figcaption></figure>
  </div>
</section>

<span id="quote" style="position:absolute;top:-90px"></span>
<section id="lbq" aria-labelledby="lbq-h">
<style>
#lbq{--lbq-accent:var(--acc);--lbq-ink:var(--ink);--lbq-muted:var(--ink2);--lbq-bg:var(--paper2);--lbq-panel:#fff;--lbq-line:var(--line);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto;display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:start}
@media(max-width:900px){#lbq .lbq-w{grid-template-columns:1fr}}
#lbq h2{font-size:clamp(1.6rem,3.4vw,2.3rem);margin:0 0 10px;letter-spacing:-.02em;font-family:var(--disp)}
#lbq p.lbq-s{margin:0 0 22px;color:var(--lbq-muted);max-width:52ch}
#lbq .lbq-info{display:flex;flex-direction:column;gap:12px;border-top:1px solid var(--lbq-line);padding-top:22px}
#lbq .lbq-info div{display:flex;gap:10px;align-items:baseline}
#lbq .lbq-info b{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--lbq-accent);min-width:64px}
#lbq .lbq-info a{font-weight:800;text-decoration:none}
#lbq .lbq-f{display:grid;gap:12px;background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq label{display:block;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--paper);color:var(--ink);font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:var(--lbq-acc-text,#0b0e12);font:inherit;font-weight:800;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
</style>
<div class="lbq-w">
  <div>
    <h2 id="lbq-h">Get a free quote</h2>
    <p class="lbq-s">Tell us about the job and we&rsquo;ll come back with a firm price &mdash; no surprises, no obligation.</p>
    <div class="lbq-info">
      <div><b>Call</b><a href="tel:+61488237917 237 917">0488 237 917</a></div>
      <div><b>Email</b><a href="mailto:ramcon.earthworks@gmail.com">ramcon.earthworks@gmail.com</a></div>
      <div><b>Area</b><span>Gippsland, VIC</span></div>
    </div>
  </div>
  <form id="lbq-form" novalidate data-site="ramcon-earthworks" data-biz="Ramcon Earthworks & Property Maintenance">
    <div class="lbq-f">
      <div class="lbq-g">
        <div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div>
        <div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div>
        <div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div>
        <div class="lbq-full"><label for="lbq-svc">Service</label>
          <select id="lbq-svc" name="service"><option>Tight-access excavation</option><option>Drainage</option><option>Trenching</option><option>Driveways</option><option>Land clearing</option><option>Property maintenance</option><option>Other</option></select>
        </div>
        <div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Job type, access width, site size, timing…" required></textarea></div>
      </div>
      <label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label>
      <div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <button type="submit">Send quote request</button>
      <p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p>
    </div>
  </form>
</div>
<script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = B + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>

