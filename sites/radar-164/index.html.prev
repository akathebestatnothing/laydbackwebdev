<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ramcon Earthworks &amp; Property Maintenance | Excavation, Drainage & Driveways, Gippsland VIC</title>
<meta name="description" content="Tight-access excavation, drainage, trenching, driveways and land clearing across Gippsland. Owner operated, 2.6T machine. Call 0488 237 917.">
<link rel="icon" href="assets/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Chivo:wght@400;500;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Anton&family=Chivo:wght@400;500;700&display=swap" rel="stylesheet"></noscript>
<style>
:root{
  --bg:#141517; --bg2:#1b1d20; --ink:#f2f3f4; --ink2:#9aa0a6;
  --acc:#e8b71e; --acc2:#c99a0f; --soil:#4d4238; --line:rgba(255,255,255,.12);
  --nav-h:74px;
  --disp:'Anton','Arial Narrow',sans-serif; --body-font:'Chivo',sans-serif;
  --font-m:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
section[id]{scroll-margin-top:calc(var(--nav-h) + 10px)}
html:not(.js) .rv{opacity:1!important;transform:none!important}
.js .rv{opacity:0;transform:translateY(22px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body-font);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--acc);outline-offset:3px}
::selection{background:var(--acc);color:#141517}
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:.7rem 1.2rem;background:var(--acc);color:#141517;font-weight:700;z-index:10000}
.skip:focus{top:1rem}
h1,h2,h3{font-family:var(--disp);font-weight:400;letter-spacing:.015em;text-transform:uppercase}
.mono{font-family:var(--font-m)}
.nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(1rem,3vw,2.5rem);background:rgba(20,21,23,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);z-index:1000}
.nav__b{display:flex;align-items:center;gap:.8rem}
.nav__b img{height:44px;width:auto;border-radius:6px;display:block}
.nav__b .nb-t{display:block;font-family:var(--disp);font-size:clamp(1.05rem,1.9vw,1.3rem);text-transform:uppercase;line-height:1.02}
.nav__b .nb-s{display:block;font-family:var(--font-m);font-size:.53rem;letter-spacing:.16em;text-transform:uppercase;color:var(--acc);white-space:nowrap}
.nav__links{display:flex;gap:1.4rem;list-style:none}
.nav__links a{font-size:.9rem;font-weight:500;color:var(--ink2)}
.nav__links a:hover{color:var(--ink)}
.nav__cta{display:flex;align-items:center;gap:.9rem}
.nav__p{font-size:.82rem;font-weight:700}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.8rem 1.5rem;font-size:.84rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;border:0;border-radius:4px;cursor:pointer;transition:transform .15s,background .15s,color .15s,border-color .15s}
.btn--p{background:var(--acc);color:#141517}
.btn--p:hover{background:var(--acc2);transform:translateY(-1px)}
.btn--o{border:1.5px solid var(--acc);color:var(--acc);background:transparent}
.btn--o:hover{background:var(--acc);color:#141517}
.nav__cta .btn{padding:.52rem 1.05rem;font-size:.75rem;white-space:nowrap}
@media (max-width:900px){.nav__links{display:none}.nav__p{display:none}}
@media (max-width:640px){.nav__b .nb-s{display:none}}

/* ============ hero: the excavator works ============ */
#sceneWrap{height:450vh;position:relative}
#sceneSticky{position:sticky;top:0;height:100vh;overflow:hidden;background:#141517}
#digCanvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.hero-copy{position:absolute;left:clamp(1.2rem,4.5vw,4rem);top:calc(var(--nav-h) + 4vh);max-width:620px;z-index:3}
.hero-copy .k{display:inline-flex;align-items:center;gap:.6rem;margin:0 0 .8rem;font-family:var(--font-m);font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--acc)}
.hero-copy .k i{display:block;width:26px;height:3px;background:var(--acc)}
.hero-copy h1{font-size:clamp(2.5rem,6.2vw,4.4rem);line-height:1.0;color:#fff}
.hero-copy h1 em{font-style:normal;color:var(--acc)}
.hero-copy .d{margin:1rem 0 1.4rem;font-size:clamp(.96rem,1.4vw,1.08rem);color:var(--ink2);max-width:48ch}
.cta{display:flex;gap:.8rem;flex-wrap:wrap}
.hero-copy .strip{display:flex;gap:1.6rem;flex-wrap:wrap;margin-top:1.7rem;padding-top:1.1rem;border-top:1px solid var(--line)}
.hero-copy .strip p{font-size:.8rem;color:var(--ink2)}
.hero-copy .strip b{display:block;color:var(--ink);font-size:.86rem}
.hud{position:absolute;inset:0;pointer-events:none;z-index:2}
.hud .stg{position:absolute;left:clamp(1.2rem,4.5vw,4rem);bottom:4.5vh;display:flex;align-items:baseline;gap:.8rem}
.hud .stg b{font-family:var(--disp);font-size:clamp(2.4rem,4.6vw,3.6rem);color:var(--acc);opacity:.35;line-height:1}
.hud .stg span{font-family:var(--font-m);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink2)}
.hud .rail{position:absolute;right:clamp(1rem,3.4vw,2.6rem);top:22vh;bottom:22vh;width:3px;background:rgba(255,255,255,.12);border-radius:2px}
.hud .rail i{position:absolute;left:0;top:0;width:100%;height:0%;background:var(--acc);display:block;border-radius:2px}
.scroll-hint{position:absolute;right:calc(clamp(1rem,3.4vw,2.6rem) + 1rem);bottom:4.5vh;font-family:var(--font-m);font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink2);z-index:3}

/* ============ sections ============ */
.sec{max-width:1220px;margin:0 auto;padding:clamp(4rem,9vh,7rem) clamp(1.2rem,4vw,2.5rem)}
.sec-head{display:flex;gap:1.2rem;align-items:flex-start;margin-bottom:2.4rem}
.sec-idx{font-family:var(--font-m);font-size:.78rem;color:var(--acc);font-weight:700;padding-top:.5rem}
.sec-title{font-size:clamp(1.7rem,3.4vw,2.6rem);line-height:1.05}
.sec-head p.lead{margin-top:.6rem;color:var(--ink2);max-width:62ch;font-size:1rem}
.svc-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid var(--line)}
.svc{padding:1.6rem 1.2rem 1.6rem 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:70px 1fr;gap:1rem}
.svc .n{font-family:var(--disp);font-size:1.5rem;color:var(--acc);line-height:1}
.svc h3{font-size:1.12rem;margin-bottom:.35rem}
.svc p{font-size:.93rem;color:var(--ink2)}
@media (max-width:760px){.svc-grid{grid-template-columns:1fr}}
.sec--tint{background:var(--bg2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1.4rem}
.step{border-top:3px solid var(--acc);padding-top:1rem}
.step b{font-family:var(--disp);font-size:1.7rem;color:var(--acc2);display:block;line-height:1}
.step h3{font-size:1rem;margin:.5rem 0 .25rem}
.step p{font-size:.9rem;color:var(--ink2)}
@media (max-width:900px){.steps{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.steps{grid-template-columns:1fr}}
.faq{border-top:1px solid var(--line);max-width:840px}
details.faq{border-bottom:1px solid var(--line)}
details.faq summary{cursor:pointer;list-style:none;padding:1.05rem .3rem;font-weight:700;font-size:1rem;display:flex;justify-content:space-between;gap:1rem;align-items:center}
details.faq summary::-webkit-details-marker{display:none}
details.faq summary:after{content:'+';font-family:var(--font-m);color:var(--acc);font-size:1.2rem}
details.faq[open] summary:after{content:'–'}
details.faq .a{padding:0 .3rem 1.1rem;color:var(--ink2);max-width:70ch}
.band{display:flex;gap:2.4rem;flex-wrap:wrap;justify-content:space-between;align-items:center;padding:2rem clamp(1.2rem,4vw,2.5rem);max-width:1220px;margin:0 auto}
.band .b-i{display:flex;gap:.7rem;align-items:baseline}
.band .b-i b{font-family:var(--disp);font-size:1.3rem;color:var(--acc);text-transform:uppercase}
.band .b-i span{font-size:.85rem;color:var(--ink2)}
.gal{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.gal figure{margin:0}
.gal img{width:100%;height:280px;object-fit:cover;border-radius:6px;border:1px solid var(--line)}
.gal figcaption{display:flex;justify-content:space-between;padding:10px 2px;font-size:.84rem;color:var(--ink2)}
@media (max-width:900px){.gal{grid-template-columns:repeat(2,1fr)}.gal img{height:220px}}
@media (max-width:560px){.gal{grid-template-columns:1fr}}
footer{border-top:1px solid var(--line);background:#0f1012;color:#e8eaec;padding:62px 0 0;margin-top:3rem}
footer .fw{max-width:1220px;margin:0 auto;padding:0 clamp(1.2rem,4vw,2.5rem);display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px}
footer h4{font-family:var(--font-m);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--acc);margin-bottom:1rem}
footer a{display:block;color:#b9bec4;font-size:.94rem;padding:5px 0}
footer a:hover{color:#fff}
.fbrand{display:flex;align-items:center;gap:.9rem}
.fbrand img{height:52px;border-radius:6px}
.fbrand .fb-n{font-family:var(--disp);font-size:1.2rem;color:#fff;text-transform:uppercase}
.fbrand .fb-s{font-family:var(--font-m);font-size:.55rem;letter-spacing:.16em;text-transform:uppercase;color:var(--acc)}
.footer-bar{max-width:1220px;margin:42px auto 0;padding:18px clamp(1.2rem,4vw,2.5rem);border-top:1px solid rgba(255,255,255,.12);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:.8rem;color:#8d939a}
@media (max-width:900px){footer .fw{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>

<a class="skip" href="#services">Skip to content</a>

<nav class="nav" aria-label="Main">
  <a class="nav__b" href="#top" aria-label="Ramcon Earthworks and Property Maintenance home">
    <img src="assets/logo.png" alt="Ramcon Earthworks logo">
    <span><span class="nb-t">Ramcon Earthworks</span><span class="nb-s">Earthworks · Drainage · Property Maintenance</span></span>
  </a>
