<script>
document.documentElement.classList.add('js');
/* ===== Ramcon — the excavator digs as you scroll ===== */
(function(){
'use strict';
var wrap=document.getElementById('sceneWrap'),sticky=document.getElementById('sceneSticky'),cv=document.getElementById('digCanvas');
if(!wrap||!sticky||!cv)return;
var ctx=cv.getContext('2d'),W=0,H=0;
var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var qp=new URLSearchParams(location.search),forceP=qp.get('p');
var DBG=qp.get('dbg')==='1';
var CL=function(v,a,b){return v<a?a:(v>b?b:v);};
var EZ=function(t){return 1-Math.pow(1-t,3);};

function resize(){
  var dpr=Math.min(2,window.devicePixelRatio||1);
  W=sticky.clientWidth||window.innerWidth;H=sticky.clientHeight||window.innerHeight;
  cv.width=Math.round(W*dpr);cv.height=Math.round(H*dpr);
  ctx.setTransform(dpr,0,0,dpr,0,0);ctx.lineJoin='round';
}
var _s=3311;function rnd(){_s=(_s*1103515245+12345)%2147483648;return _s/2147483648;}
function rr(a,b){return a+(b-a)*rnd();}
function hex2rgb(h){return [parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)];}
function rotZv(p,a){var c=Math.cos(a),s=Math.sin(a);return [p[0]*c-p[1]*s,p[0]*s+p[1]*c,p[2]];}

/* camera: front-left view (matches the flipped-az convention) */
var camAz=Math.PI-0.35,camEl=0.20,camD=21,f=2.1,camAlt=3.1;
function proj(x,y,z){
  var ca=Math.cos(camAz),sa=Math.sin(camAz);
  var xa=x*ca-z*sa,za=x*sa+z*ca,yy=y-camAlt;
  var ce=Math.cos(camEl),se=Math.sin(camEl);
  var vy=yy*ce+za*se,vz=-yy*se+za*ce+camD;
  var s=f*Math.min(H,W*0.9)/Math.max(6,vz);
  return {x:W/2+xa*s,y:H*0.55-vy*s,s:s,vz:vz};
}

/* piece system (boxes, rotX) */
var pieces=[];
function rotXv(p,a){var c=Math.cos(a),s=Math.sin(a);return [p[0],p[1]*c-p[2]*s,p[1]*s+p[2]*c];}
function rotAv(p,ax,a){var c=Math.cos(a),s=Math.sin(a),d=1-c,x=p[0],y=p[1],z=p[2],x0=ax[0],x1=ax[1],x2=ax[2];
 return [x*(x0*x0*d+c)+y*(x0*x1*d-x2*s)+z*(x0*x2*d+x1*s),
         x*(x1*x0*d+x2*s)+y*(x1*x1*d+c)+z*(x1*x2*d-x0*s),
         x*(x2*x0*d-x1*s)+y*(x2*x1*d+x0*s)+z*(x2*x2*d+c)];}
var LAY=0;
function add(o){
  if(o.split){
    var sp2=o.split,n=sp2[1],axs=sp2[0];delete o.split;
    for(var si=0;si<n;si++){
      var c={},k2;for(k2 in o)c[k2]=o[k2];
      var off=si-(n-1)/2,step2;
      if(axs==='x'){step2=o.sx/n;c.sx=step2+0.03;c.cx=(o.cx||0)+off*step2;}
      else if(axs==='z'){step2=o.sz/n;c.sz=step2+0.03;c.cz=(o.cz||0)+off*step2;}
      else{step2=o.sy/n;c.sy=step2+0.02;c.cy=(o.cy||0)+off*step2;}
      add(c);
    }
    return;
  }
  o.rot=o.rot||0;o.spin=o.spin||0;o.alpha=(o.alpha==null)?1:o.alpha;
  o.stroke=(o.stroke==null)?true:o.stroke;o.t0=(o.t0==null)?0:o.t0;o.dur=o.dur||0.1;
  o.fly=o.fly||[0,0,0];o.axis=o.axis||[rr(-1,1),rr(0.4,1),rr(-1,1)];o.lay=(o.lay==null)?LAY:o.lay;
  o.rgb=hex2rgb(o.c);
  o.cx=o.cx||0;o.cy=o.cy||0;o.cz=o.cz||0;
  pieces.push(o);
}
var FACES=[[0,2,3,1],[4,5,7,6],[0,4,6,2],[1,3,7,5],[0,1,5,4],[2,6,7,3]];

var C={soil:'#4d4238',soil2:'#5a4d40',soilD:'#3a322b',lawn:'#6d7a55',
       yel:'#e8b71e',yelD:'#c2960f',dark:'#26282b',track:'#1d1f22',
       glass:'#2b3a49',steel:'#8a9099',blade:'#3a3d41'};

/* ---- static site ---- */
var MZ=1.0;
LAY=1;
add({cx:0,cy:-.09,cz:-3.5,sx:42,sy:.18,sz:29,c:C.soil,t0:-0.1,fly:[0,0,0],split:['x',6]});
add({cx:-6.5,cy:.28,cz:-2.6,sx:4.2,sy:.56,sz:3.4,c:C.soil2,t0:-0.1,fly:[0,0,0],split:['x',2]});
add({cx:6.8,cy:.22,cz:-3.2,sx:3.6,sy:.44,sz:3.0,c:C.soil2,t0:-0.1,fly:[0,0,0],split:['x',2]});
add({cx:0,cy:.05,cz:8.6,sx:30,sy:.10,sz:6,c:C.lawn,t0:-0.1,fly:[0,0,0],split:['x',5]});

/* ---- the machine (static parts) ---- */
LAY=2;
add({cx:2.0,cy:.30,cz:MZ+.52,sx:2.3,sy:.6,sz:.5,c:C.track,t0:-0.1,fly:[0,0,0],split:['x',2]});
add({cx:2.0,cy:.30,cz:MZ-.52,sx:2.3,sy:.6,sz:.5,c:C.track,t0:-0.1,fly:[0,0,0],split:['x',2]});
add({cx:2.0,cy:.72,cz:MZ,sx:2.0,sy:.34,sz:1.7,c:C.dark,t0:-0.1,fly:[0,0,0]});
add({cx:1.95,cy:1.18,cz:MZ,sx:1.7,sy:.72,sz:1.5,c:C.yel,t0:-0.1,fly:[0,0,0]});
add({cx:2.45,cy:1.05,cz:MZ,sx:.5,sy:.6,sz:1.4,c:C.yelD,t0:-0.1,fly:[0,0,0]});
add({cx:2.30,cy:1.95,cz:MZ+.18,sx:.95,sy:1.0,sz:1.0,c:C.glass,t0:-0.1,fly:[0,0,0],stroke:false});
add({cx:2.30,cy:2.52,cz:MZ+.18,sx:1.05,sy:.14,sz:1.1,c:C.yelD,t0:-0.1,fly:[0,0,0]});
add({cx:2.62,cy:2.62,cz:MZ-.3,sx:.16,sy:.34,sz:.16,c:C.dark,t0:-0.1,fly:[0,0,0]});
add({cx:1.55,cy:1.62,cz:MZ,sx:.5,sy:.5,sz:.62,c:C.yelD,t0:-0.1,fly:[0,0,0]});

var PIV=[1.7,1.55,MZ],L1=3.0,L2=2.3;

/* arm poses solved by IK (deg, from +y toward -x) */
function deg(d){return d*Math.PI/180;}
var A1=[[0.06,38.6],[0.20,68.0],[0.30,87.3],[0.40,77.6],[0.48,71.0],[0.56,65.6],[0.66,44.3],[0.78,25.1],[0.88,38.6],[1.00,42.0]];
var A2=[[0.06,99.7],[0.20,56.3],[0.30,34.1],[0.40,57.0],[0.48,73.7],[0.56,88.8],[0.66,94.6],[0.78,115.7],[0.88,115.6],[1.00,106.0]];
var A3=[[0.06,-0.2],[0.30,-0.5],[0.56,-0.6],[0.66,-0.9],[0.78,-0.6],[0.88,0.9],[1.00,0.2]];
function kf1(keys,p){
  if(p<=keys[0][0])return keys[0][1];
  for(var i=1;i<keys.length;i++){
    if(p<=keys[i][0]){
      var t=(p-keys[i-1][0])/Math.max(.0001,keys[i][0]-keys[i-1][0]);
      var e=EZ(CL(t,0,1));
      return keys[i-1][1]+(keys[i][1]-keys[i-1][1])*e;
    }
  }
  return keys[keys.length-1][1];
}

/* arm boxes computed per frame: segment along +y-from-pivot rotated by cumulative angle */
function segCorners(px,py,pz,ang,len,w,h){
  var c=Math.cos(ang),s=Math.sin(ang);
  var out=[];
  for(var i=0;i<8;i++){
    var lx=((i&1)?.5:-.5)*w, ly=((i&2)?.5:-.5)*h, lz=((i&4)?.5:-.5)*len;
    /* box: x width w, y thickness h, z length len -> rotate about Z so +z-ish maps to -x direction */
    var wx=px + (lz*0)*0 , dummy=0;
    out.push([0,0,0]);
  }
  return out;
}
/* build oriented box: local (width along x', length along y'), rotated about Z by ang, from pivot */
function limb(px,py,pz,ang,len,w,h,dirSign){
  /* returns 8 world corners: length runs along direction rotZ(+y)*ang (times dirSign handled by caller angles) */
  var c=Math.cos(ang),s=Math.sin(ang);
  var vs=[];
  for(var i=0;i<8;i++){
    var lw=((i&1)?.5:-.5)*w, ll=((i&2)?.5:-.5)*len, lh=((i&4)?.5:-.5)*h;
    /* local: y'=length, x'=width, z'=depth. rotate about Z: x'' = x'*c - y'*s ; y'' = x'*s + y'*c */
    var x2=lw*c - ll*s, y2=lw*s + ll*c;
    vs.push([px+x2, py+y2, pz+lh*2]);
  }
  return vs;
}

var smoothP=0,curStage=-1;
var stgNum=document.getElementById('stgNum'),stgName=document.getElementById('stgName'),
    railFill=document.getElementById('railFill'),hint=document.getElementById('scrollHint'),
    heroCopy=document.getElementById('heroCopy');
var STAGES=[[0,'On site'],[0.20,'Reach out'],[0.30,'Bite in'],[0.40,'Cut the trench'],[0.66,'Lift'],[0.78,'Swing'],[0.88,'Spoil out'],[0.98,'Done']];

function draw(p){
  if(!isFinite(p))p=0;
  var g=ctx.createLinearGradient(0,0,0,H*0.7);
  g.addColorStop(0,'#191b1e');g.addColorStop(.65,'#21242a');g.addColorStop(1,'#2a2d31');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  var sg=ctx.createRadialGradient(W*0.78,H*0.12,0,W*0.78,H*0.12,Math.min(W,H)*0.4);
  sg.addColorStop(0,'rgba(232,183,30,.16)');sg.addColorStop(1,'rgba(232,183,30,0)');
  ctx.fillStyle=sg;ctx.fillRect(0,0,W,H*0.7);

  var faces=[];
  var i,j,o,q;
  var c1=1;
  for(i=0;i<pieces.length;i++){
    o=pieces[i];
    q=EZ(CL((p-o.t0)/o.dur,0,1));
    if(q<=0)continue;
    var k=1-q,ox=o.fly[0]*k,oy=o.fly[1]*k,oz=o.fly[2]*k;
    var sp=o.spin*k;
    var vs=null;
    if(!o._corners){
      vs=[];var bad=false;
      for(j=0;j<8;j++){
        var l=[o.sx*((j&1)?.5:-.5),o.sy*((j&2)?.5:-.5),o.sz*((j&4)?.5:-.5)];
        if(o.rot)l=rotXv(l,o.rot);
        if(sp>0.001)l=rotAv(l,o.axis,sp);
        var wx=o.cx+ox+l[0],wy=o.cy+oy+l[1],wz=o.cz+oz+l[2];
        var pr=proj(wx,wy,wz);
        if(!isFinite(pr.x)||!isFinite(pr.y)){vs=null;break;}
        vs.push({x:pr.x,y:pr.y,vz:pr.vz,wx:wx,wy:wy,wz:wz});
      }
    }
    if(!vs)continue;
    for(j=0;j<6;j++){
      var fc=FACES[j],a=vs[fc[0]],bb=vs[fc[1]],c2=vs[fc[2]],d2=vs[fc[3]];
      var e1x=bb.wx-a.wx,e1y=bb.wy-a.wy,e1z=bb.wz-a.wz,e2x=c2.wx-a.wx,e2y=c2.wy-a.wy,e2z=c2.wz-a.wz;
      var nx=e1y*e2z-e1z*e2y,ny=e1z*e2x-e1x*e2z,nz=e1x*e2y-e1y*e2x;
      var nl=Math.sqrt(nx*nx+ny*ny+nz*nz)||1;nx/=nl;ny/=nl;nz/=nl;
      var LX=0.3,LY=0.88,LZ=0.37;
      var lam=nx*LX+ny*LY+nz*LZ;if(lam<0){lam=-lam;}
      var sh=0.5+0.5*Math.max(0,lam);
      faces.push({a:a,b:bb,c:c2,d:d2,z:(a.vz+bb.vz+c2.vz+d2.vz)*0.25,l:o.lay,o:o,sh:sh});
    }
  }
  /* ---- computed arm (boom, stick, bucket) ---- */
  var d1=deg(kf1(A1,p)),d2=deg(kf1(A2,p)),d3=deg(kf1(A3,p));
  var p1x=PIV[0],p1y=PIV[1],pz=PIV[2];
  var bx=p1x-L1*Math.sin(d1), by=p1y+L1*Math.cos(d1);
  var sx2=bx-L2*Math.sin(d1+d2), sy2=by+L2*Math.cos(d1+d2);
  var bkx=sx2-0.85*Math.sin(d1+d2+d3), bky=sy2+0.85*Math.cos(d1+d2+d3);
  function pushBox(corners,col,shade){
    var vvs=[];var bad=false;
    for(var m=0;m<8;m++){
      var pr=proj(corners[m][0],corners[m][1],corners[m][2]);
      if(!isFinite(pr.x)){bad=true;break;}
      vvs.push({x:pr.x,y:pr.y,vz:pr.vz,wx:corners[m][0],wy:corners[m][1],wz:corners[m][2]});
    }
    if(bad)return;
    for(var m2=0;m2<6;m2++){
      var fc2=FACES[m2],a2=vvs[fc2[0]],b2=vvs[fc2[1]],c3=vvs[fc2[2]],d3b=vvs[fc2[3]];
      var e1x=b2.wx-a2.wx,e1y=b2.wy-a2.wy,e1z=b2.wz-a2.wz,e2x=c3.wx-a2.wx,e2y=c3.wy-a2.wy,e2z=c3.wz-a2.wz;
      var nx=e1y*e2z-e1z*e2y,ny=e1z*e2x-e1x*e2z,nz=e1x*e2y-e1y*e2x;
      var nl=Math.sqrt(nx*nx+ny*ny+nz*nz)||1;nx/=nl;ny/=nl;nz/=nl;
      var LX=0.3,LY=0.88,LZ=0.37;
      var lam=nx*LX+ny*LY+nz*LZ;if(lam<0)lam=-lam;
      var sh=0.5+0.5*Math.max(0,lam);
      faces.push({a:a2,b:b2,c:c3,d:d3b,z:(a2.vz+b2.vz+c3.vz+d3b.vz)*0.25,l:30,o:{rgb:hex2rgb(col),alpha:1,stroke:true},sh:sh});
    }
  }
  /* boom: from pivot1 along ang d1, length L1, drawn as a box (len along the direction) */
  function limbCorners(px,py,pz,ang,len,w,h){
    var c=Math.cos(ang),s=Math.sin(ang);var vs=[];
    for(var i=0;i<8;i++){
      var lw=((i&1)?.5:-.5)*w, ll=((i&2)?1:0)*len, lh=((i&4)?.5:-.5)*h;
      var x2=lw*c - ll*s, y2=lw*s + ll*c;
      vs.push([px+x2, py+y2, pz+lh*2]);
    }
    return vs;
  }
  pushBox(limbCorners(p1x,p1y,pz-0.18,d1,L1,0.42,0.6),C.yel);
  pushBox(limbCorners(p1x,p1y,pz-0.18,d1+0.5,1.5,0.16,0.2),C.steel);  /* hydraulic ram hint */
  pushBox(limbCorners(bx,by,pz-0.14,d1+d2,L2,0.3,0.44),C.yel);
  pushBox(limbCorners(bx,by,pz-0.14,d1+d2+0.5,1.1,0.12,0.14),C.steel);
  /* bucket: box at the stick end angled with d3 + teeth */
  pushBox(limbCorners(sx2,sy2,pz-0.22,d1+d2+d3,0.9,0.7,0.9),C.dark);
  pushBox(limbCorners(sx2,sy2,pz-0.05,d1+d2+d3,1.0,0.55,0.5),C.yelD);

  /* render faces */
  faces.sort(function(p1,p2){var dq=p1.l-p2.l;return dq!==0?dq:(p2.z-p1.z);});
  for(i=0;i<faces.length;i++){
    var F=faces[i],oo=F.o;
    var r2=Math.round(oo.rgb[0]*F.sh),g2=Math.round(oo.rgb[1]*F.sh),b2=Math.round(oo.rgb[2]*F.sh);
    ctx.fillStyle='rgba('+r2+','+g2+','+b2+','+(oo.alpha==null?1:oo.alpha)+')';
    ctx.beginPath();ctx.moveTo(F.a.x,F.a.y);ctx.lineTo(F.b.x,F.b.y);ctx.lineTo(F.c.x,F.c.y);ctx.lineTo(F.d.x,F.d.y);ctx.closePath();ctx.fill();
    if(oo.stroke&&(oo.alpha==null||oo.alpha>0.9)){ctx.strokeStyle='rgba(12,12,14,.35)';ctx.lineWidth=.7;ctx.stroke();}
  }
  /* dust puff on the cut */
  if(cutting){
    for(var dp=0;dp<7;dp++){
      var ph=(p*10+dp*0.37)%1;
      var dx2=tipX-rr(0,0.8), dy2=0.1+ph*1.1;
      var dpp=proj(dx2,dy2,pz+rr(-0.4,0.4));
      ctx.fillStyle='rgba(180,165,140,'+(0.22*(1-ph))+')';
      ctx.beginPath();ctx.arc(dpp.x,dpp.y,dpp.s*(0.35+ph*0.9),0,6.283);ctx.fill();
    }
  }
  /* ---- trench (grows as the bucket drags) ---- */
  var tipX=sx2-0.85*Math.sin(d1+d2+d3), tipY=sy2+0.85*Math.cos(d1+d2+d3);
  var tz1=1.6-0.62,tz2=1.6+0.62;
  var cutEnd=CL(tipX,-3.9,-2.35);
  var cutting=(p>0.30&&p<0.58);
  if(p>0.29){
    var xs=-3.95, segs=10, wSeg=(cutEnd-xs)/segs;
    if(wSeg>0.02){
      ctx.save();
      for(var sg2=0;sg2<segs;sg2++){
        var xa=xs+sg2*wSeg, xb=xa+wSeg;
        var a3=proj(xa,0.01,tz1),b3=proj(xb,0.01,tz1),c4=proj(xb,0.01,tz2),d4=proj(xa,0.01,tz2);
        ctx.fillStyle='#1c1813';
        ctx.beginPath();ctx.moveTo(a3.x,a3.y);ctx.lineTo(b3.x,b3.y);ctx.lineTo(c4.x,c4.y);ctx.lineTo(d4.x,d4.y);ctx.closePath();ctx.fill();
        var w1=proj(xa,0.01,tz1),w2=proj(xa,-0.5,tz1),w3=proj(xb,-0.5,tz1),w4=proj(xb,0.01,tz1);
        ctx.fillStyle='#332c24';
        ctx.beginPath();ctx.moveTo(w1.x,w1.y);ctx.lineTo(w2.x,w2.y);ctx.lineTo(w3.x,w3.y);ctx.lineTo(w4.x,w4.y);ctx.closePath();ctx.fill();
        var e1=proj(xa,0.01,tz1),e2=proj(xa,0.012,tz1),e3=proj(xb,0.012,tz2),e4=proj(xb,0.012,tz2);
        ctx.fillStyle='rgba(214,192,150,.30)';
        ctx.beginPath();ctx.moveTo(e1.x,e1.y);ctx.lineTo(e4.x,e4.y);ctx.lineTo(e3.x,e3.y);ctx.closePath();ctx.fill();
        var lipA=proj(xa,0.04,tz1-0.10),lipB=proj(xb,0.04,tz1-0.10),lipC=proj(xb,0.16,tz1-0.26),lipD=proj(xa,0.16,tz1-0.26);
        ctx.fillStyle='#635546';
        ctx.beginPath();ctx.moveTo(lipA.x,lipA.y);ctx.lineTo(lipB.x,lipB.y);ctx.lineTo(lipC.x,lipC.y);ctx.lineTo(lipD.x,lipD.y);ctx.closePath();ctx.fill();
      }
      ctx.restore();
    }
  }
  /* spoil heap near the machine, grows on dump */
  if(p>0.58){
    var hpf=CL((p-0.58)/0.4,0,1);
    var heap=[ [0.35,1.45,2.2],[0.62,1.25,1.7],[0.88,1.05,1.2],[1.1,0.85,0.8] ];
    for(var hh=0;hh<heap.length;hh++){
      var fr=CL((hpf-hh*0.22)/0.3,0,1);
      if(fr<=0)continue;
      var hx=-1.35-hh*0.12, hy=heap[hh][0]*0.5*fr, hz=1.6+hh*0.2;
      var h1=proj(hx-.5*heap[hh][1]*fr,0.02,hz-.5*heap[hh][2]*fr),h2=proj(hx+.5*heap[hh][1]*fr,0.02,hz-.5*heap[hh][2]*fr),
          h3=proj(hx+.5*heap[hh][1]*fr,hy*1.6,hz+.5*heap[hh][2]*fr),h4=proj(hx-.5*heap[hh][1]*fr,hy*1.6,hz+.5*heap[hh][2]*fr);
      ctx.fillStyle=hh%2?'#453a30':'#4f4437';
      ctx.beginPath();ctx.moveTo(h1.x,h1.y);ctx.lineTo(h2.x,h2.y);ctx.lineTo(h3.x,h3.y);ctx.lineTo(h4.x,h4.y);ctx.closePath();ctx.fill();
      ctx.fillStyle=(hh%2?'#3a3128':'#443a2f');
      var k1=proj(hx-.5*heap[hh][1]*fr,hy*1.6,hz-.5*heap[hh][2]*fr),k2=proj(hx+.5*heap[hh][1]*fr,hy*1.6,hz-.5*heap[hh][2]*fr);
      ctx.beginPath();ctx.moveTo(k1.x,k1.y);ctx.lineTo(k2.x,k2.y);ctx.lineTo(h3.x,h3.y);ctx.lineTo(h4.x,h4.y);ctx.closePath();ctx.fill();
    }
  }
  /* bucket load of soil */
  if(p>0.56&&p<0.885){
    var lx2=sx2-0.55*Math.sin(d1+d2+d3), ly2=sy2+0.55*Math.cos(d1+d2+d3);
    var lc=proj(lx2,ly2-0.25,pz);
    ctx.fillStyle='#4a3f33';
    ctx.beginPath();ctx.ellipse(lc.x,lc.y,lc.s*0.5,lc.s*0.32,0,0,6.283);ctx.fill();
  }
  var sI=0;
  for(i=0;i<STAGES.length;i++){if(p>=STAGES[i][0])sI=i;}
  if(sI!==curStage&&stgNum){
    curStage=sI;
    stgNum.textContent=(sI<10?'0':'')+sI;
    stgName.textContent=STAGES[sI][1];
  }
  if(railFill)railFill.style.height=(p*100).toFixed(1)+'%';
  if(heroCopy){var ho=reduce?1:CL(1-p*5.0,0,1);heroCopy.style.opacity=ho;heroCopy.style.transform='translateY('+(p*36)+'px)';}
  if(hint)hint.style.opacity=reduce?0:CL(1-p*8,0,1);
  if(DBG){
    var pb=proj(tipX,tipY,pz);
    document.title='DBG TIPW='+tipX.toFixed(2)+','+tipY.toFixed(2)+' | TRENCH@'+Math.round(pb.x)+','+Math.round(pb.y)+'=smp | P='+p.toFixed(2);
  }
}
window.__buildTo=function(x){draw(CL(+x||0,0,1));};

function animate(ts){
  if(!isFinite(ts))ts=0;
  var rect=wrap.getBoundingClientRect();
  var span=wrap.offsetHeight-sticky.offsetHeight;
  var p2=CL(-rect.top/Math.max(1,span),0,1);
  smoothP+=(p2-smoothP)*0.10;
  if(Math.abs(smoothP-p2)<0.0004)smoothP=p2;
  draw(smoothP);
  requestAnimationFrame(animate);
}

resize();
window.addEventListener('resize',function(){resize();if(forceP!=null||reduce)draw(forceP!=null?CL(parseFloat(forceP)||0,0,1):1);});
if(forceP!=null){draw(CL(parseFloat(forceP)||0,0,1));}
else if(reduce){draw(1);}
else{requestAnimationFrame(animate);}
})();

/* ===== reveals + year ===== */
(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
</body>
</html>
