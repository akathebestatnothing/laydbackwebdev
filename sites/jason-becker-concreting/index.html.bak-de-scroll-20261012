  }
  var motes = [];
  for (var i = 0; i < 54; i++) motes.push({x: Math.random(), y: Math.random(), r: 0.4 + Math.random() * 1.3, v: 0.008 + Math.random() * 0.02, o: 0.06 + Math.random() * 0.14});

  var X0 = -3.35, X1 = 3.35, Z0 = 3.3, Z1 = 14.2, SLAB = 0.4;
  var WET = [104, 112, 124], CURED = [172, 176, 182];

  function draw(p, time){
    /* sky */
    var g = ctx.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, '#061427'); g.addColorStop(0.55, '#0a2038'); g.addColorStop(1, '#08192c');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
    /* horizon haze */
    var hz = ctx.createLinearGradient(0, HZ - H * 0.09, 0, HZ + H * 0.06);
    hz.addColorStop(0, 'rgba(255,102,0,0)'); hz.addColorStop(0.6, 'rgba(255,102,0,.10)'); hz.addColorStop(1, 'rgba(255,102,0,0)');
    ctx.fillStyle = hz; ctx.fillRect(0, HZ - H * 0.09, W, H * 0.15);
    /* ground */
    quad(P(-26, 0, 30), P(26, 0, 30), P(26, 0, 2.4), P(-26, 0, 2.4), '#0a2036', null, 1);
    /* pad */
    quad(P(X0 - 0.6, 0.01, Z1 + 0.7), P(X1 + 0.6, 0.01, Z1 + 0.7), P(X1 + 0.6, 0.01, Z0 - 0.6), P(X0 - 0.6, 0.01, Z0 - 0.6), '#12293f', 'rgba(255,255,255,.06)', 1);
    ctx.save(); ctx.globalAlpha = 0.16; ctx.strokeStyle = 'rgba(255,255,255,.5)'; ctx.lineWidth = 1;
    for (var gz = 3; gz < 28; gz += 1.6) { var a = P(-26, 0, gz), b = P(26, 0, gz); ctx.beginPath(); ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]); ctx.stroke(); }
    for (var gx = -22; gx <= 22; gx += 2.4) { var c = P(gx, 0, 28), d = P(gx, 0, 2.6); ctx.beginPath(); ctx.moveTo(c[0], c[1]); ctx.lineTo(d[0], d[1]); ctx.stroke(); }
    ctx.restore();

    /* stage progress */
    var s1 = clutter((p - 0.00) / 0.22);   /* set & tie   */
    var s2 = clutter((p - 0.20) / 0.20);   /* formwork    */
    var s3 = clutter((p - 0.40) / 0.30);   /* pour        */
    var s4 = clutter((p - 0.68) / 0.32);   /* finish      */

    /* rebar grid */
    var barsZ = 13, barsX = 9, bi = 0;
    ctx.strokeStyle = 'rgba(150,168,190,.85)'; ctx.lineWidth = 1.4;
    for (var bz = Z0 + 0.5; bz < Z1 - 0.3; bz += (Z1 - Z0 - 0.8) / barsZ, bi++) {
      var ka = clutter((s1 * (barsZ + barsX) - bi) / 1.4);
      if (ka <= 0) continue;
      var aa = P(X0 + 0.16, 0.09, bz), bb = P(X1 - 0.16, 0.09, bz);
      ctx.globalAlpha = ka * 0.9; ctx.beginPath(); ctx.moveTo(aa[0], aa[1]); ctx.lineTo(bb[0], bb[1]); ctx.stroke();
    }
    for (var bx = X0 + 0.5, bj = 0; bx < X1 - 0.2; bx += (X1 - X0 - 0.7) / barsX, bj++) {
      var kb = clutter((s1 * (barsZ + barsX) - barsZ - bj) / 1.4);
      if (kb <= 0) continue;
      var cc = P(bx, 0.09, Z0 + 0.3), dd = P(bx, 0.09, Z1 - 0.2);
      ctx.globalAlpha = kb * 0.9; ctx.beginPath(); ctx.moveTo(cc[0], cc[1]); ctx.lineTo(dd[0], dd[1]); ctx.stroke();
    }
    ctx.globalAlpha = 1;

    /* formwork boards */
    if (s2 > 0) {
      var lift = (1 - s2) * 0.55;
      var timber = '#31465e', edge = '#4a648a';
      quad(P(X0 - 0.14, 0.58 - lift, Z1 + 0.18), P(X0, 0.58 - lift, Z1 + 0.18), P(X0, 0 - lift, Z1 + 0.18), P(X0 - 0.14, 0 - lift, Z1 + 0.18), timber, edge, s2);
      quad(P(X1, 0.58 - lift, Z1 + 0.18), P(X1 + 0.14, 0.58 - lift, Z1 + 0.18), P(X1 + 0.14, 0 - lift, Z1 + 0.18), P(X1, 0 - lift, Z1 + 0.18), timber, edge, s2);
      quad(P(X0 - 0.14, 0.58 - lift, Z0 - 0.18), P(X1 + 0.14, 0.58 - lift, Z0 - 0.18), P(X1 + 0.14, 0 - lift, Z0 - 0.18), P(X0 - 0.14, 0 - lift, Z0 - 0.18), timber, edge, s2);
      quad(P(X0 - 0.14, 0.58 - lift, Z1 + 0.18), P(X1 + 0.14, 0.58 - lift, Z1 + 0.18), P(X1 + 0.14, 0 - lift, Z1 + 0.18), P(X0 - 0.14, 0 - lift, Z1 + 0.18), '#283a50', edge, s2);
    }

    /* concrete placement */
    if (s3 > 0) {
      var zF = Z0 + (Z1 - Z0) * Math.min(1, s3);
      var col = mix(WET, CURED, s4);
      quad(P(X0, SLAB, zF), P(X1, SLAB, zF), P(X1, SLAB, Z0), P(X0, SLAB, Z0), col, 'rgba(255,255,255,.14)', 1);
      quad(P(X0, SLAB, zF), P(X1, SLAB, zF), P(X1, 0, zF), P(X0, 0, zF), mix(WET, CURED, s4 * 0.5), null, 0.95);
      var e1 = P(X0, SLAB, zF), e2 = P(X1, SLAB, zF);
      ctx.strokeStyle = 'rgba(255,255,255,.5)'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(e1[0], e1[1]); ctx.lineTo(e2[0], e2[1]); ctx.stroke();
    }
    /* screed bar rides the wet edge */
    if (s3 > 0.35 && s4 < 0.95) {
      var zS = Z0 + (Z1 - Z0) * Math.min(1, s3);
      var b1 = P(X0 - 0.3, 0.66, zS), b2 = P(X1 + 0.3, 0.66, zS), b3 = P(X1 + 0.3, SLAB, zS), b4 = P(X0 - 0.3, SLAB, zS);
      quad(b1, b2, b3, b4, 'rgba(255,138,61,.92)', 'rgba(255,255,255,.5)', 1);
      var r1 = P(0, 0.66, zS), r2 = P(0, SLAB + 0.02, zS);
      ctx.strokeStyle = 'rgba(255,138,61,.75)'; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(r1[0], r1[1]); ctx.lineTo(r2[0], r2[1]); ctx.stroke();
    }
    /* saw cuts on cured slab */
    if (s4 > 0.3) {
      ctx.save(); ctx.globalAlpha = (s4 - 0.3) / 0.7 * 0.75; ctx.strokeStyle = '#59616d'; ctx.lineWidth = 1.6;
      for (var k = 1; k <= 3; k++) {
        var zc = Z0 + (Z1 - Z0) * (k / 4);
        var f1 = P(X0 + 0.1, SLAB, zc), f2 = P(X1 - 0.1, SLAB, zc);
        ctx.beginPath(); ctx.moveTo(f1[0], f1[1]); ctx.lineTo(f2[0], f2[1]); ctx.stroke();
      }
      ctx.restore();
    }
    /* the house the slab is for */
    if (s4 > 0.15) {
      var rise = (1 - clutter((s4 - 0.15) / 0.85)) * 0.9, al = clutter((s4 - 0.15) / 0.85);
      var hx0 = -2.15, hx1 = 1.85, hz0 = 4.5, hz1 = 8.4, wy = 2.35 + rise;
      ctx.save(); ctx.globalAlpha = al * 0.94;
      quad(P(hx0, wy, hz1), P(hx1, wy, hz1), P(hx1, SLAB, hz1), P(hx0, SLAB, hz1), '#16233a', 'rgba(255,138,61,.35)', 1);
      quad(P(hx1, wy, hz1), P(hx1, wy, hz0), P(hx1, SLAB, hz0), P(hx1, SLAB, hz1), '#101c30', 'rgba(255,138,61,.28)', 1);
      var rt = P((hx0 + hx1) / 2, wy + 1.15, hz1), rl = P(hx0 - 0.12, wy, hz1), rr = P(hx1 + 0.12, wy, hz1);
      ctx.beginPath(); ctx.moveTo(rt[0], rt[1]); ctx.lineTo(rr[0], rr[1]); ctx.lineTo(rl[0], rl[1]); ctx.closePath();
      ctx.fillStyle = '#0d1929'; ctx.fill(); ctx.strokeStyle = 'rgba(255,138,61,.4)'; ctx.lineWidth = 1.4; ctx.stroke();
      ctx.fillStyle = 'rgba(255,168,96,.85)';
      var w1a = P(-1.55, wy - 0.5, hz1 - 0.02), w1b = P(-0.75, wy - 0.5, hz1 - 0.02), w1c = P(-0.75, wy - 1.5, hz1 - 0.02), w1d = P(-1.55, wy - 1.5, hz1 - 0.02);
      quad(w1a, w1b, w1c, w1d, 'rgba(255,168,96,.7)', null, 1);
      var w2a = P(0.4, wy - 0.5, hz1 - 0.02), w2b = P(1.2, wy - 0.5, hz1 - 0.02), w2c = P(1.2, wy - 1.5, hz1 - 0.02), w2d = P(0.4, wy - 1.5, hz1 - 0.02);
      quad(w2a, w2b, w2c, w2d, 'rgba(255,168,96,.55)', null, 1);
      ctx.restore();
    }
    /* dust motes */
    ctx.save();
    for (var m = 0; m < motes.length; m++) {
      var mo = motes[m];
      mo.y -= mo.v * 0.16; if (mo.y < 0.05) mo.y = 0.95;
      var mx = mo.x * W + Math.sin((time * 0.0004) + m) * 14, my = HZ - H * 0.06 + mo.y * (H * 0.5);
      ctx.globalAlpha = mo.o * (0.4 + 0.6 * Math.sin(time * 0.0009 + m));
      ctx.fillStyle = m % 3 === 0 ? '#ffb27a' : '#cfe0f2';
      ctx.beginPath(); ctx.arc(mx, my, mo.r, 0, 6.2832); ctx.fill();
    }
    ctx.restore();
  }

  var hudEls = [].slice.call(document.querySelectorAll('.hud b'));
  var lastStage = -1;
  function stageOf(p){ return p < 0.2 ? 0 : p < 0.4 ? 1 : p < 0.68 ? 2 : 3; }
  function setHud(i){
    if (i === lastStage) return; lastStage = i;
    hudEls.forEach(function(el, n){ el.classList.toggle('on', n === i); });
  }
  function progress(){
    if (fixedP !== null) return fixedP;
    var r = wrap.getBoundingClientRect();
    var span = r.height - window.innerHeight;
    if (span <= 0) return 1;
    var p = -r.top / span;
    return p < 0 ? 0 : p > 1 ? 1 : p;
  }
  function frame(ts){
    if (!t0) t0 = ts;
    if (!W || !H) { resize(); if (!reduce && fixedP === null) requestAnimationFrame(frame); return; }
    var p = progress();
    draw(p, ts || 0);
    setHud(stageOf(p));
    if (!reduce && fixedP === null) requestAnimationFrame(frame);
  }
  function start(){
    resize(); setCam();
    if (reduce || fixedP !== null) { draw(fixedP === null ? 1 : fixedP, 0); setHud(stageOf(fixedP === null ? 1 : fixedP)); }
    else requestAnimationFrame(frame);
  }
  window.addEventListener('resize', function(){
    resize(); setCam();
    if (reduce || fixedP !== null) draw(fixedP === null ? 1 : fixedP, 0);
  });
  if (document.readyState === 'complete' || document.readyState === 'interactive') start();
  else document.addEventListener('DOMContentLoaded', start);
})();
</script>
</body>
</html>
