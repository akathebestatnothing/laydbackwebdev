  chain:'#333', chainL:'#444',
  bucket:'#2a2a2a', bucketE:'#f5c000'
};

/* ---- build sequence: 0..1 scroll progress ---- */
/* Stage 0: float reversing in (0.00-0.15) */
/* Stage 1: ramps deploy (0.15-0.25) */
/* Stage 2: excavator tracks up ramps (0.25-0.50) */
/* Stage 3: excavator chains down (0.50-0.65) */
/* Stage 4: float pulls away (0.65-0.80) */
/* Stage 5: excavator sets down, bucket bites (0.80-1.00) */

var FL=12.0;  /* float deck length */
var FW=3.2;   /* float deck width */
var FD=0.6;   /* float deck thickness */
var RH=1.35;  /* ramp height at deck */
var RL=5.5;   /* ramp length */
var EX_L=6.5; /* excavator length */
var EX_W=2.8; /* excavator width */
var EX_H=3.0; /* excavator height */
var TR_W=0.6; /* track width */
var BM_L=4.5; /* boom length */
var BM_W=0.35;
var BK_L=1.8; /* bucket length */

/* ground plane */
LAY=0;
add({cx:0,cy:-0.05,cz:0,sx:60,sy:0.1,sz:60,c:C.ground,t0:0,dur:1,fly:[0,0,0],spin:0,alpha:1,stroke:false});

/* float deck - arrives from +Z (reversing in) */
LAY=1;
var deck=add({cx:0,cy:0.35,cz:0,sx:FW,sy:FD,sz:FL,c:C.steel,t0:0.00,dur:0.15,fly:[0,0,25],spin:0,split:['x',2]});
/* deck side rails */
add({cx:-(FW/2-0.1),cy:0.55,cz:0,sx:0.2,sy:0.4,sz:FL-0.5,c:C.steelD,t0:0.02,dur:0.15,fly:[0,0,25],spin:0,split:['x',2]});
add({cx:(FW/2-0.1),cy:0.55,cz:0,sx:0.2,sy:0.4,sz:FL-0.5,c:C.steelD,t0:0.02,dur:0.15,fly:[0,0,25],spin:0,split:['x',2]});
/* deck yellow stripes */
add({cx:0,cy:0.61,cz:0,sx:FW*0.9,sy:0.02,sz:FL*0.15,c:C.yellow,t0:0.03,dur:0.15,fly:[0,0,25],spin:0,stroke:false,split:['z',4]});

/* ramps - deploy from under deck */
LAY=2;
var rampT0=0.15;
add({cx:0,cy:0.35+RH/2,cz:FL/2+RL/2,sx:FW*0.9,sy:0.15,sz:RL,rot:-0.22,c:C.steel,t0:rampT0,dur:0.1,fly:[0,2,0],spin:0.5,split:['x',2]});
add({cx:0,cy:0.35+RH/2,cz:-(FL/2+RL/2),sx:FW*0.9,sy:0.15,sz:RL,rot:0.22,c:C.steel,t0:rampT0+0.01,dur:0.1,fly:[0,2,0],spin:-0.5,split:['x',2]});
/* ramp side curbs */
add({cx:-(FW*0.9/2-0.1),cy:0.35+RH/2+0.15,cz:FL/2+RL/2,sx:0.15,sy:0.3,sz:RL,rot:-0.22,c:C.steelD,t0:rampT0+0.02,dur:0.1,fly:[0,2,0],spin:0.5});
add({cx:(FW*0.9/2-0.1),cy:0.35+RH/2+0.15,cz:FL/2+RL/2,sx:0.15,sy:0.3,sz:RL,rot:-0.22,c:C.steelD,t0:rampT0+0.02,dur:0.1,fly:[0,2,0],spin:0.5});
add({cx:-(FW*0.9/2-0.1),cy:0.35+RH/2+0.15,cz:-(FL/2+RL/2),sx:0.15,sy:0.3,sz:RL,rot:0.22,c:C.steelD,t0:rampT0+0.03,dur:0.1,fly:[0,2,0],spin:-0.5});
add({cx:(FW*0.9/2-0.1),cy:0.35+RH/2+0.15,cz:-(FL/2+RL/2),sx:0.15,sy:0.3,sz:RL,rot:0.22,c:C.steelD,t0:rampT0+0.03,dur:0.1,fly:[0,2,0],spin:-0.5});

/* excavator - starts on ground behind float (negative Z), drives up rear ramp */
LAY=3;
var exT0=0.25;
/* undercarriage */
add({cx:0,cy:0.8,cz:-10,sx:EX_W,sy:0.9,sz:EX_L*0.7,c:C.steel,t0:exT0,dur:0.25,fly:[0,0,15],spin:0,axis:[0,1,0]});
/* tracks */
add({cx:-(EX_W/2-TR_W/2),cy:0.5,cz:-10,sx:TR_W,sy:0.6,sz:EX_L*0.7,c:C.track,t0:exT0,dur:0.25,fly:[0,0,15],spin:0,axis:[0,1,0]});
add({cx:(EX_W/2-TR_W/2),cy:0.5,cz:-10,sx:TR_W,sy:0.6,sz:EX_L*0.7,c:C.track,t0:exT0,dur:0.25,fly:[0,0,15],spin:0,axis:[0,1,0]});
/* track rollers (detail) */
add({cx:-(EX_W/2-TR_W/2),cy:0.5,cz:-10,sx:TR_W*0.8,sy:0.08,sz:EX_L*0.7*0.9,c:C.trackL,t0:exT0+0.01,dur:0.25,fly:[0,0,15],spin:0,axis:[0,1,0],stroke:false,split:['z',6]});
add({cx:(EX_W/2-TR_W/2),cy:0.5,cz:-10,sx:TR_W*0.8,sy:0.08,sz:EX_L*0.7*0.9,c:C.trackL,t0:exT0+0.01,dur:0.25,fly:[0,0,15],spin:0,axis:[0,1,0],stroke:false,split:['z',6]});

/* upper house (rotates later) */
add({cx:0,cy:1.8,cz:-10,sx:EX_W*0.95,sy:1.4,sz:EX_W*0.95,c:C.yellow,t0:exT0,dur:0.25,fly:[0,0,15],spin:0,axis:[0,1,0]});
/* cab */
add({cx:0.8,cy:2.6,cz:-10,sx:1.2,sy:1.2,sz:1.4,c:C.yellow,t0:exT0,dur:0.25,fly:[0,0,15],spin:0,axis:[0,1,0]});
add({cx:0.8,cy:2.6,cz:-10,sx:1.1,sy:1.1,sz:1.3,c:C.steelD,t0:exT0+0.01,dur:0.25,fly:[0,0,15],spin:0,axis:[0,1,0],stroke:false}); /* glass */

/* counterweight */
add({cx:0,cy:1.8,cz:-10+EX_W*0.5,sx:EX_W*0.9,sy:0.9,sz:0.6,c:C.steelD,t0:exT0,dur:0.25,fly:[0,0,15],spin:0,axis:[0,1,0]});

/* boom - starts folded, extends */
LAY=4;
var boomT0=0.35;
add({cx:0,cy:2.2,cz:-10,sx:BM_W,sy:BM_W,sz:BM_L,rot:0.6,c:C.yellow,t0:boomT0,dur:0.15,fly:[0,0,15],spin:0,axis:[1,0,0]});
/* arm */
add({cx:0,cy:2.2+BM_L*Math.sin(0.6),cz:-10-BM_L*Math.cos(0.6),sx:BM_W,sy:BM_W,sz:BM_L*0.7,rot:0.2,c:C.yellow,t0:boomT0+0.02,dur:0.15,fly:[0,0,15],spin:0,axis:[1,0,0]});
/* bucket */
add({cx:0,cy:2.2+BM_L*Math.sin(0.6)+BM_L*0.7*Math.sin(0.8),cz:-10-BM_L*Math.cos(0.6)-BM_L*0.7*Math.cos(0.8),sx:BK_L,sy:0.6,sz:0.8,c:C.bucket,t0:boomT0+0.04,dur:0.15,fly:[0,0,15],spin:0,axis:[1,0,0]});
/* bucket edge */
add({cx:0,cy:2.2+BM_L*Math.sin(0.6)+BM_L*0.7*Math.sin(0.8)+0.3,cz:-10-BM_L*Math.cos(0.6)-BM_L*0.7*Math.cos(0.8),sx:BK_L,sy:0.05,sz:0.9,c:C.bucketE,t0:boomT0+0.05,dur:0.15,fly:[0,0,15],spin:0,axis:[1,0,0],stroke:false});

/* hydraulic cylinders */
add({cx:0.5,cy:2.0,cz:-10,sx:0.12,sy:0.12,sz:1.8,c:C.hyd,t0:boomT0,dur:0.15,fly:[0,0,15],spin:0,axis:[1,0,0]});
add({cx:-0.5,cy:2.0,cz:-10,sx:0.12,sy:0.12,sz:1.8,c:C.hyd,t0:boomT0,dur:0.15,fly:[0,0,15],spin:0,axis:[1,0,0]});

/* chains / binders - appear during chain-down stage */
LAY=5;
var chainT0=0.50;
/* front chains */
add({cx:-(EX_W/2-0.3),cy:0.8,cz:-10+EX_L*0.3,sx:0.08,sy:0.08,sz:2.5,c:C.chain,t0:chainT0,dur:0.15,fly:[0,1,0],spin:0,stroke:false});
add({cx:(EX_W/2-0.3),cy:0.8,cz:-10+EX_L*0.3,sx:0.08,sy:0.08,sz:2.5,c:C.chain,t0:chainT0,dur:0.15,fly:[0,1,0],spin:0,stroke:false});
/* rear chains */
add({cx:-(EX_W/2-0.3),cy:0.8,cz:-10-EX_L*0.3,sx:0.08,sy:0.08,sz:2.5,c:C.chain,t0:chainT0+0.02,dur:0.15,fly:[0,1,0],spin:0,stroke:false});
add({cx:(EX_W/2-0.3),cy:0.8,cz:-10-EX_L*0.3,sx:0.08,sy:0.08,sz:2.5,c:C.chain,t0:chainT0+0.02,dur:0.15,fly:[0,1,0],spin:0,stroke:false});
/* binders */
add({cx:-(EX_W/2-0.3),cy:1.0,cz:-10+EX_L*0.3,sx:0.3,sy:0.15,sz:0.3,c:C.steel,t0:chainT0+0.01,dur:0.15,fly:[0,1,0],spin:0});
add({cx:(EX_W/2-0.3),cy:1.0,cz:-10+EX_L*0.3,sx:0.3,sy:0.15,sz:0.3,c:C.steel,t0:chainT0+0.01,dur:0.15,fly:[0,1,0],spin:0});
add({cx:-(EX_W/2-0.3),cy:1.0,cz:-10-EX_L*0.3,sx:0.3,sy:0.15,sz:0.3,c:C.steel,t0:chainT0+0.03,dur:0.15,fly:[0,1,0],spin:0});
add({cx:(EX_W/2-0.3),cy:1.0,cz:-10-EX_L*0.3,sx:0.3,sy:0.15,sz:0.3,c:C.steel,t0:chainT0+0.03,dur:0.15,fly:[0,1,0],spin:0});

/* float pulls away (deck + ramps move forward +Z) */
/* This is handled in render by transforming deck/ramps based on progress */

/* excavator final position - on ground, bucket biting */
LAY=6;
var finalT0=0.80;
/* ground contact shadow */
add({cx:0,cy:0.02,cz:-2,sx:EX_W*1.2,sy:0.02,sz:EX_L*1.2,c:C.groundL,t0:finalT0,dur:0.2,fly:[0,0,0],spin:0,alpha:0.5,stroke:false});
/* excavator settled - already animated via main pieces, just add final bucket bite */
/* bucket teeth biting ground */
add({cx:0,cy:0.15,cz:-2,sx:BK_L*0.9,sy:0.15,sz:0.5,c:C.bucketE,t0:finalT0+0.05,dur:0.2,fly:[0,0,0],spin:0,stroke:false,alpha:0.8});

/* floating dust particles during drive-up */
LAY=7;
for(var di=0;di<30;di++){
  add({cx:rr(-8,8),cy:rr(0.3,2.5),cz:rr(-12,8),sx:rr(0.05,0.15),sy:rr(0.05,0.15),sz:rr(0.05,0.15),c:C.groundL,t0:rr(0.25,0.6),dur:rr(0.2,0.4),fly:[rr(-1,1),rr(-2,0),rr(-1,1)],spin:rr(0.5,2),alpha:rr(0.2,0.5),stroke:false});
}

/* ===== render ===== */
var FACES=[[0,2,3,1],[4,5,7,6],[0,4,6,2],[1,3,7,5],[0,1,5,4],[2,6,7,3]];
var LX=0.42,LY=0.80,LZ=0.42;
function rotXv(p,a){var c=Math.cos(a),s=Math.sin(a);return [p[0],p[1]*c-p[2]*s,p[1]*s+p[2]*c];}
function rotAv(p,ax,a){var c=Math.cos(a),s=Math.sin(a),d=1-c,x=p[0],y=p[1],z=p[2],x0=ax[0],x1=ax[1],x2=ax[2];
 return [x*(x0*x0*d+c)+y*(x0*x1*d-x2*s)+z*(x0*x2*d+x1*s),
         x*(x1*x0*d+x2*s)+y*(x1*x1*d+c)+z*(x1*x2*d-x0*s),
         x*(x2*x0*d-x1*s)+y*(x2*x1*d+x0*s)+z*(x2*x2*d+c)];}

var smoothP=0,mx=0,my=0,tmx=0,tmy=0,curStage=-1;
var stgNum=document.getElementById('stgNum'),stgName=document.getElementById('stgName'),
    railFill=document.getElementById('railFill'),hint=document.getElementById('scrollHint'),
    heroCopy=document.getElementById('heroCopy');
var STAGES=[[0.00,'Float inbound'],[0.15,'Ramps deploying'],[0.25,'Machine tracking up'],[0.50,'Chaining down'],[0.65,'Float departing'],[0.80,'Machine settling'],[1.00,'Ready to dig']];

function draw(p){
  if(!isFinite(p))p=0;
  var AZC=-0.66+p*0.30+mx*0.045;
  var ca=Math.cos(AZC),sa=Math.sin(AZC);
  var el=0.30+0.05*p-my*0.028,ce=Math.cos(el),se=Math.sin(el);
  var D=(W<640?26.5:33)*(1-0.10*p),f=1.55*Math.min(H,W*0.8),camY=4.35,yA=0.575;
  function proj(x,y,z){
    var xa=x*ca-z*sa,za=x*sa+z*ca,yy=y-camY;
    var vy=yy*ce+za*se,vz=-yy*se+za*ce+D,s=f/Math.max(6,vz);
    return {x:W/2+xa*s,y:H*yA-vy*s,s:s,vz:vz};
  }

  /* sky + ground wash */
  var g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,'#080706');g.addColorStop(.55,'#0b0a09');g.addColorStop(1,'#0a0908');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);

  /* perspective grid */
  ctx.strokeStyle='rgba(240,235,229,.035)';ctx.lineWidth=1;
  var x,z,pa,pb;
  for(x=-20;x<=20;x+=2){pa=proj(x,0,-15);pb=proj(x,0,30);ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();}
  for(z=-12;z<=30;z+=2){pa=proj(-20,0,z);pb=proj(20,0,z);ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();}

  /* ground shadow under machine */
  var c0=proj(0,0.01,-2);
  if(c0.s>0){ctx.fillStyle='rgba(0,0,0,.35)';ctx.beginPath();ctx.ellipse(c0.x,c0.y,c0.s*10,c0.s*3,0,0,6.283);ctx.fill();}

  /* progress-dependent transforms */
  var deckZ = 0;        /* deck starts at Z=0 after reversing in */
  var rampAngle = 0;    /* ramp deployment */
  var exZ = -10;        /* excavator Z position */
  var exRotY = 0;       /* house rotation */
  var boomExt = 0;      /* boom extension */
  var bucketAngle = 0;  /* bucket curl */
  var chainVis = 0;     /* chain visibility */
  var floatAway = 0;    /* float departure */

  if(p < 0.15){
    /* float reversing in */
    deckZ = 25 * (1 - EZ(p/0.15));
  } else if(p < 0.25){
    /* ramps deploying */
    deckZ = 0;
    rampAngle = -0.22 * EZ((p-0.15)/0.10);
  } else if(p < 0.50){
    /* excavator tracking up */
    deckZ = 0;
    rampAngle = -0.22;
    var t = (p-0.25)/0.25;
    exZ = -10 + 12 * EZ(t);  /* from -10 to +2 (on deck) */
    /* drive up ramp: Y follows ramp */
    if(t < 0.5){
      /* on rear ramp */
    } else {
      /* on deck */
    }
  } else if(p < 0.65){
    /* chaining down */
    deckZ = 0;
    rampAngle = -0.22;
    exZ = 2;
    chainVis = EZ((p-0.50)/0.15);
  } else if(p < 0.80){
    /* float pulls away */
    deckZ = 0;
    rampAngle = -0.22 * (1 - EZ((p-0.65)/0.15)); /* ramps fold up */
    exZ = 2;
    chainVis = 1 - EZ((p-0.65)/0.15); /* chains release */
    floatAway = EZ((p-0.65)/0.15);    /* float moves forward +Z */
  } else {
    /* excavator sets down, bucket bites */
    deckZ = 20 * EZ((p-0.80)/0.20);  /* float gone */
    rampAngle = 0;
    exZ = 2 - 4 * EZ((p-0.80)/0.20); /* machine lowers off deck to ground */
    chainVis = 0;
    floatAway = 1;
    if(p > 0.90){
      bucketAngle = (p-0.90)/0.10 * 0.3; /* bucket curls down */
    }
  }

  /* ---- render pieces with progress transforms ---- */
  var faces=[];
  for(var i=0;i<pieces.length;i++){
    var o=pieces[i];
    var q=EZ(CL((p-o.t0)/o.dur,0,1));
    if(q<=0)continue;
    var sp=o.spin*(1-q);
    var k=1-q,ox=o.fly[0]*k,oy=o.fly[1]*k,oz=o.fly[2]*k;

    /* apply progress transforms based on piece layer */
    var cx=o.cx+ox, cy=o.cy+oy, cz=o.cz+oz;
    var rot=o.rot, sx=o.sx, sy=o.sy, sz=o.sz;

    if(o.lay===1 || o.lay===2){
      /* float deck and ramps */
      cz += deckZ + floatAway * 25;
      if(o.lay===2){
        /* ramps rotate */
        rot = rampAngle;
        /* ramp Y position follows rotation */
        cy = 0.35 + RH/2 * Math.abs(Math.sin(rampAngle)) / Math.sin(0.22);
      }
    } else if(o.lay===3 || o.lay===4){
      /* excavator body, boom */
      cz = exZ;
      if(o.lay===4 && p > 0.35){
        /* boom extends as machine reaches deck */
        if(p < 0.50){
          var bt = (p-0.35)/0.15;
          rot = 0.6 - 0.4 * EZ(bt); /* boom lowers from transport */
        } else if(p < 0.80){
          rot = 0.2;
        } else {
          rot = 0.2 + bucketAngle; /* bucket bites */
        }
      }
    } else if(o.lay===5){
      /* chains - fade in/out */
      o.alpha = chainVis;
    } else if(o.lay===6){
      /* final ground effects */
      /* already positioned */
    } else if(o.lay===7){
      /* dust - only during drive up */
      if(p < 0.25 || p > 0.65) o.alpha = 0;
    }

    var vs=[];
    for(var j=0;j<8;j++){
      var l=[sx*((j&1)?.5:-.5),sy*((j&2)?.5:-.5),sz*((j&4)?.5:-.5)];
      if(rot)l=rotXv(l,rot);
      if(sp>0.001)l=rotAv(l,o.axis,sp);
      var wx=cx+l[0],wy=cy+l[1],wz=cz+l[2];
      var pr=proj(wx,wy,wz);
      if(!isFinite(pr.x)||!isFinite(pr.y)){vs=null;break;}
      vs.push({x:pr.x,y:pr.y,vz:pr.vz,wx:wx,wy:wy,wz:wz});
    }
    if(!vs)continue;
    for(var j=0;j<6;j++){
      var fc=FACES[j],a=vs[fc[0]],b=vs[fc[1]],c=vs[fc[2]],d2=vs[fc[3]];
      var e1x=b.wx-a.wx,e1y=b.wy-a.wy,e1z=b.wz-a.wz,e2x=c.wx-a.wx,e2y=c.wy-a.wy,e2z=c.wz-a.wz;
      var nx=e1y*e2z-e1z*e2y,ny=e1z*e2x-e1x*e2z,nz=e1x*e2y-e1y*e2x;
      var nl=Math.sqrt(nx*nx+ny*ny+nz*nz)||1;nx/=nl;ny/=nl;nz/=nl;
      var lam=nx*LX+ny*LY+nz*LZ;if(lam<0){nx=-nx;ny=-ny;nz=-nz;lam=-lam;}
      var sh=0.40+0.60*Math.max(0,lam);
      faces.push({a:a,b:b,c:c,d:d2,z:(a.vz+b.vz+c.vz+d2.vz)*0.25,l:o.lay||0,o:o,sh:sh});
    }
  }
  faces.sort(function(p1,p2){var dq=p1.l-p2.l;return dq!==0?dq:(p2.z-p1.z);});
  for(var i=0;i<faces.length;i++){
    var F=faces[i],oo=F.o,r2=Math.round(oo.rgb[0]*F.sh),g2=Math.round(oo.rgb[1]*F.sh),b2=Math.round(oo.rgb[2]*F.sh);
    ctx.fillStyle='rgba('+r2+','+g2+','+b2+','+oo.alpha+')';
    ctx.beginPath();ctx.moveTo(F.a.x,F.a.y);ctx.lineTo(F.b.x,F.b.y);ctx.lineTo(F.c.x,F.c.y);ctx.lineTo(F.d.x,F.d.y);ctx.closePath();ctx.fill();
    if(oo.stroke&&oo.alpha>0.9){ctx.strokeStyle='rgba(12,9,6,.5)';ctx.lineWidth=.7;ctx.stroke();}
  }

  /* vignette */
  var vg=ctx.createRadialGradient(W/2,H*0.52,Math.min(W,H)*0.32,W/2,H*0.52,Math.max(W,H)*0.78);
  vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.45)');
  ctx.fillStyle=vg;ctx.fillRect(0,0,W,H);

  /* hud */
  var sI=0;
  for(i=0;i<STAGES.length;i++){if(p>=STAGES[i][0])sI=i;}
  if(sI!==curStage&&stgNum){
    curStage=sI;
    stgNum.textContent=(sI<10?'0':'')+sI;
    stgName.textContent=STAGES[sI][1];
  }
  if(railFill)railFill.style.height=(p*100).toFixed(1)+'%';
  if(heroCopy){var ho=reduce?1:CL(1-p*5.2,0,1);heroCopy.style.opacity=ho;heroCopy.style.transform='translateY('+(p*40)+'px)';}
  if(hint)hint.style.opacity=reduce?0:CL(1-p*8,0,1);
}

window.__buildTo=function(x){draw(CL(+x||0,0,1));};

function animate(ts){
  if(!isFinite(ts))ts=0;
  var rect=wrap.getBoundingClientRect();
  var span=wrap.offsetHeight-sticky.offsetHeight;
  var p=CL(-rect.top/Math.max(1,span),0,1);
  smoothP+=(p-smoothP)*0.10;
  if(Math.abs(smoothP-p)<0.0004)smoothP=p;
  mx+=(tmx-mx)*0.06;my+=(tmy-my)*0.06;
  draw(smoothP);
  requestAnimationFrame(animate);
}
window.addEventListener('pointermove',function(e){tmx=(e.clientX/window.innerWidth)*2-1;tmy=(e.clientY/window.innerHeight)*2-1;},{passive:true});

resize();
window.addEventListener('resize',function(){resize();if(forceP!=null||reduce)draw(forceP!=null?CL(parseFloat(forceP)||0,0,1):1);});
if(forceP!=null){draw(CL(parseFloat(forceP)||0,0,1));}
else if(reduce){draw(1);}
else{requestAnimationFrame(animate);}
})();
</script>

<script>
/* ===== reveals + year ===== */
(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
