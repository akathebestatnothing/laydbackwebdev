<canvas id="heroCanvas" aria-hidden="true"></canvas>
<script id="lb-motion-js">
/* LB MOTION PACK v1 */
(function(){
  var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = 'section > *, main > *, .sec-head, .cards > *, .grid > *, .faq details, .gal figure, .gallery figure';
  var els = [].slice.call(document.querySelectorAll(sel)).filter(function(e){
    if (e.closest && e.closest('.lb-rb')) return false;
    if (e.tagName === 'SCRIPT' || e.tagName === 'STYLE') return false;
    var r = e.getBoundingClientRect();
    return r.width > 40 && r.height > 20;
  });
  els.forEach(function(e, i){ e.classList.add('lb-rv'); e.style.transitionDelay = ((i % 6) * 55) + 'ms'; });
  if (rm || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(en){
      en.forEach(function(x){ if (x.isIntersecting) { x.target.classList.add('is-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
    els.forEach(function(e){ io.observe(e); });
    setTimeout(function(){ els.forEach(function(e){ if (!e.classList.contains('is-in')) e.classList.add('is-in'); }); }, 2600);
  }
  var rb = document.querySelector('.lb-rb');
  if (!rb) return;
  var slides = [].slice.call(rb.querySelectorAll('.lb-rb__slide'));
  if (slides.length < 2) return;
  var dots = [].slice.call(rb.querySelectorAll('.lb-rb__dots button'));
  var i = 0, timer = null, DUR = 5600;
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach(function(s, k){ s.classList.toggle('is-on', k === i); });
    dots.forEach(function(d, k){ d.classList.toggle('is-on', k === i); });
  }
  function play(){ if (rm) return; stop(); timer = setInterval(function(){ go(i + 1); }, DUR); }
  function stop(){ if (timer) { clearInterval(timer); timer = null; } }
  dots.forEach(function(d, k){ d.addEventListener('click', function(){ go(k); play(); }); });
  var pv = rb.querySelector('.lb-rb__nav--prev'), nx = rb.querySelector('.lb-rb__nav--next');
  if (pv) pv.addEventListener('click', function(){ go(i - 1); play(); });
  if (nx) nx.addEventListener('click', function(){ go(i + 1); play(); });
  rb.addEventListener('mouseenter', stop); rb.addEventListener('mouseleave', play);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(en){ en.forEach(function(x){ x.isIntersecting ? play() : stop(); }); },
      { threshold: 0.25 }).observe(rb);
  } else { play(); }
  go(0);
})();
</script>
<script id="lb-hero-js">
/* LB HERO - solar & battery repair scene: low sun, ground-mount array, battery bank,
   power flowing array -> battery. Deterministic, reduced-motion aware. */
(function(){
  var cv = document.querySelector('.lb-hero-canvas, #heroCanvas, .hero-canvas, .lb3d-canvas, canvas[data-hero]');
  if (!cv) return;
  var ctx = cv.getContext('2d'); if (!ctx) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var W = 0, H = 0, dpr = 1, t = 0, raf = null, visible = true;
  function css(name, fallback){
    var v = getComputedStyle(document.documentElement).getPropertyValue(name);
    v = (v || '').trim(); return /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v) ? v : fallback;
  }
  function hex2rgb(h){ h = h.replace('#',''); if (h.length === 3) h = h[0]+h[0]+h[1]+h[1]+h[2]+h[2];
    return [parseInt(h.slice(0,2),16), parseInt(h.slice(2,4),16), parseInt(h.slice(4,6),16)]; }
  var ACC = hex2rgb(css('--accent','#384070'));
  var SUN = hex2rgb(css('--sun','#e9a13b'));
  var A = function(a){ return 'rgba('+ACC.join(',')+','+a+')'; };
  var S = function(a){ return 'rgba('+SUN.join(',')+','+a+')'; };

  function size(){
    var r = cv.getBoundingClientRect();
    dpr = Math.min(2, window.devicePixelRatio || 1);
    W = Math.max(320, r.width || cv.clientWidth || window.innerWidth);
    H = Math.max(260, r.height || cv.clientHeight || window.innerHeight);
    cv.width = Math.round(W*dpr); cv.height = Math.round(H*dpr);
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }

  var seed = 20261022;
  function rnd(){ seed = (seed*1103515245 + 12345) % 2147483648; return seed/2147483648; }
  var motes = [];
  for (var i=0;i<40;i++) motes.push({x:rnd(), y:rnd()*0.5, s:0.5+rnd()*1.6, p:rnd()*6.283, v:0.4+rnd()});

  function sky(hz, sx, sy){
    var g = ctx.createLinearGradient(0,0,0,hz);
    g.addColorStop(0,'#080a11');
    g.addColorStop(0.45,'#141a2c');
    g.addColorStop(0.78,'#2b2a3f');
    g.addColorStop(1,'#3b3140');
    ctx.fillStyle = g; ctx.fillRect(0,0,W,hz+1);
    // warm haze around the sun, sitting on the horizon
    var rg = ctx.createRadialGradient(sx,sy,0,sx,sy,Math.max(W,H)*0.55);
    rg.addColorStop(0,S(0.42)); rg.addColorStop(0.22,S(0.18)); rg.addColorStop(0.55,S(0.05)); rg.addColorStop(1,S(0));
    ctx.fillStyle = rg; ctx.fillRect(0,0,W,hz+1);
  }

  function sun(hz, sx, sy){
    var r = Math.max(18, W*0.028);
    var fl = 1 + 0.05*Math.sin(t*0.0009);
    var g = ctx.createRadialGradient(sx,sy,0,sx,sy,r*7);
    g.addColorStop(0,S(0.55)); g.addColorStop(0.18,S(0.22)); g.addColorStop(1,S(0));
    ctx.fillStyle = g; ctx.beginPath(); ctx.arc(sx,sy,r*7,0,6.283); ctx.fill();
    ctx.fillStyle = 'rgba(255,238,206,0.95)';
    ctx.beginPath(); ctx.arc(sx,sy,r*fl,0,6.283); ctx.fill();
    // horizon overspill
    var hg = ctx.createLinearGradient(0,hz-r,0,hz+r*1.4);
    hg.addColorStop(0,S(0)); hg.addColorStop(0.5,S(0.30)); hg.addColorStop(1,S(0));
    ctx.fillStyle = hg; ctx.fillRect(sx-r*3, hz-r, r*6, r*2.6);
  }

  function ground(hz){
    var g = ctx.createLinearGradient(0,hz,0,H);
    g.addColorStop(0,'#191c25');
    g.addColorStop(0.45,'#10131a');
    g.addColorStop(1,'#0a0c11');
    ctx.fillStyle = g; ctx.fillRect(0,hz,W,H-hz);
    ctx.strokeStyle = S(0.16); ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.moveTo(0,hz+0.5); ctx.lineTo(W,hz+0.5); ctx.stroke();
  }

  // one tilted panel drawn as a quad with frame, cells and a travelling glint
  function panel(q, gx, gw){
    var p = new Path2D();
    p.moveTo(q[0][0],q[0][1]); p.lineTo(q[1][0],q[1][1]);
    p.lineTo(q[2][0],q[2][1]); p.lineTo(q[3][0],q[3][1]); p.closePath();
    var lg = ctx.createLinearGradient(q[0][0],q[0][1],q[3][0],q[3][1]);
    lg.addColorStop(0,'#1b2a4d'); lg.addColorStop(0.5,'#121c33'); lg.addColorStop(1,'#0d1526');
    ctx.fillStyle = lg; ctx.fill(p);
    ctx.save(); ctx.clip(p);
    ctx.strokeStyle = 'rgba(158,182,224,0.30)'; ctx.lineWidth = 1;
    for (var c=1;c<6;c++){
      var f = c/6;
      ctx.beginPath();
      ctx.moveTo(q[0][0]+(q[1][0]-q[0][0])*f, q[0][1]+(q[1][1]-q[0][1])*f);
      ctx.lineTo(q[3][0]+(q[2][0]-q[3][0])*f, q[3][1]+(q[2][1]-q[3][1])*f);
      ctx.stroke();
    }
    for (var r2=1;r2<4;r2++){
      var f2 = r2/4;
      ctx.beginPath();
      ctx.moveTo(q[0][0]+(q[3][0]-q[0][0])*f2, q[0][1]+(q[3][1]-q[0][1])*f2);
      ctx.lineTo(q[1][0]+(q[2][0]-q[1][0])*f2, q[1][1]+(q[2][1]-q[1][1])*f2);
      ctx.stroke();
    }
    // glint sweeps across the glass
    var gp = ((gx*0.55 + t*0.00022) % 1.9) - 0.45;
    var bx = q[0][0] + (q[1][0]-q[0][0])*gp;
    var band = ctx.createLinearGradient(bx-gw*0.5, 0, bx+gw*0.5, 0);
    band.addColorStop(0,'rgba(255,247,226,0)');
    band.addColorStop(0.5,'rgba(255,247,226,0.16)');
    band.addColorStop(1,'rgba(255,247,226,0)');
    ctx.fillStyle = band; ctx.fillRect(q[0][0]-gw,q[0][1]-20,qw(q)+gw*2,400);
    ctx.restore();
    ctx.strokeStyle = 'rgba(196,214,245,0.42)'; ctx.lineWidth = 1.6; ctx.stroke(p);
    // legs
    ctx.strokeStyle = 'rgba(150,168,196,0.35)'; ctx.lineWidth = 2;
    var mx = (q[3][0]+q[2][0])/2, my = (q[3][1]+q[2][1])/2;
    ctx.beginPath(); ctx.moveTo(mx,my); ctx.lineTo(mx,my+Math.max(6,H*0.016)); ctx.stroke();
  }
  function qw(q){ return Math.abs(q[1][0]-q[0][0]); }

  function array(hz){
    // far row then near row, both ground mounted
    for (var row=1; row>=0; row--){
      var n = row ? 8 : 5;
      var baseY = hz + (row ? H*0.045 : H*0.185);
      var pw = (row ? W*0.082 : W*0.145);
      var ph = (row ? H*0.075 : H*0.135);
      var gap = pw*0.20;
      var total = n*pw + (n-1)*gap;
      var x0 = row ? -W*0.02 : W*0.03;
      var sh = pw*0.30;
      for (var k=0;k<n;k++){
        var x = x0 + k*(pw+gap);
        panel([[x+sh*0.5, baseY-ph],[x+pw+sh*0.9, baseY-ph*0.62],[x+pw, baseY],[x, baseY-ph*0.30]],
              (x/total)+k*0.13, pw);
      }
      // rack rail under each row
      ctx.strokeStyle = 'rgba(150,168,196,0.22)'; ctx.lineWidth = row?1.5:2.4;
      ctx.beginPath(); ctx.moveTo(x0-8, baseY+2); ctx.lineTo(x0+total+8, baseY+2); ctx.stroke();
      if (!row) { var railY = baseY; var rowY = railY; }
    }
    return { xEnd: W*0.03 + 5*W*0.145*1.20, yEnd: hz + H*0.185, nearY: hz + H*0.185 };
  }

  function battery(hz, bx, by, bw, bh){
    var p = new Path2D(); var rr = 6;
    p.moveTo(bx+rr,by); p.arcTo(bx+bw,by,bx+bw,by+bh,rr); p.arcTo(bx+bw,by+bh,bx,by+bh,rr);
    p.arcTo(bx,by+bh,bx,by,rr); p.arcTo(bx,by,bx+bw,by,rr); p.closePath();
    var g = ctx.createLinearGradient(bx,by,bx+bw,by+bh);
    g.addColorStop(0,'#2a3252'); g.addColorStop(0.55,'#171d2e'); g.addColorStop(1,'#10141f');
    ctx.fillStyle = g; ctx.fill(p);
    ctx.strokeStyle = 'rgba(196,214,245,0.45)'; ctx.lineWidth = 1.6; ctx.stroke(p);
    // vents
    ctx.strokeStyle = 'rgba(196,214,245,0.16)'; ctx.lineWidth = 1;
    for (var v=0;v<4;v++){ var vy = by+bh*0.10+v*bh*0.045;
      ctx.beginPath(); ctx.moveTo(bx+bw*0.14,vy); ctx.lineTo(bx+bw*0.86,vy); ctx.stroke(); }
    // charge bars fill in sequence
    var bars = 4, bwid = bw*0.62, bh2 = bh*0.085, bxx = bx+bw*0.19;
    var phase = (t*0.0006) % (bars+1);
    for (var b=0;b<bars;b++){
      var yy = by+bh*0.34+b*(bh2*1.6);
      ctx.fillStyle = 'rgba(255,255,255,0.07)';
      ctx.fillRect(bxx,yy,bwid,bh2);
      var lit = Math.max(0, Math.min(1, phase - b));
      if (lit > 0){ ctx.fillStyle = S(0.30 + lit*0.6); ctx.fillRect(bxx,yy,bwid*lit,bh2); }
    }
    // status led + label plate
    var on = 0.45 + 0.55*Math.abs(Math.sin(t*0.0011));
    ctx.fillStyle = S(on); ctx.beginPath(); ctx.arc(bx+bw*0.5, by+bh*0.20, 3.2, 0, 6.283); ctx.fill();
    ctx.fillStyle = 'rgba(214,226,246,0.55)'; ctx.fillRect(bx+bw*0.18, by+bh*0.90, bw*0.64, 2);
  }

  function cable(x1,y1,x2,y2){
    ctx.save();
    ctx.strokeStyle = A(0.55); ctx.lineWidth = 2;
    ctx.setLineDash([7,11]); ctx.lineDashOffset = -(t*0.045)%18;
    ctx.beginPath();
    ctx.moveTo(x1,y1);
    ctx.bezierCurveTo(x1+(x2-x1)*0.4, y1+H*0.06, x2-(x2-x1)*0.35, y2-H*0.05, x2, y2);
    ctx.stroke();
    ctx.restore();
  }

  function draw(){
    var hz = H*0.585;
    var sx = W*0.74, sy = hz - H*0.075;
    ctx.clearRect(0,0,W,H);
    sky(hz,sx,sy);
    sun(hz,sx,sy);
    ground(hz);
    // shallow sun reflection streaks on the ground
    for (var s=0;s<5;s++){
      var yy = hz + H*0.02 + s*H*0.022;
      ctx.fillStyle = S(0.05 - s*0.008);
      ctx.fillRect(sx-W*0.16-s*W*0.01, yy, W*0.32+s*W*0.02, 1.5);
    }
    var end = array(hz);
    // battery cabinet on the right of the array
    var bw = Math.max(46, W*0.058), bh = Math.max(86, H*0.20);
    var bx = W*0.80, by = hz + H*0.145 - bh;
    cable(end.xEnd, end.yEnd, bx, by+bh*0.55);
    battery(hz,bx,by,bw,bh);
    // ground shadow under cabinet and array
    ctx.fillStyle = 'rgba(0,0,0,0.35)';
    ctx.beginPath(); ctx.ellipse(bx+bw*0.5, hz+H*0.152, bw*0.75, 6, 0, 0, 6.283); ctx.fill();
    // drifting dust in the light
    for (var q=0;q<motes.length;q++){
      var m = motes[q];
      var y = ((m.y + t*0.000006*m.v) % 0.52) * H;
      var x = (m.x + 0.012*Math.sin(t*0.00021*m.v + m.p)) * W;
      var a = 0.30 * (0.5 + 0.5*Math.sin(t*0.001 + m.p)) * (1 - y/(H*0.6));
      if (a <= 0) continue;
      ctx.fillStyle = 'rgba(255,238,206,'+a.toFixed(3)+')';
      ctx.beginPath(); ctx.arc(x,y,m.s,0,6.283); ctx.fill();
    }
    // vignette so the copy stays readable top-left
    var vg = ctx.createRadialGradient(W*0.55,H*0.42,Math.min(W,H)*0.22,W*0.55,H*0.5,Math.max(W,H)*0.85);
    vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1,'rgba(0,0,0,0.55)');
    ctx.fillStyle = vg; ctx.fillRect(0,0,W,H);
    var tl = ctx.createLinearGradient(0,0,0,H*0.55);
    tl.addColorStop(0,'rgba(8,10,16,0.55)'); tl.addColorStop(1,'rgba(8,10,16,0)');
    ctx.fillStyle = tl; ctx.fillRect(0,0,W,H*0.55);
  }

  function loop(ts){ if (ts) t = ts; if (visible) draw(); raf = requestAnimationFrame(loop); }
  size(); draw();
  window.addEventListener('resize', function(){ size(); draw(); });
  if (!reduce && 'IntersectionObserver' in window){
    new IntersectionObserver(function(e){ visible = e[0].isIntersecting; }, {threshold:0.02}).observe(cv);
  }
  document.addEventListener('visibilitychange', function(){ visible = !document.hidden && document.visibilityState === 'visible'; });
  if (!reduce) raf = requestAnimationFrame(loop);
})();
</script>
<style>
/* ==== LB BRAND: logo-only mode (the asset already carries the company words) ==== */
.lb-brand--logoonly .lb-brand__word{display:none !important}
.lb-brand--logoonly .lb-brand__mark{height:clamp(38px,4.6vw,64px) !important;max-width:38vw !important}
.lb-brand--logoonly .lb-brand__mark img{height:100% !important;width:auto !important;max-width:38vw !important}
</style>
<style>
/* ==== LB HEADER TRUTH: fail-safe visibility (never ship an invisible header) ==== */
header,.site-header,.page-header,.header-inner,nav.nav,.nav-inner,
.lb-brand,.lb-brand *,.lb-brand__mark,.lb-brand__word{
  opacity:1 !important;visibility:visible !important}
.lb-rv,.rv,[data-rv]{animation:lbForceIn .001s 2.5s forwards !important}
@keyframes lbForceIn{to{opacity:1 !important;transform:none !important}}
#sigSplash,#splash,.sp{animation:lbKillSplash .001s 2.5s forwards !important}
@keyframes lbKillSplash{to{opacity:0 !important;visibility:hidden !important;pointer-events:none !important}}
</style>


<style>/* ==== LB HEADER TRUTH ==== */
.lb-brand{gap:clamp(8px,1vw,14px) !important;min-height:clamp(44px,5vw,64px) !important;
  align-items:center !important;flex-wrap:nowrap !important}
.lb-brand__mark{flex:0 0 auto !important;display:flex !important;align-items:center !important;
  height:clamp(36px,4vw,52px) !important;width:auto !important;max-width:30vw !important}
.lb-brand__mark img{display:block !important;height:100% !important;width:auto !important;
  max-width:100% !important;object-fit:contain !important}
.lb-brand__word{display:flex !important;flex-direction:column !important;justify-content:center !important;
  min-width:0 !important;overflow:visible !important}
@media(max-width:700px){
  .lb-brand__mark{height:32px !important;max-width:40vw !important}
  .lb-brand__word{font-size:.92em !important}
}
</style>

<style>/* ==== LB HEADER POLISH 2 ==== */
header nav a:not(.btn):not([class*="btn"]):not([class*="cta"]),
.site-header nav a:not(.btn):not([class*="btn"]),
.header-inner nav a:not(.btn):not([class*="btn"]),
nav.nav a:not(.btn):not([class*="btn"]),
.nav-inner a:not(.btn):not([class*="btn"]),
header a[href^="tel"],.site-header a[href^="tel"]{
  color:var(--lb-name,currentColor) !important;
  opacity:1 !important;
}
.lb-brand__sub:empty{display:none !important}
</style>
<style>/* ==== TASTE PASS (anti-slop, from impeccable findings) ==== */
.lb-mq__in{display:none !important}
Colored box-shadow glow (#e0a33a) on dark page{box-shadow:none !important;text-shadow:none !important}
letter-spacing: 0.08em on body text{letter-spacing:normal !important}
letter-spacing: 0.16em on body text{letter-spacing:normal !important}
7px functional text "Bendigo" (below 11px floor){font-size:max(1em,15px) !important}
7px functional text "VIC" (below 11px floor){font-size:max(1em,15px) !important}

:root{--lb-disp:"Archivo",system-ui,sans-serif;--lb-sub:"Archivo",system-ui,sans-serif}
body,h1,h2,h3,h4,h5,h6,p,li,span,a,button,input,blockquote{
  font-family:"Archivo",system-ui,-apple-system,"Segoe UI",sans-serif}
small,.small,.meta,.caption,.eyebrow,.kicker{font-size:max(0.82em,13px)}
p,li{line-height:1.55}
section,header,footer,.wrap,.container,.inner,[class*="section"]{
  scroll-margin-top:24px}

</style>
</body>
</html>