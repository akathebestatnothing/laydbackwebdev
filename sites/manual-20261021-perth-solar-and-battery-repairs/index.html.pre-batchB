<!doctype html>
<html lang="en-AU" data-sig="links:grow,buttons:arrow,tilt:1">
<head>
<meta charset="utf-8">
<title>Perth Solar and Battery Repairs — Solar &amp; Battery Repair, Perth</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Perth Solar and Battery Repairs — solar fault finding, inverter and battery repairs, panel and mounting work across the Perth metro. Call 0427 370 805.">
<style>
:root{
  --bg:#0f1115;
  --ink:#e9eef4;
  --muted:#9aa6b2;
  --accent:#384070;
  --accent-2:#8fa2d8;
  --sun:#e9a13b;
  --panel:rgba(255,255,255,.045);
  --line:rgba(255,255,255,.14);
  --font-display:system-ui Narrow',system-ui,sans-serif;
  --font-body:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .rv{opacity:1!important;transform:none!important;transition:none!important}
}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-body);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
.header{position:sticky;top:0;z-index:100;background:rgba(15,17,21,.92);-webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);border-bottom:1px solid var(--line)}
.header-inner{max-width:1200px;margin:0 auto;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;gap:24px;height:80px}
.brand{display:flex;align-items:center;gap:.7rem;color:var(--ink);text-decoration:none}
.brand-mark{height:48px;width:auto;object-fit:contain}
.brand-txt{display:flex;flex-direction:column;line-height:1}
.brand-name{font-family:var(--font-display);font-weight:800;font-size:1.15rem;line-height:1;letter-spacing:.02em;text-transform:uppercase;color:var(--ink)}
.brand-sub{display:block;margin-top:4px;font-family:var(--font-display);font-size:.5rem;letter-spacing:.3em;text-transform:uppercase;color:var(--muted);font-weight:700}
.brand-sub em{font-style:normal;color:var(--accent)}
.nav{display:flex;align-items:center;gap:32px}
.nav a{font-size:.85rem;letter-spacing:.08em;text-transform:none;color:var(--muted);transition:color .2s ease}
.nav a:hover{color:var(--accent);text-decoration:none}
.cta-btn{display:inline-block;padding:10px 20px;background:var(--accent);color:#fff;font-weight:700;font-size:.8rem;letter-spacing:.06em;text-transform:none;border-radius:6px;transition:transform .15s ease,box-shadow .15s ease}
.cta-btn:hover{transform:translateY(-1px);box-shadow:0 4px 20px rgba(56,64,112,.55);text-decoration:none}
@media(max-width:820px){
  .brand-mark{height:48px;width:auto;object-fit:contain}
  .brand-name{font-size:1rem}
  .brand-sub{font-size:.44rem;letter-spacing:.24em;margin-top:3px}
  .header-inner{padding:0 18px;gap:.9rem;height:64px}
}
.hero{position:relative;min-height: 100vh; min-height: 100svh;display:flex;align-items:center;justify-content:center;overflow:hidden;isolation:isolate;background:#0b0e14}
.hero-bg{position:absolute;inset:0;z-index:0;background-size:cover;background-position:center;background-repeat:no-repeat;filter: brightness(0.7) contrast(1.05);}
.hero-scrim{position:absolute;inset:0;background:rgba(15,17,21,.55);z-index:1}
#sceneWrap{position:relative;height:auto;z-index:2}
#sceneSticky{position:relative;top:0;height: 100vh; height: 100svh;overflow:hidden}
#buildCanvas{position:relative;inset:0;width:100%;height:100%;display:block;opacity:0.55}
.hero-copy{position:absolute;left:50%;top:12vh;transform:translateX(-50%);max-width:28ch;text-align:center;z-index:10}
.hero-copy h1{font-family:var(--font-display);font-weight:800;font-size:clamp(2.5rem,6vw,5rem);line-height:1.02;letter-spacing:-.03em;text-transform:none;margin:0 0 12px;color:var(--ink);text-shadow:0 2px 34px rgba(0,0,0,.6)}
.hero-copy h1 em{font-style:normal;color:var(--accent-2)}
.hero-copy p{font-size:clamp(1rem,2.2vw,1.25rem);color:var(--muted);margin:0;max-width:40ch;margin-left:auto;margin-right:auto}
.hud{position:absolute;left:30px;bottom:26px;font:600 11px/1.7 ui-monospace,Menlo,monospace;letter-spacing:.18em;color:#f0f4f8;z-index:10;text-shadow:0 1px 8px rgba(0,0,0,.6)}
.hud b{display:block;color:var(--accent);font-size:13px}
.section{padding:80px 24px}
.section-inner{max-width:1060px;margin:0 auto}
.section-head{margin-bottom:40px}
.section-head h2{font-family:var(--font-display);font-weight:800;font-size:clamp(1.6rem,3.8vw,2.5rem);letter-spacing:-.02em;margin:0 0 10px;color:var(--ink)}
.section-head p{color:var(--muted);font-size:clamp(1rem,2vw,1.15rem);margin:0;max-width:56ch}
.grid{display:grid;gap:24px}
.grid-2{grid-template-columns:repeat(2,1fr)}
.grid-3{grid-template-columns:repeat(3,1fr)}
@media(max-width:860px){.grid-2,.grid-3{grid-template-columns:1fr}}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:28px;transition:border-color .2s ease}
.card:hover{border-color:var(--accent)}
.card h3{font-family:var(--font-display);font-weight:700;font-size:1.15rem;letter-spacing:-.01em;margin:0 0 10px;color:var(--ink)}
.card p{color:var(--muted);margin:0;font-size:.95rem;line-height:1.65}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:40px}
@media(max-width:720px){.stats{grid-template-columns:1fr 1fr}}
.stat{text-align:center}
.stat-num{font-family:var(--font-display);font-weight:800;font-size:clamp(2.5rem,5vw,4rem);color:var(--accent);line-height:1;letter-spacing:-.02em}
.stat-label{font-size:.8rem;letter-spacing:.12em;text-transform:none;color:var(--muted);margin-top:6px;display:block}
.about{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:start}
@media(max-width:900px){.about{grid-template-columns:1fr}}
.about h2{font-family:var(--font-display);font-weight:800;font-size:clamp(1.6rem,3.8vw,2.5rem);letter-spacing:-.02em;margin:0 0 16px;color:var(--ink)}
.about p{color:var(--muted);margin:0 0 16px;line-height:1.75}
.about ul{margin:0;padding-left:20px;color:var(--muted)}
.about li{margin-bottom:8px;line-height:1.6}
.footer{background:#0a0c0f;border-top:1px solid var(--line);padding:56px 24px 32px}
.footer-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:48px}
@media(max-width:1020px){.footer-inner{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.footer-inner{grid-template-columns:1fr}}
.footer-brand .logo{margin-bottom:12px}
.footer-brand p{color:var(--muted);font-size:.95rem;line-height:1.7;max-width:30ch}
.footer-col h4{font-size:.75rem;letter-spacing:.14em;text-transform:none;color:var(--muted);margin:0 0 16px}
.footer-col ul{list-style:none;padding:0;margin:0}
.footer-col li{margin-bottom:10px}
.footer-col a{color:var(--ink);font-size:.95rem;transition:color .2s ease}
.footer-col a:hover{color:var(--accent)}
.footer-bottom{border-top:1px solid var(--line);margin-top:40px;padding-top:24px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px;color:var(--muted);font-size:.85rem}
.footer-bottom a{color:var(--muted)}
.footer-bottom a:hover{color:var(--accent)}
.rv{opacity:0;transform:translateY(24px);transition: opacity .45s ease,transform .7s ease}
.rv.on{opacity:1;transform:none}
.rv-delay-1{transition-delay:100ms}
.rv-delay-2{transition-delay:200ms}
.rv-delay-3{transition-delay:300ms}
.rv-delay-4{transition-delay:400ms}
</style>
<style>/* de-scroll gap fix 2026-10-14 */
#sceneWrap,#sceneSticky{height:auto !important;min-height:0 !important;overflow:visible !important;}
#sceneSticky .hero-copy,#sceneWrap .hero-copy{position:relative !important;left:auto !important;top:auto !important;right:auto !important;padding:calc(var(--nav-h,64px) + 7vh) clamp(1rem,6vw,7rem) 44px !important;max-width:64ch;pointer-events:auto;}
</style>

<style>#heroCanvas{perspective:800px}</style>
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:rgba(6,7,10,.72);color:#fff;
 font-family:var(--lb-sub, system-ui), sans-serif;font-weight:600;letter-spacing:.16em;text-transform:none;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:rgba(255,255,255,.32);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:none}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in Perth{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp, system-ui), sans-serif;
 font-weight:700;text-transform:none;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-hero-css">
canvas.lb-hero-canvas{position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0; pointer-events:none}
canvas#heroCanvas, canvas.hero-canvas, canvas.lb3d-canvas{
  position:absolute; inset:0; width:100%; height:100%; display:block; z-index:0;
}
</style>
<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brandwrap{display:block;padding:14px 18px;background:inherit}
.lb-brandwrap .lb-brand{display:inline-flex}
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp, system-ui), sans-serif;font-weight:800;text-transform:none;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub, system-ui), sans-serif;font-weight:600;text-transform:none;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:transparent}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<style id="lb-hdr-stack">/* header brand must never be hidden by reveal wrappers.
   Deliberately does NOT touch position: (an existing fixed/sticky header must keep working)
   and does NOT hide the hero canvas (that is the intended 3D hero). */
.site-header,.header{z-index:50}
.container.nav,.nav,.nav-in{z-index:5}
.lb-brand,.nav__brand{position:relative;z-index:6;opacity:1 !important;visibility:visible !important;transform:none !important}
</style>
<style id="lb-repair-polish">/* the brand wordmark scales with vw (2.75vw) and runs away on wide screens, crowding the nav links. Cap it at a nav-appropriate size and keep a gap. */.lb-brand__name{font-size:clamp(18px,2vw,26px) !important}.lb-brand__word{max-width:42vw}</style><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<!--LB-EMPTY--><style id="lb-empty">[class*=btn]:empty,[class*=button]:empty,.btn:empty,.button:empty,[class*=cta]:empty,[class*=card]:empty>a:empty,[class*=img]:empty,[class*=hero-img]:empty,[class*=media]:empty:not(canvas),div[class*=box]:empty{display:none!important}</style><!--/LB-EMPTY-->

<!--LB-HERO-HEIGHT--><style id="lb-heroh">[class*=hero]{min-height:clamp(440px,58vh,600px)!important;max-height:78vh;display:flex;align-items:center}[class*=hero]>*{position:relative;z-index:2}[class*=hero]:has(canvas):before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:rgba(0,0,0,.38)}canvas.lb-hero-canvas,[class*=hero] canvas{height:100%!important}</style><!--/LB-HERO-HEIGHT-->

<!--LB-RV--><style id="lb-rv">.rv,[class~="rv"],.reveal,[data-reveal]{opacity:1!important;transform:none!important;animation:none!important;transition:none!important}</style><!--/LB-RV-->

<!--LB-HEROCOPY--><style id="lb-herocopy">[class*=hero-copy],[class*=hero__copy],[class*=hero].container>div:first-child{position:relative!important;z-index:6!important;max-width:min(780px,90vw)!important}[class*=hero-copy] h1,[class*=hero] h1{max-width:20ch!important}[class*=hero] canvas{pointer-events:none!important}[class*=hero-copy] p{max-width:56ch!important}</style><!--/LB-HEROCOPY-->

<!--LB-HEROCOPY2--><style id="lb-herocopy2">[class*=hero] canvas,canvas.lb-hero-canvas,[id*=scene] canvas{position:absolute!important;inset:0!important;z-index:0!important;pointer-events:none!important}[class*=hero-copy],[class*=hero__copy]{position:relative!important;z-index:3!important;width:min(780px,90vw)!important;max-width:none!important;flex:1 1 auto!important}[class*=hero-copy] h1{width:100%!important;max-width:none!important}</style><!--/LB-HEROCOPY2-->

<!--LB-HEROBG--><style id="lb-herobg">[class*=hero-bg],[class*=hero__bg],[class*=hero-bgimg]{z-index:-1!important;pointer-events:none!important}[class*=hero-scrim],[class*=hero__scrim]{z-index:1!important;pointer-events:none!important}[class*=hero-copy],[class*=hero__copy]{z-index:3!important}</style><!--/LB-HEROBG-->

<!--LB-CANVASZ--><style id="lb-canvasz">[class*=hero] canvas,canvas.lb-hero-canvas,#heroCanvas{position:absolute!important;inset:0!important;z-index:-1!important;pointer-events:none!important}</style><!--/LB-CANVASZ-->

<!--LB-H1W--><style id="lb-h1w">[class*=hero] h1,[class*=hero-copy] h1{max-width:none!important;width:100%!important;font-size:clamp(2.1rem,4.4vw,3.6rem)!important;line-height:1.08!important}</style><!--/LB-H1W-->

<!--LB-HEROFIX2--><style id="lb-herofix2">[class*=hero]:has([class*=hero-bg])::before,[class*=hero]:has([class*=hero-scrim])::before{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;background:rgba(0,0,0,.42)}[class*=hero-copy] h1{width:100%!important;max-width:none!important;display:block!important}</style><!--/LB-HEROFIX2-->
<style>.hero-copy{display:block!important}.hero-copy h1{font-size:clamp(2.2rem,4vw,3.4rem)!important}</style><style>.lbwm{display:none!important}</style>
<!--LB-RM--><style id="lb-rm">@media (prefers-reduced-motion: reduce){*,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}canvas{opacity:1!important}}</style><!--/LB-RM-->
</head>
<body><!-- sigSplashGuard --><script>setTimeout(function(){var s=document.getElementById('sigSplash');if(s){s.style.transition='opacity .4s';s.style.opacity='0';s.style.pointerEvents='none';setTimeout(function(){s.remove();},450);}},2000);</script>
<header class="header" role="banner">
  <div class="header-inner">
    <a class="lb-brand" href="#top" aria-label="Perth Solar and Battery Repairs - Home" style="--lb-disp:system-ui;--lb-sub:system-ui;--lb-name:#f5f5f0;--lb-subc:#f5f5f0;--lb-acc:#e9a13b;"><span class="lb-brand__mark" aria-hidden="true"><img src="assets/logomark.svg" alt="" width="44" height="44" class="lb-logomark" loading="eager" decoding="async"></span><span class="lb-brand__word"><span class="lb-brand__name">Perth Solar and Battery Repairs</span><span class="lb-brand__sub"><span class="lb-acc">Solar &amp; Battery Repair</span> &middot; Perth WA</span><span class="lb-brand__rule" aria-hidden="true"></span></span></a>
    <nav class="nav" role="navigation" aria-label="Main navigation">
      <a href="#services">Services</a>
      <a href="#faults">What we fix</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
      <a href="tel:0427370805" class="cta-btn">Call 0427 370 805</a>
    </nav>
  </div>
</header>

<main id="main">
  <section class="hero" aria-label="Solar and battery repair scene, Perth">
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="lbwm" aria-hidden="true">SOLAR</div>
    <div id="sceneWrap">
      <div id="sceneSticky">
        
        <div class="hero-copy rv rv-delay-1">
          <h1 style="width:100% !important;grid-column:1/-1 !important;max-width:none !important">Your solar has a fault.<br><em>We track it down.</em></h1>
          <p>Solar and battery repairs across the Perth metro &mdash; fault finding, inverter and battery repairs, panel and mounting work.</p>
          <a href="tel:0427370805" class="cta-btn" style="margin-top: 24px; display: inline-block;">Call 0427 370 805</a>
        </div>
        <div class="hud">
          
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="section" aria-labelledby="services-heading">
    <div class="section-inner">
      <header class="section-head rv rv-delay-1">
        <h2 id="services-heading">What we do</h2>
        <p>Solar and battery repair work on homes across the Perth metro &mdash; diagnose the fault, explain it plainly, quote the fix.</p>
      </header>
      <div class="grid grid-3">
        <article class="card rv rv-delay-1">
          <h3>Solar Fault Finding</h3>
          <p>Output dropped or the inverter is throwing a fault? We test strings, isolators and earthing and tell you exactly what has failed.</p>
        </article>
        <article class="card rv rv-delay-2">
          <h3>Inverter Repairs</h3>
          <p>Diagnosis and repair of faulty inverters, plus like-for-like replacement when a unit is beyond saving or out of support.</p>
        </article>
        <article class="card rv rv-delay-3">
          <h3>Battery Repairs</h3>
          <p>Batteries that no longer hold charge, drop out or stop backing up the house &mdash; tested, repaired or replaced safely.</p>
        </article>
        <article class="card rv rv-delay-1">
          <h3>Panel Repairs</h3>
          <p>Cracked glass, hot spots, failed optimisers and water ingress &mdash; isolated and made safe, then repaired or swapped out.</p>
        </article>
        <article class="card rv rv-delay-2">
          <h3>Roof &amp; Mounting Work</h3>
          <p>Rails re-secured, clamps and hardware replaced, and roof leaks traced back to the mounting system fixed properly.</p>
        </article>
        <article class="card rv rv-delay-3">
          <h3>System Health Checks</h3>
          <p>String testing, isolation checks and a walk of the array so you know the system is safe and producing what it should.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="faults" class="section" aria-labelledby="faults-heading">
    <div class="section-inner">
      <header class="section-head rv rv-delay-1">
        <h2 id="faults-heading">Symptoms we get called for</h2>
        <p>If any of these sound familiar, it is worth having the system looked at properly.</p>
      </header>
      <div class="grid grid-3">
        <article class="card rv rv-delay-1">
          <h3>Output has fallen away</h3>
          <p>A string has dropped off, a circuit is isolated, or the numbers no longer match a normal day. Usually a panel, an optimiser or a connection.</p>
        </article>
        <article class="card rv rv-delay-2">
          <h3>Inverter showing a fault</h3>
          <p>Error codes, overnight shutdowns or a unit that will not restart. Inverter faults can sit on either side of the box, so both get tested.</p>
        </article>
        <article class="card rv rv-delay-3">
          <h3>Battery not doing its job</h3>
          <p>Not charging, draining early, or no backup when the grid drops. Battery faults need isolation testing before anything is replaced.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="about" class="section" aria-labelledby="about-heading">
    <div class="section-inner">
      <div class="about">
        <div class="rv rv-delay-1">
          <h2 id="about-heading">Repair first, replace only when it is needed</h2>
          <p>Perth Solar and Battery Repairs is a Perth-based repair crew working on solar and battery systems on homes across the metro. The job is to find what has actually failed &mdash; string by string if that is what it takes &mdash; and fix that, not sell a whole new system.</p>
          <p>You get a plain explanation of the fault, a written scope and a price before any work starts. If a part has failed and replacements are the only answer, you will be told why, with the model and the warranty terms in front of you.</p>
          <ul>
            <li>Residential rooftop and ground-mount systems</li>
            <li>Inverter, battery, panel and wiring fault diagnosis</li>
            <li>Callouts across the Perth metro</li>
            <li>Written scope and price before work begins</li>
          </ul>
        </div>
        <div class="rv rv-delay-2">
          <div class="card" style="height:100%">
            <h3>Contact</h3>
            <p style="margin-bottom:16px"><strong>Phone</strong><br><a href="tel:0427370805">0427 370 805</a></p>
            <p style="margin-bottom:16px"><strong>Location</strong><br>Perth WA &mdash; metro callouts</p>
            <p><a href="https://www.facebook.com/people/Perth-Solar-and-Battery-repairs/61556278010703/" target="_blank" rel="noopener">Find us on Facebook &rarr;</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-heading" style="padding-bottom:40px">
    <div class="section-inner">
      <header class="section-head rv rv-delay-1">
        <h2 id="contact-heading">Book a repair</h2>
        <p>Tell us what the system is doing and where you are. If it is urgent, call and we will get back to you.</p>
      </header>
      <div class="grid grid-2">
        <div class="card rv rv-delay-1">
          <h3>Call or message</h3>
          <p style="margin:0 0 16px">Fastest way to get a fault looked at.</p>
          <p><a href="tel:0427370805" style="font-size:1.5rem;font-weight:700;font-family:var(--font-display);color:var(--accent-2)">0427 370 805</a></p>
          <p style="margin-top:12px"><a href="https://www.facebook.com/people/Perth-Solar-and-Battery-repairs/61556278010703/" target="_blank" rel="noopener">Message us on Facebook</a></p>
        </div>
        <div class="card rv rv-delay-2">
          <h3>Prefer to write it down</h3>
          <p style="margin:0 0 16px">Send the details below &mdash; the inverter brand, the fault, the suburb &mdash; and we will respond with next steps.</p>
          <a href="#lbq" class="cta-btn" style="display:inline-block;width:100%;text-align:center">Send the details</a>
        </div>
      </div>
    </div>
  </section>
</main>

