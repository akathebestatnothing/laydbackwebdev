#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:#babbbc;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
