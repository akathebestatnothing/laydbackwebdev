function animate(ts){
  if(!isFinite(ts))ts=0;
  var rect=wrap.getBoundingClientRect();
  var span=wrap.offsetHeight-sticky.offsetHeight;
  var p2=CL(-rect.top/Math.max(1,span),0,1);
  smoothP+=(p2-smoothP)*0.10;
  if(Math.abs(smoothP-p2)<0.0004)smoothP=p2;
  draw(smoothP);
  requestAnimationFrame(animate);
}
