    S.texture([S.project(-60, 0, 58), S.project(60, 0, 58), S.project(60, 0, 2), S.project(-60, 0, 2)], 'grain', 380, .025);
  }

  function grade(time) {
    var ctx = S.ctx;
    // Cool overcast grade - no warm rim
    var rim = ctx.createLinearGradient(0, 0, S.W, S.H);
    rim.addColorStop(0, 'rgba(195,200,204,.05)');
    rim.addColorStop(0.5, 'rgba(195,200,204,0)');
    rim.addColorStop(1, 'rgba(60,70,85,.04)');
    ctx.fillStyle = rim; ctx.fillRect(0, 0, S.W, S.H);
    S.dust(28, time);  // fewer dust motes in overcast
    S.grade();
  }

  /* ---------- SUBJECT: TIGHT-ACCESS EXCAVATOR COMBO ---------- */
  function drawSubject(p, time) {
    var ctx = S.ctx;
    
    // Stage timing - four acts
    var t1 = PS.stage(p, 0.00, 0.22, 'place'),   // access set - excavator enters gate
        t2 = PS.stage(p, 0.20, 0.28, 'settle'),   // digging - slews, digs
        t3 = PS.stage(p, 0.45, 0.30, 'place'),    // loading out - slews to tipper, loads
        t4 = PS.stage(p, 0.72, 0.28, 'release');  // tracked out - tipper leaves, excavator exits

    // ===== GROUND PLANE =====
    // Main access strip between fences
    var accessPts = [
      S.project(-5.5, 0.002, 18), S.project(5.5, 0.002, 18),
      S.project(5.5, 0.002, -6), S.project(-5.5, 0.002, -6)
    ];
    S.poly(accessPts, DIRT_D, null, 1);
    S.mottle(accessPts, DIRT, .08, 20);
    S.texture(accessPts, 'streak', 200, .035);
    S.contactAO(0, 6, 5.5, 12, .35);

    // Street area beyond gate (where tipper sits)
    var streetPts = [
      S.project(-12, 0.002, -6), S.project(12, 0.002, -6),
      S.project(12, 0.002, -14), S.project(-12, 0.002, -14)
    ];
    S.poly(streetPts, PS.mix(DIRT_D, '#2a2a2a', .3), null, 1);
    S.mottle(streetPts, '#2a2a2a', .06, 16);
    S.texture(streetPts, 'aggregate', 180, .03);

    // ===== FENCE LINES (the tight access constraint) =====
    // Left fence
    var fenceLPosts = [], fenceLTop = [], fenceLBot = [];
    for (var z = -6; z <= 18; z += 1.8) {
      var base = S.project(-5.5, 0, z), top = S.project(-5.5, 2.2, z);
      fenceLPosts.push([base, top]);
      fenceLTop.push(top);
      fenceLBot.push(base);
    }
    // Fence rails (3 horizontal)
    for (var rh = 0.5; rh <= 2.0; rh += 0.75) {
      var railPts = [];
      for (var z = -6; z <= 18; z += 0.3) {
        railPts.push(S.project(-5.5, rh, z));
      }
      if (railPts.length > 1) {
        ctx.strokeStyle = S.rgba(FENCE, 0.7);
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(railPts[0][0], railPts[0][1]);
        for (var i = 1; i < railPts.length; i++) ctx.lineTo(railPts[i][0], railPts[i][1]);
        ctx.stroke();
      }
    }
    // Fence posts
    fenceLPosts.forEach(function(pt) {
      ctx.strokeStyle = S.rgba(FENCE_D, 0.9);
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(pt[0][0], pt[0][1]);
      ctx.lineTo(pt[1][0], pt[1][1]);
      ctx.stroke();
    });
    S.shadow(-5.5, 6, 0.1, 12, .35);
    S.contactAO(-5.5, 6, 0.1, 12, .25);

    // Right fence
    var fenceRPosts = [];
    for (var z = -6; z <= 18; z += 1.8) {
      var base = S.project(5.5, 0, z), top = S.project(5.5, 2.2, z);
      fenceRPosts.push([base, top]);
    }
    for (var rh = 0.5; rh <= 2.0; rh += 0.75) {
      var railPts = [];
      for (var z = -6; z <= 18; z += 0.3) {
        railPts.push(S.project(5.5, rh, z));
      }
      if (railPts.length > 1) {
        ctx.strokeStyle = S.rgba(FENCE, 0.7);
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(railPts[0][0], railPts[0][1]);
        for (var i = 1; i < railPts.length; i++) ctx.lineTo(railPts[i][0], railPts[i][1]);
        ctx.stroke();
      }
    }
    fenceRPosts.forEach(function(pt) {
      ctx.strokeStyle = S.rgba(FENCE_D, 0.9);
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(pt[0][0], pt[0][1]);
      ctx.lineTo(pt[1][0], pt[1][1]);
      ctx.stroke();
    });
    S.shadow(5.5, 6, 0.1, 12, .35);
    S.contactAO(5.5, 6, 0.1, 12, .25);

    // Gate posts at street end (z = -6)
    var gateL = S.project(-5.5, 0, -6), gateLTop = S.project(-5.5, 2.4, -6);
    var gateR = S.project(5.5, 0, -6), gateRTop = S.project(5.5, 2.4, -6);
    ctx.strokeStyle = S.rgba(FENCE_D, 1);
    ctx.lineWidth = 4;
    ctx.beginPath(); ctx.moveTo(gateL[0], gateL[1]); ctx.lineTo(gateLTop[0], gateLTop[1]); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(gateR[0], gateR[1]); ctx.lineTo(gateRTop[0], gateRTop[1]); ctx.stroke();
    // Cross beam
    ctx.strokeStyle = S.rgba(FENCE, 0.8);
    ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(gateLTop[0], gateLTop[1]); ctx.lineTo(gateRTop[0], gateRTop[1]); ctx.stroke();

    // ===== EXCAVATOR (1.5-3t class, zero tail swing) =====
    // Position: starts at gate (z=-2), tracks down to z=8, slews to load tipper at z=-2
    var excZ, excX = 0;
    if (p < 0.22) {
      // Stage 1: entering gate, tracking down access
      excZ = -2 + (8 - (-2)) * PS.ease.inOut(t1);
    } else if (p < 0.48) {
      // Stage 2: at dig position (z=8), slewing/digging
      excZ = 8;
    } else if (p < 0.72) {
      // Stage 3: slewing to tipper (z=-2)
      excZ = 8 + (-2 - 8) * PS.ease.inOut(t3);
    } else {
      // Stage 4: tracking out through gate
      excZ = -2 + (-6 - (-2)) * PS.ease.out(t4);
    }

    // Excavator body (house) - zero tail swing, compact
    var houseY = 1.1, houseH = 1.2, houseW = 1.7, houseL = 1.0;
    var housePts = [
      S.project(excX - houseW/2, houseY, excZ - houseL/2),
      S.project(excX + houseW/2, houseY, excZ - houseL/2),
      S.project(excX + houseW/2, houseY + houseH, excZ - houseL/2),
      S.project(excX - houseW/2, houseY + houseH, excZ - houseL/2)
    ];
    S.shadow(excX, excZ, houseW/2, houseL/2, 0.45);
    S.contactAO(excX, excZ, houseW/2 + 0.2, houseL/2 + 0.2, .3);
    // House faces with materiality
    var houseFaces = [
      { pts: [housePts[0], housePts[1], S.project(excX + houseW/2, houseY + houseH, excZ + houseL/2), S.project(excX - houseW/2, houseY + houseH, excZ + houseL/2)], normal: [0,0,1] }, // front
      { pts: [housePts[1], S.project(excX + houseW/2, houseY, excZ + houseL/2), S.project(excX + houseW/2, houseY + houseH, excZ + houseL/2), housePts[2]], normal: [1,0,0] }, // right
      { pts: [S.project(excX - houseW/2, houseY, excZ + houseL/2), housePts[0], housePts[3], S.project(excX - houseW/2, houseY + houseH, excZ + houseL/2)], normal: [-1,0,0] }, // left
      { pts: [S.project(excX - houseW/2, houseY, excZ + houseL/2), S.project(excX + houseW/2, houseY, excZ + houseL/2), S.project(excX + houseW/2, houseY + houseH, excZ + houseL/2), S.project(excX - houseW/2, houseY + houseH, excZ + houseL/2)], normal: [0,1,0] } // top
    ];
    houseFaces.forEach(function(face) {
      var lam = Math.max(0, face.normal[0]*0.3 + face.normal[1]*0.8 + face.normal[2]*0.3);
      var sh = 0.5 + 0.5 * lam; // diffuse overcast lighting
      var col = PS.mix(STEEL, STEEL_L, sh * 0.3);
      S.poly(face.pts, col, null, 1);
      S.texture(face.pts, 'grain', 80, .03);
    });
    // Cab window
    var cabPts = [
      S.project(excX - 0.5, houseY + 0.2, excZ - houseL/2 + 0.1),
      S.project(excX + 0.5, houseY + 0.2, excZ - houseL/2 + 0.1),
      S.project(excX + 0.5, houseY + 0.9, excZ - houseL/2 + 0.1),
      S.project(excX - 0.5, houseY + 0.9, excZ - houseL/2 + 0.1)
    ];
    S.poly(cabPts, S.rgba(CAB, 0.6), S.rgba(STEEL_L, 0.3), 1);

    // Tracks (undercarriage)
    var trackW = 0.35, trackL = 1.3, trackH = 0.55, trackGap = 1.1;
    [-trackGap/2, trackGap/2].forEach(function(tx) {
      var trPts = [
        S.project(excX + tx - trackW/2, 0.05, excZ - trackL/2),
        S.project(excX + tx + trackW/2, 0.05, excZ - trackL/2),
        S.project(excX + tx + trackW/2, trackH, excZ - trackL/2),
        S.project(excX + tx - trackW/2, trackH, excZ - trackL/2)
      ];
      S.poly(trPts, TRACK, null, 1);
      S.texture(trPts, 'streak', 60, .04);
      // Track pads
      for (var tp = 0; tp < 8; tp++) {
        var padZ = excZ - trackL/2 + trackL * tp / 7;
        var padPts = [
          S.project(excX + tx - trackW/2, trackH, padZ),
          S.project(excX + tx + trackW/2, trackH, padZ),
          S.project(excX + tx + trackW/2, trackH, padZ + trackL/7),
          S.project(excX + tx - trackW/2, trackH, padZ + trackL/7)
        ];
        S.poly(padPts, TRACK_D, null, 1);
      }
    });
    S.shadow(excX, excZ, trackGap/2 + trackW/2, trackL/2, .5);
    S.contactAO(excX, excZ, trackGap/2 + trackW/2, trackL/2 + 0.2, .4);

    // ===== BOOM, ARM, BUCKET (animated) =====
    // Boom pivot at rear of house
    var pivotX = excX, pivotY = houseY + houseH - 0.15, pivotZ = excZ - houseL/2 + 0.1;
    
    // Boom angle: starts low, raises to dig, then slews to tipper
    var boomAng, armAng, bucketAng;
    if (p < 0.22) {
      // Transport position
      boomAng = -0.25; armAng = 0.6; bucketAng = -0.3;
    } else if (p < 0.48) {
      // Digging cycle
      var digCycle = (t2 * 3) % 1; // 3 dig cycles
      boomAng = -0.55 + Math.sin(digCycle * 6.28) * 0.15;
      armAng = 1.1 + Math.sin(digCycle * 6.28 + 1.5) * 0.25;
      bucketAng = -0.4 + Math.sin(digCycle * 6.28 + 3) * 0.2;
    } else if (p < 0.72) {
      // Slewing to tipper, dumping
      var swingProg = PS.ease.inOut(t3);
      boomAng = -0.3 + swingProg * 0.4;
      armAng = 0.8 - swingProg * 0.6;
      bucketAng = -0.2 + swingProg * 1.2; // dump
    } else {
      // Transport out
      boomAng = 0.1; armAng = 0.4; bucketAng = -0.3;
    }

    // Boom (length ~3.2m)
    var boomL = 3.2, boomW = 0.16;
    var boomEndX = pivotX + Math.sin(boomAng) * 0, // boom swings in YZ plane primarily
        boomEndY = pivotY + Math.cos(boomAng) * boomL,
        boomEndZ = pivotZ - Math.sin(boomAng) * boomL;
    var boomPts = [
      S.project(pivotX - boomW/2, pivotY, pivotZ),
      S.project(pivotX + boomW/2, pivotY, pivotZ),
      S.project(excX + boomW/2, boomEndY, boomEndZ),
      S.project(excX - boomW/2, boomEndY, boomEndZ)
    ];
    S.poly(boomPts, STEEL, null, 1);
    S.texture(boomPts, 'streak', 50, .04);
    S.rim(boomPts[0], boomPts[3], S.rgba(SKY_HAZE, 0.15), 0.8, 1.5);

    // Arm (length ~2.0m)
    var armL = 2.0, armW = 0.13;
    var armEndY = boomEndY + Math.cos(boomAng + armAng) * armL,
        armEndZ = boomEndZ - Math.sin(boomAng + armAng) * armL;
    var armPts = [
      S.project(excX - armW/2, boomEndY, boomEndZ),
      S.project(excX + armW/2, boomEndY, boomEndZ),
      S.project(excX + armW/2, armEndY, armEndZ),
      S.project(excX - armW/2, armEndY, armEndZ)
    ];
    S.poly(armPts, STEEL, null, 1);
    S.texture(armPts, 'streak', 40, .04);
    S.rim(armPts[0], armPts[3], S.rgba(SKY_HAZE, 0.12), 0.6, 1.2);

    // Bucket (accent red - the Allway brand color)
    var bucketW = 0.55, bucketH = 0.45, bucketD = 0.6;
    var bucketPts = [
      S.project(excX - bucketW/2, armEndY - bucketH/2, armEndZ - bucketD/2),
      S.project(excX + bucketW/2, armEndY - bucketH/2, armEndZ - bucketD/2),
      S.project(excX + bucketW/2, armEndY + bucketH/2, armEndZ - bucketD/2),
      S.project(excX - bucketW/2, armEndY + bucketH/2, armEndZ - bucketD/2),
      S.project(excX - bucketW/2, armEndY - bucketH/2, armEndZ + bucketD/2),
      S.project(excX + bucketW/2, armEndY - bucketH/2, armEndZ + bucketD/2),
      S.project(excX + bucketW/2, armEndY + bucketH/2, armEndZ + bucketD/2),
      S.project(excX - bucketW/2, armEndY + bucketH/2, armEndZ + bucketD/2)
    ];
    var FACES = [[0,1,2,3],[4,5,6,7],[0,4,7,3],[1,5,6,2],[0,1,5,4],[3,2,6,7]];
    var bucketCol = (p >= 0.45 && p < 0.72) ? '#ff3333' : '#cc0000'; // brighter when loading
    FACES.forEach(function(fi, fiIdx) {
      var facePts = [bucketPts[fi[0]], bucketPts[fi[1]], bucketPts[fi[2]], bucketPts[fi[3]]];
      var lam = 0.5 + 0.3 * Math.sin(fiIdx); // diffuse
      var fc = PS.mix(bucketCol, PS.lighten(bucketCol, 0.3), lam * 0.4);
      S.poly(facePts, fc, null, 1);
      if (fiIdx === 0 || fiIdx === 1) {
        S.texture(facePts, 'grain', 30, .04);
      }
    });
    // Bucket cutting edge
    ctx.strokeStyle = S.rgba('#880000', 0.8);
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(bucketPts[0][0], bucketPts[0][1]);
    ctx.lineTo(bucketPts[1][0], bucketPts[1][1]);
    ctx.stroke();

    // Hydraulic hoses (subtle)
    ctx.strokeStyle = S.rgba(HYD, 0.4);
    ctx.lineWidth = 1.5;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(boomPts[0][0], boomPts[0][1]);
    ctx.lineTo(armPts[0][0], armPts[0][1]);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(armPts[0][0], armPts[0][1]);
    ctx.lineTo(bucketPts[0][0], bucketPts[0][1]);
    ctx.stroke();

    // ===== TIPPER TRUCK (waiting on street at z=-4 to -8) =====
    var tipperZ, tipperX = 4.8; // offset to right side of access
    if (p < 0.45) {
      tipperZ = -4; // waiting
    } else if (p < 0.72) {
      // Being loaded, then pulling away
      tipperZ = -4 + (-10 - (-4)) * PS.ease.out(t3);
    } else {
      tipperZ = -10; // gone
    }

    // Tipper chassis
    var tipW = 2.4, tipL = 5.5, tipH = 0.6;
    var tipChassisPts = [
      S.project(tipperX - tipW/2, tipH, tipperZ - tipL/2),
      S.project(tipperX + tipW/2, tipH, tipperZ - tipL/2),
      S.project(tipperX + tipW/2, tipH, tipperZ + tipL/2),
      S.project(tipperX - tipW/2, tipH, tipperZ + tipL/2)
    ];
    S.shadow(tipperX, tipperZ, tipW/2, tipL/2, 0.4);
    S.contactAO(tipperX, tipperZ, tipW/2 + 0.3, tipL/2 + 0.3, .3);
    S.poly(tipChassisPts, STEEL_D, null, 1);
    S.texture(tipChassisPts, 'streak', 80, .03);

    // Tipper tray (body)
    var trayH = 1.8, trayY = tipH + trayH/2;
    var trayPts = [
      S.project(tipperX - tipW/2 + 0.1, trayY - trayH/2, tipperZ - tipL/2 + 0.3),
      S.project(tipperX + tipW/2 - 0.1, trayY - trayH/2, tipperZ - tipL/2 + 0.3),
      S.project(tipperX + tipW/2 - 0.1, trayY + trayH/2, tipperZ - tipL/2 + 0.3),
      S.project(tipperX - tipW/2 + 0.1, trayY + trayH/2, tipperZ - tipL/2 + 0.3),
      S.project(tipperX - tipW/2 + 0.1, trayY - trayH/2, tipperZ + tipL/2 - 0.3),
      S.project(tipperX + tipW/2 - 0.1, trayY - trayH/2, tipperZ + tipL/2 - 0.3),
      S.project(tipperX + tipW/2 - 0.1, trayY + trayH/2, tipperZ + tipL/2 - 0.3),
      S.project(tipperX - tipW/2 + 0.1, trayY + trayH/2, tipperZ + tipL/2 - 0.3)
    ];
    var TIPFACES = [[0,1,2,3],[4,5,6,7],[0,4,7,3],[1,5,6,2],[0,1,5,4],[3,2,6,7]];
    TIPFACES.forEach(function(fi, fiIdx) {
      var facePts = [trayPts[fi[0]], trayPts[fi[1]], trayPts[fi[2]], trayPts[fi[3]]];
      var lam = 0.45 + 0.3 * (fiIdx % 3);
      var fc = PS.mix(STEEL, STEEL_L, lam * 0.4);
      S.poly(facePts, fc, null, 1);
      if (fiIdx === 4) { // top - gets spoil
        S.texture(facePts, 'aggregate', 120, .04);
      } else {
        S.texture(facePts, 'streak', 60, .03);
      }
    });

    // Tipper cab
    var cabW = 2.2, cabH = 1.6, cabL = 2.0;
    var cabPts = [
      S.project(tipperX - cabW/2, tipH + cabH/2, tipperZ - tipL/2 - cabL/2),
      S.project(tipperX + cabW/2, tipH + cabH/2, tipperZ - tipL/2 - cabL/2),
      S.project(tipperX + cabW/2, tipH + cabH, tipperZ - tipL/2 - cabL/2),
      S.project(tipperX - cabW/2, tipH + cabH, tipperZ - tipL/2 - cabL/2),
      S.project(tipperX - cabW/2, tipH + cabH/2, tipperZ - tipL/2 + cabL/2),
      S.project(tipperX + cabW/2, tipH + cabH/2, tipperZ - tipL/2 + cabL/2),
      S.project(tipperX + cabW/2, tipH + cabH, tipperZ - tipL/2 + cabL/2),
      S.project(tipperX - cabW/2, tipH + cabH, tipperZ - tipL/2 + cabL/2)
    ];
    TIPFACES.forEach(function(fi, fiIdx) {
      var facePts = [cabPts[fi[0]], cabPts[fi[1]], cabPts[fi[2]], cabPts[fi[3]]];
      var lam = 0.5 + 0.25 * (fiIdx % 3);
      var fc = PS.mix(STEEL_D, STEEL, lam * 0.3);
      S.poly(facePts, fc, null, 1);
    });
    // Cab window
    var winPts = [
      S.project(tipperX - 0.6, tipH + 0.8, tipperZ - tipL/2 - cabL/2 + 0.1),
      S.project(tipperX + 0.6, tipH + 0.8, tipperZ - tipL/2 - cabL/2 + 0.1),
      S.project(tipperX + 0.6, tipH + 1.4, tipperZ - tipL/2 - cabL/2 + 0.1),
      S.project(tipperX - 0.6, tipH + 1.4, tipperZ - tipL/2 - cabL/2 + 0.1)
    ];
    S.poly(winPts, S.rgba(CAB, 0.5), S.rgba(STEEL_L, 0.2), 1);

    // Tipper wheels (4 rear, 2 front)
    var wheelR = 0.55, wheelW = 0.35;
    [[tipperX - 1.1, tipH - 0.1, tipperZ + tipL/2 - 0.8],
     [tipperX + 1.1, tipH - 0.1, tipperZ + tipL/2 - 0.8],
     [tipperX - 1.1, tipH - 0.1, tipperZ + tipL/2 - 2.2],
     [tipperX + 1.1, tipH - 0.1, tipperZ + tipL/2 - 2.2],
     [tipperX - 1.1, tipH - 0.1, tipperZ - tipL/2 + 0.8],
     [tipperX + 1.1, tipH - 0.1, tipperZ - tipL/2 + 0.8]].forEach(function(w) {
      var wx = w[0], wy = w[1], wz = w[2];
      var wPts = [
        S.project(wx - wheelR, wy, wz), S.project(wx + wheelR, wy, wz),
        S.project(wx + wheelR, wy + wheelR, wz), S.project(wx - wheelR, wy + wheelR, wz)
      ];
      S.poly(wPts, TRACK, null, 1);
      S.texture(wPts, 'grain', 20, .05);
      S.shadow(wx, wz, wheelR, wheelW, .4);
    });

    // ===== SPOIL PARTICLES (loading into tipper) =====
    if (p >= 0.48 && p < 0.72) {
      var loadProg = PS.clamp((p - 0.48) / 0.24, 0, 1);
      var numParticles = Math.round(18 * loadProg);
      for (var sp = 0; sp < numParticles; sp++) {
        var spSeed = sp * 73;
        var spTime = time * 0.002 + spSeed * 0.01;
        // Arc from bucket to tipper tray
        var bucketPos = [excX, armEndY, armEndZ];
        var trayCenterY = trayY, trayCenterZ = tipperZ;
        var arcT = (sp / Math.max(1, numParticles - 1)) * 0.8 + loadProg * 0.2;
        arcT = PS.clamp(arcT, 0, 1);
        var sx = PS.lerp(bucketPos[0], tipperX, arcT) + Math.sin(spTime) * 0.15;
        var sy = PS.lerp(bucketPos[1], trayCenterY + 0.5, arcT) + Math.cos(spTime * 1.3) * 0.2;
        var sz = PS.lerp(bucketPos[2], trayCenterZ, arcT);
        var pPt = S.project(sx, sy, sz);
        if (pPt && pPt[0] > 0 && pPt[0] < S.W && pPt[1] > 0 && pPt[1] < S.H) {
          var ps = S.focal / Math.max(4, sz);
          var pr = 1.2 + (sp % 3) * 0.6;
          ctx.fillStyle = S.rgba(SPOIL, 0.85 * (1 - arcT * 0.5));
          ctx.beginPath(); ctx.arc(pPt[0], pPt[1], pr * ps, 0, 6.2832); ctx.fill();
        }
      }
    }

    // Spoil pile in tray (accumulates)
    if (p >= 0.55) {
      var pileProg = PS.clamp((p - 0.55) / 0.17, 0, 1);
      var pileH = trayH * 0.7 * pileProg;
      var pilePts = [
        S.project(tipperX - tipW/2 + 0.2, trayY + pileH/2, tipperZ - tipL/2 + 0.5),
        S.project(tipperX + tipW/2 - 0.2, trayY + pileH/2, tipperZ - tipL/2 + 0.5),
        S.project(tipperX + tipW/2 - 0.2, trayY + pileH/2, tipperZ + tipL/2 - 0.5),
        S.project(tipperX - tipW/2 + 0.2, trayY + pileH/2, tipperZ + tipL/2 - 0.5)
      ];
      S.poly(pilePts, SPOIL, null, 1);
      S.mottle(pilePts, SPOIL, .12, 18);
      S.texture(pilePts, 'aggregate', 160, .05);
      S.rim(pilePts[0], pilePts[1], S.rgba(SKY_HAZE, 0.1), 0.5, 1.5);
    }

    // ===== SCALE CUE (traffic cone at gate) =====
    S.scaleCue(6.5, -7, 'cone');

    // ===== AMBIENT DETAILS =====
    // Hydraulic lines on excavator
    if (p > 0.15) {
      ctx.strokeStyle = S.rgba(HYD, 0.35);
      ctx.lineWidth = 1.2;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(boomPts[0][0], boomPts[0][1]);
      ctx.lineTo(boomPts[3][0], boomPts[3][1]);
      ctx.stroke();
    }

    // Excavator tracks marks in the dirt (faint)
    if (p > 0.25) {
      ctx.strokeStyle = S.rgba('#1a1a1a', 0.12);
      ctx.lineWidth = 3;
      for (var tm = 0; tm < 2; tm++) {
        var tx = excX + (tm === 0 ? -0.7 : 0.7);
        ctx.beginPath();
        ctx.moveTo(S.project(tx, 0.01, excZ - 3)[0], S.project(tx, 0.01, excZ - 3)[1]);
        ctx.lineTo(S.project(tx, 0.01, excZ + 2)[0], S.project(tx, 0.01, excZ + 2)[1]);
        ctx.stroke();
      }
    }
  }

  /* ---------- MAIN FRAME ---------- */
  function frame(S_, p, time) {
    S = S_;
    env(time);
    drawSubject(p, time);
    grade(time);

    // HUD stage updates
    var idx = p < 0.20 ? 0 : p < 0.45 ? 1 : p < 0.72 ? 2 : 3;
    if (stgNum) stgNum.textContent = '0' + (idx + 1);
    if (stgName) stgName.textContent = ['Access set', 'Digging', 'Loading out', 'Tracked out'][idx];
    if (railFill) railFill.style.width = Math.round(p * 100) + '%';
    if (heroCopy) heroCopy.style.opacity = PS.clamp(1 - p * 2.4, 0, 1);
  }

  S.start();
})();
</script>
<script>
/* ---- page glue (reveal + nav) preserved through the scene retrofit ---- */
(function(){var rvs=[].slice.call(document.querySelectorAll('.rv'));
if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(en){
if(en.isIntersecting){en.target.classList.add('on');io.unobserve(en.target);}});},{rootMargin:'0px 0px -12% 0px',threshold:0.08});
rvs.forEach(function(el){io.observe(el);});}else{rvs.forEach(function(el){el.classList.add('on');});}
setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200);
var b=document.getElementById('burger'),n=document.getElementById('navlinks');
if(b&&n){b.addEventListener('click',function(){var o=n.classList.toggle('open');b.setAttribute('aria-expanded',o?'true':'false');});
n.addEventListener('click',function(e){if(e.target.tagName==='A')n.classList.remove('open');});}
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();})();
</script>

