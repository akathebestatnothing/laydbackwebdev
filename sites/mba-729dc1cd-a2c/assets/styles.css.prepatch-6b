/* ==========================================================================
   ARC-SEAM DESIGN SYSTEM — Kinetic Building Pty Ltd
   Dark steel fabrication, electric welding aesthetic
   ========================================================================== */

/* --------------------------------------------------------------------------
   CSS CUSTOM PROPERTIES (Design Tokens)
   -------------------------------------------------------------------------- */
:root {
  /* Field colours */
  --field-gunmetal: #191d21;
  --field-deep: #14171a;
  --field-steel-body: #aeb6bd;
  --field-arc-blue: #6fb4f2;
  --field-sparks: #f5f8fb;
  --field-rules: #5c666e;

  /* Semantic aliases */
  --bg-primary: var(--field-gunmetal);
  --bg-deep: var(--field-deep);
  --text-primary: var(--field-sparks);
  --text-body: var(--field-steel-body);
  --accent: var(--field-arc-blue);
  --rule: var(--field-rules);

  /* Typography */
  --font-display: 'Sora', system-ui, sans-serif;
  --font-mono: 'Azeret Mono', ui-monospace, SFMono-Regular, monospace;
  --font-body: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

  /* Sizing */
  --max-width: 720px;
  --header-h: 64px;
  --hero-min-h: 520px;
  --section-space: 96px;
  --container-pad: 32px;

  /* Motion */
  --reveal-dur: 700ms;
  --reveal-ease: cubic-bezier(0.16, 1, 0.3, 1);
  --glow-dur: 4s;
}

/* --------------------------------------------------------------------------
   RESET & BASE
   -------------------------------------------------------------------------- */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }
html.no-js .rv { opacity: 1 !important; transform: none !important; }
html.js .rv { opacity: 0; transform: translateY(24px); transition: opacity var(--reveal-dur) var(--reveal-ease), transform var(--reveal-dur) var(--reveal-ease); }
html.js .rv.on { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  html.js .rv { transition: none; opacity: 1; transform: none; }
  .hero-glow, .hero-sparks { animation: none !important; }
}

body {
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.65;
  color: var(--text-body);
  background: var(--bg-primary);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Skip link */
.skip-link {
  position: absolute; top: -100%; left: 50%; transform: translateX(-50%);
  background: var(--accent); color: var(--bg-primary); padding: 12px 24px;
  font-weight: 600; border-radius: 0 0 8px 8px; z-index: 1000; text-decoration: none;
}
.skip-link:focus { top: 0; }

/* Selection */
::selection { background: var(--accent); color: var(--bg-primary); }

/* --------------------------------------------------------------------------
   HEADER
   -------------------------------------------------------------------------- */
.site-header {
  position: fixed; top: 0; left: 0; right: 0; height: var(--header-h);
  background: linear-gradient(180deg, var(--bg-primary) 0%, rgba(25,29,33,0.92) 100%);
  border-bottom: 1px solid var(--rule);
  z-index: 100;
}
.header-inner {
  max-width: var(--max-width); margin: 0 auto; padding: 0 var(--container-pad);
  height: 100%; display: flex; justify-content: space-between; align-items: center;
}
.site-id {
  font-family: var(--font-mono); font-size: 0.625rem; font-weight: 500;
  letter-spacing: 0.18em; color: var(--rule); text-transform: uppercase;
}
.header-phone {
  font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 500;
  color: var(--accent); text-decoration: none; transition: opacity 0.2s;
}
.header-phone:hover, .header-phone:focus { opacity: 0.7; outline: none; }
.header-phone:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

/* --------------------------------------------------------------------------
   HERO
   -------------------------------------------------------------------------- */
.hero { min-height: var(--hero-min-h); display: flex; align-items: center; justify-content: center; padding: calc(var(--header-h) + 40px) var(--container-pad) 80px; position: relative; overflow: hidden; }
.hero-plate { position: relative; max-width: var(--max-width); width: 100%; text-align: center; }

/* Radial arc glow behind title */
.hero-glow {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 600px; height: 600px; border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(111,180,242,0.18) 0%, rgba(111,180,242,0.06) 40%, transparent 70%);
  pointer-events: none; animation: glow-pulse var(--glow-dur) ease-in-out infinite;
}
@keyframes glow-pulse { 0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.08); } }

/* Spark cluster */
.hero-sparks {
  position: absolute; top: 50%; left: 50%; width: 400px; height: 300px;
  transform: translate(-50%, -50%); pointer-events: none;
  background-image:
    radial-gradient(2px 2px at 15% 25%, var(--field-sparks) 50%, transparent),
    radial-gradient(1.5px 1.5px at 82% 18%, var(--field-sparks) 50%, transparent),
    radial-gradient(2px 2px at 45% 65%, var(--field-sparks) 50%, transparent),
    radial-gradient(1px 1px at 70% 72%, var(--field-sparks) 50%, transparent),
    radial-gradient(2.5px 2.5px at 28% 80%, var(--field-sparks) 50%, transparent),
    radial-gradient(1.5px 1.5px at 90% 45%, var(--field-sparks) 50%, transparent),
    radial-gradient(2px 2px at 12% 60%, var(--field-sparks) 50%, transparent),
    radial-gradient(1px 1px at 55% 12%, var(--field-sparks) 50%, transparent);
  background-repeat: no-repeat; animation: spark-drift 6s ease-in-out infinite;
}
@keyframes spark-drift { 0%, 100% { transform: translate(-50%, -50%) translateY(0) scale(1); opacity: 0.7; } 50% { transform: translate(-50%, -50%) translateY(-12px) scale(1.05); opacity: 1; } }

.hero-title {
  font-family: var(--font-display); font-size: clamp(3rem, 8vw, 5.5rem);
  font-weight: 700; letter-spacing: -0.02em; line-height: 1.05;
  color: var(--text-primary); position: relative; z-index: 1;
  text-shadow: 0 0 60px rgba(111,180,242,0.15), 0 2px 0 rgba(0,0,0,0.3);
}
.hero-subtitle {
  font-family: var(--font-mono); font-size: clamp(0.875rem, 1.5vw, 1.125rem);
  font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--accent); margin-top: 16px; position: relative; z-index: 1;
}

/* Machined top edge highlight on hero plate */
.hero-plate::before {
  content: ''; position: absolute; top: -40px; left: 50%; transform: translateX(-50%);
  width: 80%; max-width: 600px; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(174,182,189,0.3), transparent);
}

/* --------------------------------------------------------------------------
   WELD BEAD DIVIDER
   -------------------------------------------------------------------------- */
.weld-divider {
  height: 24px; width: 100%; position: relative;
  background: linear-gradient(180deg, transparent 50%, var(--bg-deep) 50%);
}
.weld-divider::before {
  content: ''; position: absolute; top: 8px; left: 50%; transform: translateX(-50%);
  width: 60%; max-width: 480px; height: 12px;
  background: repeating-linear-gradient(
    90deg,
    transparent 0,
    transparent calc(50% - 6px),
    var(--rule) calc(50% - 6px),
    var(--rule) calc(50% + 6px),
    transparent calc(50% + 6px),
    transparent calc(50% + 18px)
  );
  mask-image: linear-gradient(90deg, transparent, #fff 20%, #fff 80%, transparent);
  -webkit-mask-image: linear-gradient(90deg, transparent, #fff 20%, #fff 80%, transparent);
}
.weld-divider::after {
  content: ''; position: absolute; top: 10px; left: 50%; transform: translateX(-50%);
  width: 60%; max-width: 480px; height: 8px;
  background: repeating-linear-gradient(
    90deg,
    transparent 0,
    transparent calc(50% - 5px),
    rgba(111,180,242,0.15) calc(50% - 5px),
    rgba(111,180,242,0.15) calc(50% + 5px),
    transparent calc(50% + 5px),
    transparent calc(50% + 18px)
  );
  filter: blur(1px); mask-image: linear-gradient(90deg, transparent, #fff 20%, #fff 80%, transparent);
  -webkit-mask-image: linear-gradient(90deg, transparent, #fff 20%, #fff 80%, transparent);
}

/* --------------------------------------------------------------------------
   FABRICATION TICKETS (Sections)
   -------------------------------------------------------------------------- */
.ticket {
  padding: var(--section-space) var(--container-pad); max-width: var(--max-width);
  margin: 0 auto; display: grid; grid-template-columns: 80px 1fr; gap: 48px; align-items: start;
}
.ticket-meta { position: sticky; top: calc(var(--header-h) + 24px); }
.ticket-num {
  font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600;
  letter-spacing: 0.08em; color: var(--accent); text-transform: uppercase;
  display: inline-block; padding: 4px 10px; border: 1px solid var(--accent);
  border-radius: 4px; opacity: 0.8;
}
.ticket-content { position: relative; }
.ticket-content::before {
  content: ''; position: absolute; top: -4px; left: -4px; right: -4px; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(174,182,189,0.15), transparent);
}
.ticket-title {
  font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.25rem);
  font-weight: 600; letter-spacing: -0.01em; line-height: 1.2;
  color: var(--text-primary); margin-bottom: 16px;
}
.ticket-body { color: var(--text-body); margin-bottom: 16px; }
.ticket-body:last-child { margin-bottom: 0; }
.ticket-list, .ticket-steps { list-style: none; padding-left: 0; }
.ticket-list li, .ticket-steps li {
  position: relative; padding-left: 28px; margin-bottom: 12px; color: var(--text-body);
}
.ticket-list li::before, .ticket-steps li::before {
  content: ''; position: absolute; left: 0; top: 0.55em; width: 8px; height: 8px;
  border: 1.5px solid var(--accent); border-radius: 2px;
  transform: rotate(45deg);
}
.ticket-steps li::before {
  background: var(--accent); border-color: var(--accent);
  box-shadow: 0 0 8px rgba(111,180,242,0.4);
}
.ticket-steps li + li { margin-top: 16px; }

/* Contact section */
.ticket-contact { display: flex; flex-direction: column; gap: 8px; }
.contact-phone {
  font-family: var(--font-mono); font-size: 1.125rem; font-weight: 500;
  color: var(--accent); text-decoration: none; transition: opacity 0.2s;
}
.contact-phone:hover, .contact-phone:focus { opacity: 0.7; }
.contact-region { font-size: 0.875rem; color: var(--rule); }

/* --------------------------------------------------------------------------
   FOOTER
   -------------------------------------------------------------------------- */
.site-footer {
  padding: 48px var(--container-pad); border-top: 1px solid var(--rule);
  background: var(--bg-deep); text-align: center;
}
.footer-inner { max-width: var(--max-width); margin: 0 auto; }
.footer-copy { font-size: 0.8125rem; color: var(--rule); margin-bottom: 8px; }
.footer-license { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--rule); opacity: 0.7; }

/* --------------------------------------------------------------------------
   MOBILE (≤ 599px)
   -------------------------------------------------------------------------- */
@media (max-width: 599px) {
  :root {
    --header-h: 56px;
    --hero-min-h: 440px;
    --section-space: 72px;
    --container-pad: 20px;
  }

  .header-inner { padding: 0 20px; }
  .site-id { font-size: 0.5625rem; }
  .header-phone { font-size: 0.75rem; }

  .hero { padding-top: calc(var(--header-h) + 24px); }
  .hero-glow { width: 360px; height: 360px; }
  .hero-sparks { width: 280px; height: 200px; }

  .ticket { grid-template-columns: 1fr; gap: 16px; padding: var(--section-space) 20px; }
  .ticket-meta { position: static; }
  .ticket-num { font-size: 0.6875rem; }
  .ticket-content::before { display: none; }

  .ticket-title { font-size: clamp(1.25rem, 5vw, 1.75rem); }
  .ticket-body { font-size: 0.9375rem; }
  .ticket-list li, .ticket-steps li { padding-left: 24px; font-size: 0.9375rem; }
  .ticket-list li::before, .ticket-steps li::before { width: 6px; height: 6px; top: 0.5em; }

  .weld-divider { height: 18px; }
  .weld-divider::before { top: 6px; height: 10px; }
  .weld-divider::after { top: 8px; height: 6px; }
}

/* --------------------------------------------------------------------------
   TABLET (600px - 899px)
   -------------------------------------------------------------------------- */
@media (min-width: 600px) and (max-width: 899px) {
  :root { --max-width: 640px; }
}

/* --------------------------------------------------------------------------
   DESKTOP (≥ 900px)
   -------------------------------------------------------------------------- */
@media (min-width: 900px) {
  :root { --max-width: 760px; }
}

/* --------------------------------------------------------------------------
   FOCUS VISIBLE (Accessibility)
   -------------------------------------------------------------------------- */
:focus { outline: none; }
:focus-visible {
  outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px;
}

/* --------------------------------------------------------------------------
   PRINT
   -------------------------------------------------------------------------- */
@media print {
  .site-header, .weld-divider, .hero-glow, .hero-sparks { display: none !important; }
  body { background: #fff; color: #000; }
  .hero-title, .ticket-title { color: #000; }
  .hero-subtitle, .ticket-num, .accent, .contact-phone { color: #0066cc; }
  .ticket-content::before { background: #ccc !important; }
}