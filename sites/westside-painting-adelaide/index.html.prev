  </div>
</footer>
<script>
document.documentElement.classList.add('js');
/* ===== Westside Painting — the wall gets painted as you scroll ===== */
(function(){
'use strict';
var wrap=document.getElementById('sceneWrap'),sticky=document.getElementById('sceneSticky'),cv=document.getElementById('paintCanvas');
if(!wrap||!sticky||!cv)return;
var ctx=cv.getContext('2d'),W=0,H=0;
var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var qp=new URLSearchParams(location.search),forceP=qp.get('p');
var DBG=qp.get('dbg')==='1';
var CL=function(v,a,b){return v<a?a:(v>b?b:v);};
var EZ=function(t){return 1-Math.pow(1-t,3);};

function resize(){
  var dpr=Math.min(2,window.devicePixelRatio||1);
  W=sticky.clientWidth||window.innerWidth;H=sticky.clientHeight||window.innerHeight;
  cv.width=Math.round(W*dpr);cv.height=Math.round(H*dpr);
  ctx.setTransform(dpr,0,0,dpr,0,0);ctx.lineJoin='round';
}

function hex2rgb(h){return [parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)];}
function mixc(a,b,t){var A=hex2rgb(a),B=hex2rgb(b);
  return 'rgb('+Math.round(A[0]+(B[0]-A[0])*t)+','+Math.round(A[1]+(B[1]-A[1])*t)+','+Math.round(A[2]+(B[2]-A[2])*t)+')';}

/* ---- room colours ---- */
var PLASTER='#cfd3d6', PAINT='#2f445a', SKIRT='#22262c', FLOOR='#e4e6e6', CLOTH='#f7f7f5';

/* ---- camera: three-quarter view of the wall ---- */
var camAz=-0.26,camEl=0.14,camD=27,f=1.62,camAlt=3.05;
function proj(x,y,z){
  var ca=Math.cos(camAz),sa=Math.sin(camAz);
  var xa=x*ca-z*sa,za=x*sa+z*ca,yy=y-camAlt;
  var ce=Math.cos(camEl),se=Math.sin(camEl);
  var vy=yy*ce+za*se,vz=-yy*se+za*ce+camD;
  var s=f*Math.min(H,W*0.86)/Math.max(6,vz);
  return {x:W/2+xa*s,y:H*0.545-vy*s,s:s,vz:vz};
}

/* ---- piece system (boxes in world space; rotX + rotZ) ---- */
var _s=7717;function rnd(){_s=(_s*1103515245+12345)%2147483648;return _s/2147483648;}
function rr(a,b){return a+(b-a)*rnd();}
var pieces=[];
function rotXv(p,a){var c=Math.cos(a),s=Math.sin(a);return [p[0],p[1]*c-p[2]*s,p[1]*s+p[2]*c];}
function rotZv(p,a){var c=Math.cos(a),s=Math.sin(a);return [p[0]*c-p[1]*s,p[0]*s+p[1]*c,p[2]];}
function rotAv(p,ax,a){var c=Math.cos(a),s=Math.sin(a),d=1-c,x=p[0],y=p[1],z=p[2],x0=ax[0],x1=ax[1],x2=ax[2];
 return [x*(x0*x0*d+c)+y*(x0*x1*d-x2*s)+z*(x0*x2*d+x1*s),
         x*(x1*x0*d+x2*s)+y*(x1*x1*d+c)+z*(x1*x2*d-x0*s),
         x*(x2*x0*d-x1*s)+y*(x2*x1*d+x0*s)+z*(x2*x2*d+c)];}
function add(o){
  o.rot=o.rot||0;o.rotz=o.rotz||0;o.spin=o.spin||0;o.alpha=(o.alpha==null)?1:o.alpha;
  o.stroke=(o.stroke==null)?true:o.stroke;o.t0=(o.t0==null)?0:o.t0;o.dur=o.dur||0.1;
  o.fly=o.fly||[0,0,0];o.axis=o.axis||[rr(-1,1),rr(0.4,1),rr(-1,1)];o.lay=(o.lay==null)?0:o.lay;
  o.rgb=hex2rgb(o.c);
  o.cx=o.cx||0;o.cy=o.cy||0;o.cz=o.cz||0;
  pieces.push(o);
}
var FACES=[[0,2,3,1],[4,5,7,6],[0,4,6,2],[1,3,7,5],[0,1,5,4],[2,6,7,3]];

/* ---- the wall grid + paint progress ---- */
var NCOL=14, X0=-8.4, X1=8.4;
var ROWS=[ {y0:0.22,y1:2.10,a:0.10,b:0.36,dir:1},   /* bottom, left to right  */
           {y0:2.10,y1:4.10,a:0.38,b:0.62,dir:-1},  /* middle, right to left  */
           {y0:4.10,y1:6.05,a:0.64,b:0.88,dir:1} ]; /* top, left to right     */
function bandFill(r, j, p){
  var R=ROWS[r], step=(R.b-R.a)*0.94/(NCOL-1);
  var jj=R.dir>0 ? j : (NCOL-1-j);
  var t0=R.a + jj*step, w=(R.b-R.a)*0.12;
  return EZ(CL((p-t0)/w,0,1));
}
/* roller position while its pass runs */
function rollerState(r,p){
  var R=ROWS[r], k=CL((p-R.a)/Math.max(.0001,R.b-R.a),0,1);
  var xin=R.dir>0 ? X0+0.4 : X1-0.4, xout=R.dir>0 ? X1-0.4 : X0+0.4;
  var x=xin+(xout-xin)*k;
  var yc=(R.y0+R.y1)/2;
  var bob=Math.sin(k*22)*((R.y1-R.y0)*0.28)*(p>R.a&&p<R.b?1:0);
  var vis=0,vo=CL((p-(R.a-0.075))/0.075,0,1);vo=EZ(vo);
  var vc=CL((p-(R.b))/0.075,0,1);vc=EZ(vc);
  var xi = mix2(xin-R.dir*7.5, xin, vo);
  var xo = mix2(x, x+R.dir*7.5, vc);
  x = vo<1 ? xi : (vc>0 ? xo : x);
  var y = vo<1 ? yc+2.6*(1-vo) : yc+bob;
  vis = (vo>=1&&vc<=0)?1:(vo<1?vo*0.9:1-vc);
  if(vo<1&&vc>0)vis=0;
  return {x:x,y:y,vis:vis,active:(p>=R.a&&p<=R.b)};
}
function mix2(a,b,t){return a+(b-a)*t;}

/* ---- rollers ---- */
function buildRoller(r){
  var rowsY=[(ROWS[0].y0+ROWS[0].y1)/2,(ROWS[1].y0+ROWS[1].y1)/2,(ROWS[2].y0+ROWS[2].y1)/2];
  var R=ROWS[r];
  var t0=R.a-0.075,dur=(R.b-R.a)+0.15;
  var base={t0:t0,dur:0.001,fly:[0,0,0],kf:null};
  /* sleeve + bracket + rod, keyed to the roller state each frame */
  add({c:'#e8e6e2',cx:0,cy:0,cz:0,sx:.68,sy:.30,sz:.30,stroke:false,lay:60,t0:-1,dur:99});
  return;
}
/* instead of static pieces, rollers are drawn per-frame below */

/* ---- paint chips / drops ---- */
var drops=[];
for(var i=0;i<26;i++)drops.push({x:rr(X0,X1),y:rr(0.3,5.9),r:rr(0.02,0.05),d:rr(0.5,0.9)});

var smoothP=0,mx=0,tmx=0,curStage=-1;
var stgNum=document.getElementById('stgNum'),stgName=document.getElementById('stgName'),
    railFill=document.getElementById('railFill'),hint=document.getElementById('scrollHint'),
    heroCopy=document.getElementById('heroCopy');
var STAGES=[[0,'Bare wall'],[0.08,'Bottom pass'],[0.38,'Middle pass'],[0.64,'Top pass'],[0.90,'Fresh paint']];

function drawRoller(r,p){
  var st=rollerState(r,p);
  if(st.vis<=0.02)return;
  var R=ROWS[r];
  var per=proj(st.x,st.y,R.dir>0?0.62:0.62);
  var sc=per.s;
  ctx.save();
  ctx.globalAlpha=st.vis;
  /* sleeve */
  var wSleeve=1.35*sc*0.5, hSleeve=0.33*sc*0.5;
  ctx.fillStyle='#e9e7e3';
  roundRect(per.x-wSleeve,per.y-hSleeve,wSleeve*2,hSleeve*2,4);ctx.fill();
  ctx.strokeStyle='rgba(20,22,28,.30)';ctx.lineWidth=1;ctx.stroke();
  /* wet paint on the sleeve */
  ctx.fillStyle=PAINT;
  roundRect(per.x-wSleeve,per.y-hSleeve*0.5,wSleeve*2,hSleeve,4);ctx.fill();
  /* bracket + rod angled up-right */
  ctx.strokeStyle='#b9bdc2';ctx.lineWidth=Math.max(2,sc*0.055);
  ctx.beginPath();ctx.moveTo(per.x,per.y);
  ctx.lineTo(per.x+wSleeve+0.30*sc*0.5,per.y-0.62*sc*0.5);
  ctx.lineTo(per.x+wSleeve+0.78*sc*0.5,per.y-1.30*sc*0.5);
  ctx.stroke();
  ctx.strokeStyle='#2b3038';ctx.lineWidth=Math.max(2.5,sc*0.075);
  ctx.beginPath();ctx.moveTo(per.x+wSleeve+0.62*sc*0.5,per.y-1.02*sc*0.5);
  ctx.lineTo(per.x+wSleeve+0.86*sc*0.5,per.y-1.46*sc*0.5);
  ctx.stroke();
  ctx.restore();
}
function roundRect(x,y,w,h,r2){ctx.beginPath();ctx.moveTo(x+r2,y);ctx.arcTo(x+w,y,x+w,y+h,r2);ctx.arcTo(x+w,y+h,x,y+h,r2);ctx.arcTo(x,y+h,x,y,r2);ctx.arcTo(x,y,x+w,y,r2);ctx.closePath();}

function quad(a,b,c,d,fill){ctx.fillStyle=fill;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.lineTo(c.x,c.y);ctx.lineTo(d.x,d.y);ctx.closePath();ctx.fill();}

function draw(p){
  if(!isFinite(p))p=0;
  var g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,'#eef0f1');g.addColorStop(.6,'#e7e9ea');g.addColorStop(1,'#dfe2e3');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  /* floor */
  var f1=proj(X0-2,0,0.0),f2=proj(X1+2,0,0.0),f3=proj(X1+3,0,12),f4=proj(X0-3,0,12);
  quad(f1,f2,f3,f4,FLOOR);
  /* drop cloth */
  var c1=proj(X0+0.4,0.005,0.25),c2=proj(X1-0.4,0.005,0.25),c3=proj(X1,0.005,5.6),c4=proj(X0,0.005,5.6);
  quad(c1,c2,c3,c4,CLOTH);
  ctx.strokeStyle='rgba(20,22,28,.08)';ctx.lineWidth=1;
  for(var fy=-6;fy<=6;fy+=2){
    var fa=proj(fy,0.01,0.4),fb=proj(fy*1.35,0.01,5.4);
    ctx.beginPath();ctx.moveTo(fa.x,fa.y);ctx.lineTo(fb.x,fb.y);ctx.stroke();
  }
  /* the wall, band by band */
  var colW=(X1-X0)/NCOL;
  var wetRow=-1,wetX=0;
  for(var r=0;r<ROWS.length;r++){
    var R=ROWS[r];
    var st=rollerState(r,p);
    for(var j=0;j<NCOL;j++){
      var xa=X0+j*colW, xb=xa+colW;
      var pr=bandFill(r,j,p);
      if(pr<=0){
        var q1=proj(xa,R.y0,0),q2=proj(xb,R.y0,0),q3=proj(xb,R.y1,0),q4=proj(xa,R.y1,0);
        quad(q1,q2,q3,q4,PLASTER);
      }else{
        var col=mixc(PLASTER,PAINT,CL(pr,0,1));
        var q1=proj(xa,R.y0,0),q2=proj(xb,R.y0,0),q3=proj(xb,R.y1,0),q4=proj(xa,R.y1,0);
        quad(q1,q2,q3,q4,col);
        /* roller texture streaks */
        if(pr<1){
          ctx.globalAlpha=0.24*(1-pr);
          ctx.strokeStyle='#ffffff';
          for(var s2=0;s2<4;s2++){
            var sx=xa+colW*(0.2+0.2*s2);
            var sa=proj(sx,R.y0+0.1,0.01),sb=proj(sx,R.y1-0.1,0.01);
            ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(sa.x,sa.y);ctx.lineTo(sb.x,sb.y);ctx.stroke();
          }
          ctx.globalAlpha=1;
        }
        if(pr<0.92){wetRow=r;wetX=(xa+xb)/2;}
      }
    }
  }
  /* wet edge gloss on the currently-active row */
  if(wetRow>=0){
    var R2=ROWS[wetRow],st2=rollerState(wetRow,p);
    var gx=CL(st2.x,X0,X1);
    var e1=proj(gx-0.9,R2.y0,0.02),e2=proj(gx+0.9,R2.y0,0.02),e3=proj(gx+0.9,R2.y1,0.02),e4=proj(gx-0.9,R2.y1,0.02);
    ctx.globalAlpha=0.20;
    quad(e1,e2,e3,e4,'#ffffff');
    ctx.globalAlpha=1;
    /* drips below the wet edge */
    for(var d2=0;d2<5;d2++){
      var dx=gx+rr(-0.5,0.5), dy0=R2.y0-0.05, dy1=R2.y0-0.45-rr(0,0.4);
      var da=proj(dx,dy0,0.03),db=proj(dx,dy1,0.03);
      ctx.strokeStyle='rgba(47,68,90,.55)';ctx.lineWidth=2;
      ctx.beginPath();ctx.moveTo(da.x,da.y);ctx.lineTo(db.x,db.y);ctx.stroke();
    }
  }
  /* skirting + cornice */
  var s1=proj(X0,0.0,0),s2=proj(X1,0.0,0),s3=proj(X1,0.22,0),s4=proj(X0,0.22,0);
  quad(s1,s2,s3,s4,SKIRT);
  var t1=proj(X0,6.05,0),t2=proj(X1,6.05,0),t3=proj(X1,6.34,0),t4=proj(X0,6.34,0);
  quad(t1,t2,t3,t4,'#f2f3f2');
  /* rollers */
  for(var r3=0;r3<3;r3++)drawRoller(r3,p);
  /* fresh-paint sheen sweep near the end */
  if(p>0.88){
    var sp=CL((p-0.88)/0.12,0,1), sh=Math.sin(sp*Math.PI);
    var hx=X0+ (X1-X0)*EZ(sp);
    var h1=proj(hx-2.2,0.0,0.05),h2=proj(hx+0.4,0.0,0.05),h3=proj(hx+0.4,6.1,0.05),h4=proj(hx-2.2,6.1,0.05);
    ctx.globalAlpha=0.16*sh;
    quad(h1,h2,h3,h4,'#ffffff');
    ctx.globalAlpha=1;
  }
  /* HUD */
  var sI=0;
  for(var i2=0;i2<STAGES.length;i2++){if(p>=STAGES[i2][0])sI=i2;}
  if(sI!==curStage&&stgNum){
    curStage=sI;
    stgNum.textContent=(sI<10?'0':'')+sI;
    stgName.textContent=STAGES[sI][1];
  }
  if(railFill)railFill.style.height=(p*100).toFixed(1)+'%';
  if(heroCopy){var ho=reduce?1:CL(1-p*5.0,0,1);heroCopy.style.opacity=ho;heroCopy.style.transform='translateY('+(p*36)+'px)';}
  if(hint)hint.style.opacity=reduce?0:CL(1-p*8,0,1);
  if(DBG){
    var pp=[['WALLBOT',0,1.1,0.02],['WALLMID',0,3.0,0.02],['WALLTOP',0,5.2,0.02],['ROLLER',(p<0.36?rollerState(0,p).x:(p<0.62?rollerState(1,p).x:rollerState(2,p).x)),1.0,0.62]];
    var out=[];
    for(var i3=0;i3<pp.length;i3++){
      var q5=proj(pp[i3][1],pp[i3][2],pp[i3][3]);
      var rx2=Math.round(q5.x),ry2=Math.round(q5.y),ss='oob';
      if(rx2>0&&ry2>0&&rx2<W&&ry2<H){var dtx=ctx.getImageData(rx2,ry2,1,1).data;ss=dtx[0]+','+dtx[1]+','+dtx[2];}
      out.push(pp[i3][0]+'@'+rx2+','+ry2+'='+ss);
    }
    document.title='DBG '+out.join(' | ');
  }
}
window.__buildTo=function(x){draw(CL(+x||0,0,1));};

function animate(ts){
  if(!isFinite(ts))ts=0;
  var rect=wrap.getBoundingClientRect();
  var span=wrap.offsetHeight-sticky.offsetHeight;
  var p2=CL(-rect.top/Math.max(1,span),0,1);
  smoothP+=(p2-smoothP)*0.10;
  if(Math.abs(smoothP-p2)<0.0004)smoothP=p2;
  draw(smoothP);
  requestAnimationFrame(animate);
}
window.addEventListener('pointermove',function(e){tmx=(e.clientX/window.innerWidth)*2-1;},{passive:true});

resize();
window.addEventListener('resize',function(){resize();if(forceP!=null||reduce)draw(forceP!=null?CL(parseFloat(forceP)||0,0,1):1);});
if(forceP!=null){draw(CL(parseFloat(forceP)||0,0,1));}
else if(reduce){draw(1);}
else{requestAnimationFrame(animate);}
})();

/* ===== reveals + year ===== */
(function(){
  var obs=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  document.querySelectorAll('.rv').forEach(function(el){obs.observe(el);});
  setTimeout(function(){document.querySelectorAll('.rv:not(.on)').forEach(function(el){el.classList.add('on');});},1200);
})();
var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
</body>
</html>
