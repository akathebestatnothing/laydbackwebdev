<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Westside Painting Services Adelaide | Interior & Exterior Painters, Adelaide SA</title>
<meta name="description" content="Interior, exterior and commercial painting and decorating across Adelaide. Licensed BLD 301460, careful prep and finishes that last. Call 0498 118 701.">
<link rel="icon" href="assets/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet"></noscript>
<style>
:root{
  --bg:#f6f6f4; --bg2:#ffffff; --ink:#14161c; --ink2:#5c626b;
  --acc:#2f445a; --acc2:#3d5a76; --coral:#ff9d8a; --line:rgba(20,22,28,.12);
  --chip:#eef0f2; --plaster:#cfd3d6; --nav-h:76px;
  --disp:'Fraunces',Georgia,serif; --body-font:'Manrope',sans-serif;
  --font-m:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
section[id]{scroll-margin-top:calc(var(--nav-h) + 10px)}
html:not(.js) .rv{opacity:1!important;transform:none!important}
.js .rv{opacity:0;transform:translateY(22px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
.js .rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body-font);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--coral);outline-offset:3px}
::selection{background:var(--acc);color:#fff}
.skip{position:absolute;top:-100%;left:50%;transform:translateX(-50%);padding:.7rem 1.2rem;background:var(--acc);color:#fff;font-weight:700;z-index:10000}
.skip:focus{top:1rem}
h1,h2,h3{font-family:var(--disp);font-weight:600;letter-spacing:-.01em}
.mono{font-family:var(--font-m)}
.nav{position:fixed;top:0;left:0;right:0;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(1rem,3vw,2.5rem);background:rgba(246,246,244,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);z-index:1000}
.nav__b{display:flex;align-items:center;gap:.8rem}
.nav__b img{height:44px;width:auto;border-radius:6px;display:block}
.nav__b .nb-t{display:block;font-family:var(--disp);font-weight:700;font-size:clamp(1rem,1.8vw,1.18rem);line-height:1.1}
.nav__b .nb-s{display:block;font-family:var(--font-m);font-size:.54rem;letter-spacing:.18em;text-transform:uppercase;color:var(--acc2);font-weight:700;white-space:nowrap}
.nav__links{display:flex;gap:1.4rem;list-style:none}
.nav__links a{font-size:.92rem;font-weight:600;color:var(--ink2)}
.nav__links a:hover{color:var(--ink)}
.nav__cta{display:flex;align-items:center;gap:.9rem}
.nav__p{font-size:.82rem;font-weight:700}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.8rem 1.5rem;font-size:.84rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em;border:0;border-radius:6px;cursor:pointer;transition:transform .15s,background .15s,color .15s,border-color .15s}
.btn--p{background:var(--acc);color:#fff}
.btn--p:hover{background:var(--acc2);transform:translateY(-1px)}
.btn--o{border:1.5px solid var(--acc);color:var(--acc);background:transparent}
.btn--o:hover{background:var(--acc);color:#fff}
.nav__cta .btn{padding:.52rem 1.05rem;font-size:.75rem;white-space:nowrap}
.nav .burger{display:none}
@media (max-width:900px){
  .nav__links{display:none}
  .nav__p{display:none}
}
@media (max-width:640px){.nav__b .nb-s{display:none}}

/* ============ hero: the painted wall ============ */
#sceneWrap{height:430vh;position:relative}
#sceneSticky{position:sticky;top:0;height:100vh;overflow:hidden;background:#eceeef}
#paintCanvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.hero-copy{position:absolute;left:clamp(1.2rem,4.5vw,4rem);top:calc(var(--nav-h) + 4vh);max-width:620px;z-index:3}
.hero-copy .k{display:inline-flex;align-items:center;gap:.6rem;margin:0 0 .9rem;font-family:var(--font-m);font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:var(--acc2)}
.hero-copy .k i{display:block;width:26px;height:2px;background:var(--coral)}
.hero-copy h1{font-size:clamp(2.6rem,6.4vw,4.6rem);line-height:1.02;color:var(--ink)}
.hero-copy h1 em{font-style:italic;color:var(--acc)}
.hero-copy .d{margin:1.1rem 0 1.5rem;font-size:clamp(.98rem,1.4vw,1.1rem);color:var(--ink2);max-width:46ch}
.cta{display:flex;gap:.8rem;flex-wrap:wrap}
.hero-copy .strip{display:flex;gap:1.6rem;flex-wrap:wrap;margin-top:1.8rem;padding-top:1.2rem;border-top:1px solid var(--line)}
.hero-copy .strip p{font-size:.8rem;color:var(--ink2)}
.hero-copy .strip b{display:block;color:var(--ink);font-size:.86rem}
.hud{position:absolute;inset:0;pointer-events:none;z-index:2}
.hud .stg{position:absolute;left:clamp(1.2rem,4.5vw,4rem);bottom:4.5vh;display:flex;align-items:baseline;gap:.8rem}
.hud .stg b{font-family:var(--disp);font-size:clamp(2.6rem,5vw,4rem);font-weight:700;color:var(--acc);opacity:.30;line-height:1}
.hud .stg span{font-family:var(--font-m);font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--acc2)}
.hud .rail{position:absolute;right:clamp(1rem,3.4vw,2.6rem);top:22vh;bottom:22vh;width:3px;background:rgba(20,22,28,.10);border-radius:2px}
.hud .rail i{position:absolute;left:0;top:0;width:100%;height:0%;background:var(--coral);display:block;border-radius:2px}
.scroll-hint{position:absolute;right:calc(clamp(1rem,3.4vw,2.6rem) + 1rem);bottom:4.5vh;font-family:var(--font-m);font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:var(--acc2);z-index:3}
.hero-cta-fade{position:absolute;left:0;right:0;bottom:0;height:20vh;background:linear-gradient(180deg,rgba(236,238,239,0),rgba(236,238,239,.55));z-index:1}

/* ============ sections ============ */
.sec{max-width:1220px;margin:0 auto;padding:clamp(4rem,9vh,7rem) clamp(1.2rem,4vw,2.5rem)}
.sec-head{display:flex;gap:1.2rem;align-items:flex-start;margin-bottom:2.6rem}
.sec-idx{font-family:var(--font-m);font-size:.78rem;color:var(--coral);font-weight:700;padding-top:.55rem}
.sec-title{font-size:clamp(1.7rem,3.4vw,2.6rem);line-height:1.08}
.sec-head p.lead{margin-top:.7rem;color:var(--ink2);max-width:62ch;font-size:1rem}
/* services: ruled rows with paint chips */
.svc-list{border-top:1px solid var(--line)}
.svc-row{display:grid;grid-template-columns:64px 1fr auto;gap:1.4rem;align-items:center;padding:1.5rem .4rem;border-bottom:1px solid var(--line);transition:background .2s}
.svc-row:hover{background:var(--bg2)}
.svc-row .sw{display:flex;gap:6px}
.svc-row .sw i{width:22px;height:22px;border-radius:4px;display:block}
.svc-n{font-family:var(--font-m);font-size:.8rem;color:var(--ink2);font-weight:700}
.svc-row h3{font-size:1.22rem;font-weight:600}
.svc-row p{color:var(--ink2);font-size:.95rem;margin-top:.25rem;max-width:62ch}
@media (max-width:640px){.svc-row{grid-template-columns:44px 1fr;gap:.9rem}.svc-row .sw{display:none}}
/* process: four columns, big serif numerals */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1.6rem}
.step{border-top:3px solid var(--acc);padding-top:1.1rem}
.step b{font-family:var(--disp);font-size:2rem;font-weight:700;color:var(--acc2);display:block;line-height:1}
.step h3{font-size:1.06rem;margin:.55rem 0 .3rem}
.step p{font-size:.92rem;color:var(--ink2)}
@media (max-width:900px){.steps{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.steps{grid-template-columns:1fr}}
.sec--tint{background:var(--bg2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.faq{border-top:1px solid var(--line);max-width:840px}
details.faq{border-bottom:1px solid var(--line)}
details.faq summary{cursor:pointer;list-style:none;padding:1.1rem .3rem;font-weight:700;font-size:1.02rem;display:flex;justify-content:space-between;gap:1rem;align-items:center}
details.faq summary::-webkit-details-marker{display:none}
details.faq summary:after{content:'+';font-family:var(--font-m);color:var(--coral);font-size:1.2rem}
details.faq[open] summary:after{content:'–'}
details.faq .a{padding:0 .3rem 1.2rem;color:var(--ink2);max-width:70ch}
.band{display:flex;gap:2.6rem;flex-wrap:wrap;justify-content:space-between;align-items:center;padding:2.2rem clamp(1.2rem,4vw,2.5rem);max-width:1220px;margin:0 auto}
.band .b-i{display:flex;gap:.8rem;align-items:baseline}
.band .b-i b{font-family:var(--disp);font-size:1.5rem;color:var(--acc)}
.band .b-i span{font-size:.85rem;color:var(--ink2)}
.gal{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.gal figure{margin:0}
.gal img{width:100%;height:300px;object-fit:cover;border-radius:8px;border:1px solid var(--line)}
.gal figcaption{display:flex;justify-content:space-between;padding:10px 2px;font-size:.85rem;color:var(--ink2)}
@media (max-width:900px){.gal{grid-template-columns:repeat(2,1fr)}.gal img{height:240px}}
@media (max-width:560px){.gal{grid-template-columns:1fr}}
footer{border-top:1px solid var(--line);background:#14161c;color:#f3f5f4;padding:64px 0 0;margin-top:3rem}
footer .fw{max-width:1220px;margin:0 auto;padding:0 clamp(1.2rem,4vw,2.5rem);display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px}
footer h4{font-family:var(--font-m);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--coral);margin-bottom:1rem}
footer a{display:block;color:#c8cdd3;font-size:.95rem;padding:5px 0}
footer a:hover{color:#fff}
.fbrand{display:flex;align-items:center;gap:.9rem}
.fbrand img{height:52px;border-radius:6px}
.fbrand .fb-n{font-family:var(--disp);font-size:1.15rem;font-weight:700;color:#fff}
.fbrand .fb-s{font-family:var(--font-m);font-size:.55rem;letter-spacing:.18em;text-transform:uppercase;color:var(--coral)}
.footer-bar{max-width:1220px;margin:44px auto 0;padding:18px clamp(1.2rem,4vw,2.5rem);border-top:1px solid rgba(255,255,255,.14);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:.8rem;color:#9aa1a9}
@media (max-width:900px){footer .fw{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>

<a class="skip" href="#services">Skip to content</a>

<nav class="nav" aria-label="Main">
  <a class="nav__b" href="#top" aria-label="Westside Painting Services Adelaide home">
    <img src="assets/logo.png" alt="Westside Painting Services Adelaide logo">
    <span><span class="nb-t">Westside Painting</span><span class="nb-s">Interior · Exterior · Commercial</span></span>
  </a>
  <ul class="nav__links">
    <li><a href="#services">Services</a></li>
    <li><a href="#process">Process</a></li>
    <li><a href="#faq">FAQ</a></li>
    <li><a href="#work">Work</a></li>
    <li><a href="#quote">Quote</a></li>
  </ul>
  <div class="nav__cta">
    <span class="mono nav__p">0498 118 701</span>
    <a class="btn btn--p" href="#quote">Get a quote</a>
  </div>
</nav>

<header id="top">
<div id="sceneWrap" aria-label="Scroll to paint the wall">
  <div id="sceneSticky">
    <canvas id="paintCanvas" aria-hidden="true"></canvas>
    <div class="hero-cta-fade" aria-hidden="true"></div>

    <div class="hero-copy" id="heroCopy">
      <p class="k"><i></i>Painting &amp; decorating · Adelaide, SA</p>
      <h1>Prep done properly, finished <em>sharp</em>.</h1>
      <p class="d">Interior and exterior painting and decorating across Adelaide. Residential, commercial and heritage homes, prepped carefully and finished cleanly by a licensed local crew.</p>
      <div class="cta">
        <a class="btn btn--p" href="#quote">Get a free quote</a>
        <a class="btn btn--o" href="tel:+61498118701" aria-label="Call 0498 118 701">Call 0498 118 701</a>
      </div>
      <div class="strip">
        <p><b>Licensed</b>BLD 301460</p>
        <p><b>4.9 rated</b>hipages reviews</p>
        <p><b>Adelaide</b>local painters</p>
      </div>
    </div>

    <div class="hud" aria-hidden="true">
      <div class="stg"><b id="stgNum">00</b><span id="stgName">Bare wall</span></div>
      <div class="rail"><i id="railFill"></i></div>
      <div class="scroll-hint" id="scrollHint">Scroll · the wall gets painted</div>
    </div>
  </div>
</div>
</header>

<section class="sec" id="services">
  <div class="sec-head rv"><span class="sec-idx">01</span><div><h2 class="sec-title">What we paint.</h2><p class="lead">Careful prep first, then a finish that lasts. One crew for the walls, the trim, the facade and the fence.</p></div></div>
  <div class="svc-list">
    <div class="svc-row rv"><span class="svc-n">01</span><div><h3>Interior painting</h3><p>Walls, ceilings, cornices, doors and trims prepped, patched and painted with clean cut-in lines.</p></div><span class="sw"><i style="background:#2f445a"></i><i style="background:#8fa3b8"></i><i style="background:#e8e4da"></i></span></div>
    <div class="svc-row rv"><span class="svc-n">02</span><div><h3>Exterior painting</h3><p>Facades, verandahs, fences, timber and metalwork, prepped and coated to handle the weather.</p></div><span class="sw"><i style="background:#14161c"></i><i style="background:#cfd3d6"></i><i style="background:#ff9d8a"></i></span></div>
    <div class="svc-row rv"><span class="svc-n">03</span><div><h3>Commercial &amp; strata</h3><p>Offices, retail, common areas and strata work, scheduled to keep the site running.</p></div><span class="sw"><i style="background:#3d5a76"></i><i style="background:#eef0f2"></i><i style="background:#5c626b"></i></span></div>
    <div class="svc-row rv"><span class="svc-n">04</span><div><h3>Heritage &amp; period homes</h3><p>Careful prep and the right finishes for stone, timber and ornate trim on character homes.</p></div><span class="sw"><i style="background:#b08968"></i><i style="background:#2f445a"></i><i style="background:#f1ede4"></i></span></div>
  </div>
</section>

<section class="sec sec--tint" id="process">
  <div class="sec-head rv"><span class="sec-idx">02</span><div><h2 class="sec-title">How a job runs.</h2></div></div>
  <div class="steps">
    <div class="step rv"><b>01</b><h3>Walk &amp; quote</h3><p>Areas, surface condition and colours checked. A firm written quote.</p></div>
    <div class="step rv"><b>02</b><h3>Prep</h3><p>Sanding, patching and priming first. The part that decides how the finish lasts.</p></div>
    <div class="step rv"><b>03</b><h3>Paint</h3><p>Cut in clean, roll out even, coats applied properly.</p></div>
    <div class="step rv"><b>04</b><h3>Check &amp; clean up</h3><p>Final walk-through, then the site left tidy.</p></div>
  </div>
</section>

<section class="sec" id="faq">
  <div class="sec-head rv"><span class="sec-idx">03</span><div><h2 class="sec-title">Asked on every job.</h2></div></div>
  <div class="faq">
  <details class="faq rv"><summary>Are you licensed?</summary><div class="a">Yes. A licensed painting business, BLD 301460, and fully insured.</div></details>
  <details class="faq rv"><summary>Do you do commercial work?</summary><div class="a">Yes. Commercial and strata painting alongside residential, interior and exterior.</div></details>
  <details class="faq rv"><summary>Do you handle heritage homes?</summary><div class="a">Yes. Period and heritage exteriors and interiors done with the right prep and finishes.</div></details>
  <details class="faq rv"><summary>What areas do you cover?</summary><div class="a">Adelaide and surrounding suburbs.</div></details>
  </div>
</section>

<section class="sec--tint" aria-label="At a glance">
  <div class="band rv">
    <div class="b-i"><b>BLD 301460</b><span>licensed &amp; insured</span></div>
    <div class="b-i"><b>4.9</b><span>hipages rating</span></div>
    <div class="b-i"><b>Adelaide</b><span>and surrounding suburbs</span></div>
    <div class="b-i"><b>One crew</b><span>walls, trim, facade, fence</span></div>
  </div>
</section>

<section class="sec" id="work">
  <div class="sec-head rv"><span class="sec-idx">04</span><div><h2 class="sec-title">Recent work.</h2><p class="lead">Jobs from around Adelaide, inside and out.</p></div></div>
  <div class="gal">
    <figure class="rv"><img src="assets/gal_1.jpg" alt="Heritage exterior painting, Adelaide" loading="lazy"><figcaption><span>Heritage exterior</span><span class="mono">/01</span></figcaption></figure>
    <figure class="rv"><img src="assets/gal_2.jpg" alt="Fence and facade painting, Adelaide" loading="lazy"><figcaption><span>Fence &amp; facade</span><span class="mono">/02</span></figcaption></figure>
    <figure class="rv"><img src="assets/gal_3.jpg" alt="Outdoor living repaint, Adelaide" loading="lazy"><figcaption><span>Outdoor living repaint</span><span class="mono">/03</span></figcaption></figure>
    <figure class="rv"><img src="assets/gal_4.jpg" alt="Street facade repaint, Adelaide" loading="lazy"><figcaption><span>Street facade</span><span class="mono">/04</span></figcaption></figure>
    <figure class="rv"><img src="assets/gal_5.jpg" alt="Interior master bedroom repaint, Adelaide" loading="lazy"><figcaption><span>Interior · master bedroom</span><span class="mono">/05</span></figcaption></figure>
    <figure class="rv"><img src="assets/gal_6.jpg" alt="Hallway and trim painting, Adelaide" loading="lazy"><figcaption><span>Hallway &amp; trim</span><span class="mono">/06</span></figcaption></figure>
  </div>
</section>

<span id="quote" style="position:absolute;top:-90px"></span>
<section id="lbq" aria-labelledby="lbq-h">
<style>
#lbq{--lbq-accent:var(--acc);--lbq-ink:var(--ink);--lbq-muted:var(--ink2);--lbq-bg:var(--paper2);--lbq-panel:#fff;--lbq-line:var(--line);padding:72px 20px;background:var(--lbq-bg);color:var(--lbq-ink)}
#lbq *{box-sizing:border-box}
#lbq .lbq-w{max-width:1060px;margin:0 auto;display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:start}
@media(max-width:900px){#lbq .lbq-w{grid-template-columns:1fr}}
#lbq h2{font-size:clamp(1.6rem,3.4vw,2.3rem);margin:0 0 10px;letter-spacing:-.02em;font-family:var(--disp)}
#lbq p.lbq-s{margin:0 0 22px;color:var(--lbq-muted);max-width:52ch}
#lbq .lbq-info{display:flex;flex-direction:column;gap:12px;border-top:1px solid var(--lbq-line);padding-top:22px}
#lbq .lbq-info div{display:flex;gap:10px;align-items:baseline}
#lbq .lbq-info b{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--lbq-accent);min-width:64px}
#lbq .lbq-info a{font-weight:800;text-decoration:none}
#lbq .lbq-f{display:grid;gap:12px;background:var(--lbq-panel);border:1px solid var(--lbq-line);border-radius:14px;padding:26px}
#lbq label{display:block;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--lbq-muted);margin-bottom:5px}
#lbq input,#lbq textarea,#lbq select{width:100%;padding:12px 14px;border:1px solid var(--lbq-line);border-radius:8px;background:var(--paper);color:var(--ink);font:inherit;font-size:.95rem}
#lbq textarea{min-height:96px;resize:vertical}
#lbq input:focus,#lbq textarea:focus,#lbq select:focus{outline:2px solid var(--lbq-accent);outline-offset:1px;border-color:transparent}
#lbq button{margin-top:6px;padding:13px 22px;border:0;border-radius:8px;background:var(--lbq-accent);color:var(--lbq-acc-text,#0b0e12);font:inherit;font-weight:800;font-size:.95rem;cursor:pointer;letter-spacing:.02em}
#lbq button:disabled{opacity:.6;cursor:wait}
#lbq .lbq-st{margin:10px 0 0;font-size:.9rem;color:var(--lbq-muted);min-height:1.2em}
#lbq .lbq-cons{display:flex;gap:9px;align-items:center;margin-top:12px;font-size:.82rem;color:var(--lbq-muted);text-transform:none;letter-spacing:0}
#lbq .lbq-cons input{width:auto}
#lbq .lbq-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
</style>
<div class="lbq-w">
  <div>
    <h2 id="lbq-h">Get a free quote</h2>
    <p class="lbq-s">Tell us about the job and we&rsquo;ll come back with a firm price &mdash; no surprises, no obligation.</p>
    <div class="lbq-info">
      <div><b>Call</b><a href="tel:+61498118701 118 701">0498 118 701</a></div>
      <div><b>Email</b><a href="mailto:"></a></div>
      <div><b>Area</b><span>Adelaide, SA</span></div>
    </div>
  </div>
  <form id="lbq-form" novalidate data-site="westside-painting-adelaide" data-biz="Westside Painting Services Adelaide">
    <div class="lbq-f">
      <div class="lbq-g">
        <div><label for="lbq-n">Name</label><input id="lbq-n" name="name" autocomplete="name" required></div>
        <div><label for="lbq-p">Phone</label><input id="lbq-p" name="phone" type="tel" autocomplete="tel"></div>
        <div><label for="lbq-e">Email</label><input id="lbq-e" name="email" type="email" autocomplete="email"></div>
        <div class="lbq-full"><label for="lbq-svc">Service</label>
          <select id="lbq-svc" name="service"><option>Interior painting</option><option>Exterior painting</option><option>Commercial / strata</option><option>Heritage & period homes</option><option>Fences & decking</option><option>Other</option></select>
        </div>
        <div class="lbq-full"><label for="lbq-m">Tell us about the job</label><textarea id="lbq-m" name="message" placeholder="Rooms or areas, interior/exterior, colour ideas, timing…" required></textarea></div>
      </div>
      <label class="lbq-cons"><input type="checkbox" name="consent" value="1" checked> I agree to be contacted about this request.</label>
      <div class="lbq-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <button type="submit">Send quote request</button>
      <p class="lbq-st" id="lbq-st" role="status" aria-live="polite"></p>
    </div>
  </form>
</div>
<script>
(function(){
  var EP = null;
  function base(cb){
    if (window.__LAYDBACK_API_BASE) return cb(window.__LAYDBACK_API_BASE);
    var done = false;
    var t = setTimeout(function(){ if(!done){done=true;cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} }, 2500);
    fetch('https://gist.githubusercontent.com/laydbackapps-beep/48ff985c786b72a1637d7875f4df79b8/raw/api-base.txt?_=' + Date.now())
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var b = (txt||'').trim().replace(/\/+$/, '');
        if (done) return;
        done = true; clearTimeout(t);
        cb(/^https:\/\/[a-z0-9.\-]+(:\d+)?$/i.test(b) ? b : 'https://grocery-periodically-everyone-wine.trycloudflare.com');
      })
      .catch(function(){ if(!done){done=true;clearTimeout(t);cb('https://grocery-periodically-everyone-wine.trycloudflare.com');} });
  }
  function init(){
    var f = document.getElementById('lbq-form');
    if (!f) return;
    var st = document.getElementById('lbq-st');
    var btn = f.querySelector('button[type=submit]');
    f.addEventListener('submit', function(e){
      e.preventDefault();
      var d = {};
      new FormData(f).forEach(function(v,k){ d[k]=v; });
      if (d.website) return;
      if (!d.name || (!d.phone && !d.email) || !(d.message||'').trim()) {
        st.textContent = 'Please add your name, a phone or email, and a few words about the job.';
        st.style.color = '#ff9d8a';
        return;
      }
      btn.disabled = true;
      st.textContent = 'Sending\u2026';
      st.style.color = '';
      base(function(B){
        var url = B + '/functions/v1/quote-request';
        fetch(url, {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            site_id: f.dataset.site || '',
            business_name: f.dataset.biz || '',
            name: d.name, phone: d.phone, email: d.email,
            service: d.service || '', message: d.message,
            consent: !!d.consent
          })
        })
        .then(function(r){ return r.json().catch(function(){ return {}; }); })
        .then(function(x){
          if (x && x.success) {
            f.reset();
            st.textContent = "Thanks \u2014 your request is in. We'll be in touch shortly.";
            st.style.color = 'var(--lbq-accent)';
          } else {
            throw new Error((x && x.error) || 'Could not send');
          }
        })
        .catch(function(err){
          st.textContent = (err && err.message) ? err.message : 'Could not send \u2014 please try again or call.';
          st.style.color = '#ff9d8a';
        })
        .finally(function(){ btn.disabled = false; });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
</section>

<footer>
  <div class="fw">
    <div>
      <div class="fbrand"><img src="assets/logo.png" alt="Westside Painting Services Adelaide logo"><span><span class="fb-n">Westside Painting</span><br><span class="fb-s">Interior · Exterior · Commercial</span></span></div>
      <p style="margin-top:16px;font-size:.85rem;max-width:300px;color:#9aa1a9;">Painting &amp; decorating across Adelaide. Licensed BLD 301460.</p>
      <p style="margin-top:10px;font-size:.78rem;max-width:300px;color:#9aa1a9;">Privacy note: your details are only used to prepare your quote.</p>
    </div>
    <div><h4>Services</h4><a href="#services">Interior painting</a><a href="#services">Exterior painting</a><a href="#services">Commercial &amp; strata</a><a href="#services">Heritage homes</a></div>
    <div><h4>Company</h4><a href="#process">How a job runs</a><a href="#faq">FAQ</a><a href="#work">Recent work</a><a href="#quote">Free quote</a></div>
