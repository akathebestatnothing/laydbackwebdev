<!DOCTYPE html>
<html lang="en-AU" class="no-js" data-sig="links:bg,buttons:arrow,tilt:1,marquee:1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TL Carport - Verandahs & Carports, Melbourne</title>
<meta name="description" content="TL Carport: specialist verandah and carport design and construction in Melbourne VIC. Custom outdoor structures built to last. Request a quote.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
<style>
:root {
  --bg: #28323b;
  --ink: #f5f5f0;
  --ink-muted: #b8bcc0;
  --accent: #c9a876;
  --accent-strong: #d4b88c;
  --card: #2f3a44;
  --line: #3d4a56;
  --focus: #d4b88c;
  --shadow: rgba(0,0,0,0.35);
  --shadow-strong: rgba(0,0,0,0.55);
  --timber: #8a6a42;
  --timber-dark: #5d4528;
  --charcoal: #28323b;
  --charcoal-light: #34404c;
  --roof: #4a3f35;
  --roof-light: #5d5044;
}

@media (prefers-color-scheme: light) {
  :root {
    --bg: #f5f5f0;
    --ink: #1a1f23;
    --ink-muted: #4a5258;
    --accent: #8a6a42;
    --accent-strong: #6b4f2f;
    --card: #ffffff;
    --line: #d8dbde;
    --shadow: rgba(26,31,35,0.12);
    --shadow-strong: rgba(26,31,35,0.2);
  }
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

html.no-js .rv { opacity: 1 !important; transform: none !important; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  canvas {  }
}

body {
  font-family: 'Barlow', system-ui, sans-serif;
  background: var(--bg);
  color: var(--ink);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

h1, h2, h3, h4 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; line-height: 1.15; }

a { color: inherit; text-decoration: none; }
a:hover { color: var(--accent); }

img { max-width: 100%; height: auto; display: block; }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
  padding: 0.875rem 1.75rem; font-size: 0.9375rem; font-weight: 600;
  border-radius: 4px; border: 2px solid transparent; cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
}
.btn:active { transform: scale(0.98); }
.btn-primary { background: var(--accent); color: var(--bg); border-color: var(--accent); }
.btn-primary:hover { background: var(--accent-strong); border-color: var(--accent-strong); }
.btn-outline { background: transparent; color: var(--ink); border-color: var(--line); }
.btn-outline:hover { border-color: var(--accent); color: var(--accent); }

.container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }

.rv { opacity: 0; transform: translateY(16px); transition: opacity .45s ease, transform 0.6s ease; }
.rv.on { opacity: 1; transform: translateY(0); }

.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; border-radius: 3px; }

/* Header */
.site-header {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(40,50,59,0.98);
  -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
  padding: 1rem 1.5rem;
}
@media (prefers-color-scheme: light) {
  .site-header {
    background: rgba(245,245,240,0.98);
  }
}
.header-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.logo { display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; }
.logo-img { height: 32px; width: auto; max-height: 32px; object-fit: contain; border-radius: 4px; display: block; image-rendering: auto; }
.logo-text { display: flex; flex-direction: column; line-height: 1.1; }
.logo-name { font-family: 'Space Grotesk', sans-serif; font-weight: 800; font-size: 1.15rem; line-height: 1; letter-spacing: -0.012em; white-space: nowrap; color: var(--ink); }
.logo-tagline { font-size: 0.6rem; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; color: var(--accent); }
@media (max-width: 820px) {
  .logo-img { height: 24px; max-height: 24px; }
  .logo-name { font-size: 1rem; }
}
.nav { display: none; gap: 2rem; }
.nav a { font-size: 0.875rem; font-weight: 500; color: var(--ink-muted); transition: color 0.15s; }
.nav a:hover { color: var(--accent); }
.header-cta { display: none; }
@media (min-width: 768px) {
  .nav { display: flex; }
  .header-cta { display: inline-flex; }
}

/* Hero / photo */
.hero { position: relative; min-height: 100vh; min-height: 100svh; display: flex; align-items: center; justify-content: center; padding: 96px 1.5rem 72px; isolation: isolate; overflow: hidden; perspective: 1200px; background: var(--charcoal); }
.hero-photo{position:absolute;inset:0;z-index:0;background:linear-gradient(135deg,rgba(10,11,12,.95) 0%,rgba(10,11,12,.7) 50%,rgba(10,11,12,.3) 100%)}
.hero-shade { position: absolute; inset: 0; z-index: 1; background: rgba(18,23,28,.58); }
.hero-copy { position: relative; z-index: 2; text-align: center; max-width: min(760px, 92vw); margin: 0 auto; padding: 0; pointer-events: auto; }
.hero-kicker { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-strong); margin-bottom: 1rem; text-shadow: 0 2px 10px rgba(0,0,0,0.5); }
.hero-copy h1 { font-size: clamp(2.4rem, 6vw, 4.4rem); font-weight: 700; line-height: 1.05; margin-bottom: 1rem; color: #ffffff; text-shadow: 0 4px 24px var(--shadow-strong); text-wrap: balance; }
.hero-copy p { font-size: clamp(1rem, 2.2vw, 1.2rem); color: rgba(245,245,240,0.94); max-width: 560px; margin: 0 auto; text-shadow: 0 2px 12px var(--shadow); }
.hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; margin-top: 2rem; }
.hero .btn-outline { color: #f5f5f0; border-color: rgba(245,245,240,0.55); background: rgba(18,23,28,0.35); }
.hero .btn-outline:hover { border-color: var(--accent-strong); color: var(--accent-strong); }
@media (max-width: 639px) {
  .hero { padding-top: 84px; }
  .hero-kicker { font-size: 0.7rem; letter-spacing: 0.12em; }
}

/* Section base */
.section { padding: 6rem 0; }
.section-header { text-align: center; margin-bottom: 3.5rem; }
.section-header .kicker { display: inline-block; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em;  color: var(--accent); margin-bottom: 0.75rem; }
.section-header h2 { font-size: clamp(1.75rem, 3.5vw, 2.75rem); color: var(--ink); }
.section-header p { color: var(--ink-muted); font-size: 1.0625rem; max-width: 600px; margin: 1rem auto 0; }

/* Services */
.services { background: var(--bg); }
.services-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
@media (min-width: 640px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .services-grid { grid-template-columns: repeat(3, 1fr); } }
.service-card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 2rem; transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s; }
.service-card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 12px 32px var(--shadow-strong); }
.service-icon { width: 48px; height: 48px; margin-bottom: 1rem; color: var(--accent); }
.service-card h3 { font-size: 1.25rem; margin-bottom: 0.5rem; color: var(--ink); }
.service-card p { color: var(--ink-muted); font-size: 0.9375rem; line-height: 1.7; }

/* Process */
.process { background: var(--bg); }
.flow-stages { display: grid; grid-template-columns: 1fr; gap: 1.5rem; counter-reset: step; }
@media (min-width: 768px) { .flow-stages { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .flow-stages { grid-template-columns: repeat(4, 1fr); } }
.process-step { position: relative; padding: 2rem 1.5rem; background: var(--card); border: 1px solid var(--line); border-radius: 8px; }
.process-step::before { counter-increment: step; content: counter(step); position: absolute; top: -0.75rem; left: 1.5rem; width: 1.5rem; height: 1.5rem; display: flex; align-items: center; justify-content: center; background: var(--accent); color: var(--bg); font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 0.75rem; border-radius: 50%; }
.process-step h3 { font-size: 1.125rem; margin-bottom: 0.5rem; padding-left: 0.5rem; }
.process-step p { color: var(--ink-muted); font-size: 0.9375rem; line-height: 1.7; }

/* Quote Form */
.quote { background: var(--charcoal-light); }
#lbq { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 2.5rem; max-width: 720px; margin: 0 auto; }
@media (min-width: 768px) { #lbq { padding: 3rem; } }
#lbq[data-site] { --form-accent: var(--accent); }
.quote-row { display: grid; grid-template-columns: 1fr; gap: 1.25rem; margin-bottom: 1.25rem; }
@media (min-width: 640px) { .quote-row.half { grid-template-columns: 1fr 1fr; } }
.quote-field { display: flex; flex-direction: column; gap: 0.5rem; }
.quote-field label { font-size: 0.8125rem; font-weight: 500; color: var(--ink); }
.quote-field input, .quote-field select, .quote-field textarea {
  width: 100%; padding: 0.875rem 1rem; font-family: inherit; font-size: 1rem;
  background: var(--bg); color: var(--ink); border: 1px solid var(--line); border-radius: 6px;
  transition: border-color 0.15s, box-shadow 0.15s;
}
.quote-field input:focus, .quote-field select:focus, .quote-field textarea:focus {
  border-color: var(--accent); box-shadow: 0 0 0 3px rgba(201,168,118,0.2); outline: none;
}
.quote-field input::placeholder, .quote-field textarea::placeholder { color: var(--ink-muted); opacity: 0.6; }
.quote-field textarea { min-height: 120px; resize: vertical; }
.quote-field .honeypot { position: absolute; left: -9999px; opacity: 0; pointer-events: none; }
.quote-submit { display: flex; justify-content: center; margin-top: 0.5rem; }
.quote-note { text-align: center; font-size: 0.75rem; color: var(--ink-muted); margin-top: 1rem; }
.quote-status { min-height: 1.25rem; text-align: center; font-size: 0.875rem; margin-top: 1rem; }
.quote-status.success { color: #4ade80; }
.quote-status.error { color: #f87171; }

/* Contact / Footer */
.contact { background: var(--charcoal); padding: 4rem 0; border-top: 1px solid var(--line); }
.contact-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; text-align: center; }
@media (min-width: 768px) { .contact-grid { grid-template-columns: repeat(3, 1fr); text-align: left; } }
.contact-block h3 { font-size: 1rem; font-weight: 600; margin-bottom: 1rem; color: var(--ink); }
.contact-block p, .contact-block a { color: var(--ink-muted); font-size: 0.9375rem; line-height: 1.8; transition: color 0.15s; }
.contact-block a:hover { color: var(--accent); }
.contact-block .logo { margin-bottom: 1rem; }
.footer-bottom { border-top: 1px solid var(--line); margin-top: 3rem; padding-top: 1.5rem; text-align: center; font-size: 0.8125rem; color: var(--ink-muted); }

</style>
<style id="rv-lock">html .rv.on{opacity:1!important;transform:none!important}
.hero-copy{z-index:2;pointer-events:auto}
/* quote section: header copy + house quote form together, pinned to dark section palette */
#quote{background:var(--charcoal-light)}
#quote .kicker{color:#d4b88c}
#quote .section-header h2{color:#f5f5f0}
#quote .section-header p{color:#ccd1d6}
#quote #lbq{background:transparent;padding:8px 0 0;--lbq-ink:#f5f5f0;--lbq-muted:#c6cbd0;--lbq-accent:#d4b88c;--lbq-line:rgba(245,245,240,.22);--lbq-panel:rgba(255,255,255,.05)}
#quote #lbq .lbq-w{max-width:640px}
#quote #lbq h2{display:none}
#quote #lbq p.lbq-s{display:none}
/* footer/contact pinned to its permanent dark background (both colour schemes) */
.contact .contact-block h3{color:#f5f5f0}
.contact .logo-name{color:#f5f5f0}
.contact .logo-tagline{color:#d4b88c}
.contact-block p,.contact-block a{color:#c9ced3}
.contact-block a:hover{color:#d4b88c}
.footer-bottom{color:#b7bcc2}
/* pulse */
.lb-pulse{position:fixed;bottom:1.4rem;right:1.4rem;width:9px;height:9px;background:var(--accent);border-radius:50%;opacity:.45;animation:lbpulse 2s ease-in-out infinite;pointer-events:none;z-index:999}
@keyframes lbpulse{0%,100%{opacity:.3;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
@media (prefers-reduced-motion: reduce){.lb-pulse{animation:none;opacity:.5}}
/* legal (privacy/terms) */
#legal{background:var(--charcoal);color:#c9ced3;padding:48px 1.5rem}
#legal > *{max-width:1100px;margin-left:auto;margin-right:auto}
#legal h2{font-size:1.05rem;margin:1.2rem 0 .4rem;color:#f5f5f0}
#legal p{font-size:.9rem;line-height:1.7}
</style>
<noscript><style>.rv,.drop,.hg-item,.sld-item,[data-ux]{opacity:1!important;transform:none!important;visibility:visible!important}#sigSplash{display:none!important}.sld-item{position:static!important;margin-top:14px}</style></noscript>

<style id="lb-brand-css">
/* ==== LB BRAND (logo-true spanning wordmark) ==== */
.lb-brand{display:inline-flex;align-items:center;gap:clamp(9px,1vw,16px);text-decoration:none;
 color:inherit;min-width:0;padding:0;background:none;border:0;flex:0 1 auto}
.lb-brand__mark{flex:0 0 auto;display:block;height:clamp(34px,4.1vw,58px);width:auto;max-width:22vw}
.lb-brand__mark img{display:block;height:100%;width:auto;max-width:22vw;object-fit:contain}
.lb-brand__word{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:.94}
.lb-brand__name{font-family:var(--lb-disp,Inter),sans-serif;font-weight:700;text-transform:uppercase;
 font-size:clamp(21px,2.75vw,44px);letter-spacing:.004em;white-space:nowrap;line-height:.92;
 color:var(--lb-name,currentColor)}
.lb-brand__name .lb-acc{color:var(--lb-acc,currentColor)}
.lb-brand__sub{font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;text-transform:uppercase;
 font-size:clamp(7px,.82vw,12px);letter-spacing:.30em;white-space:nowrap;margin-top:.34em;
 color:var(--lb-subc,currentColor);opacity:.86}
.lb-brand__rule{display:block;height:3px;width:100%;margin-top:.5em;border-radius:2px;
 background:linear-gradient(90deg,var(--lb-acc,currentColor),transparent)}
@media (max-width:640px){
 .lb-brand__mark{height:clamp(30px,8vw,40px)}
 .lb-brand__name{font-size:clamp(18px,6.2vw,26px)}
 .lb-brand__sub{letter-spacing:.2em;font-size:7px}
}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style id="lb-motion-css">
/* ==== LB MOTION PACK ==== */
.lb-rb,.lb-rb *,.lb-mq,.lb-mq *{box-sizing:border-box}
/* A header must never be hidden by a scroll-reveal state: the nav/brand is chrome, not
   content. Unrevealed .rv wrappers left whole headers at opacity:0 (invisible logo). */
header, .site-header, .page-header, nav.nav, .nav .rv, nav.rv, .header-inner, .nav-inner,
header .rv, .site-header .rv, .nav-inner .rv{
  opacity:1 !important; visibility:visible !important; transform:none !important;
}
.lb-rb{position:relative;width:100%;max-width:100%;overflow:hidden;background:#0c0d10}
.lb-mq{max-width:100%;overflow:hidden}
.lb-rb__track{position:relative;width:100%;aspect-ratio:16/7}
.lb-rb__slide{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;will-change:opacity}
.lb-rb__slide.is-on{opacity:1}
.lb-rb__slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.03);transition:transform 7s linear}
.lb-rb__slide.is-on img{transform:scale(1.10)}
.lb-rb__cap{position:absolute;left:0;right:0;bottom:0;padding:clamp(14px,2.2vw,30px);
 background:linear-gradient(180deg,transparent,rgba(6,7,10,.72));color:#fff;
 font-family:var(--lb-sub,Inter),sans-serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
 font-size:clamp(9px,1vw,13px);z-index:2}
.lb-rb__dots{position:absolute;top:50%;right:clamp(10px,1.6vw,22px);transform:translateY(-50%);
 display:flex;flex-direction:column;gap:9px;z-index:3}
.lb-rb__dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.7);
 background:transparent;cursor:pointer;padding:0;transition:transform .25s,background .25s}
.lb-rb__dots button.is-on{background:#fff;transform:scale(1.35)}
.lb-rb__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;
 border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(8,9,12,.35);color:#fff;
 cursor:pointer;display:grid;place-items:center;font-size:17px;line-height:1;backdrop-filter:blur(6px);
 transition:background .25s,transform .25s}
.lb-rb__nav:hover{background:rgba(8,9,12,.7)}
.lb-rb__nav--prev{left:clamp(10px,1.6vw,22px)}
.lb-rb__nav--next{right:clamp(10px,1.6vw,22px)}
.lb-rb__nav:active{transform:translateY(-50%) scale(.92)}
@media (max-width:700px){.lb-rb__track{aspect-ratio:4/3}.lb-rb__nav{width:36px;height:36px}}

a.btn,.btn,button.btn,.nav-cta a,.wp-block-button__link{position:relative;overflow:hidden;
 transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s,filter .22s}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{transform:translateY(-2px);
 box-shadow:0 10px 24px -12px rgba(0,0,0,.55);filter:brightness(1.05)}
a.btn:active,.btn:active,button.btn:active,.nav-cta a:active{transform:translateY(0) scale(.985)}
a.btn::after,.btn::after,.nav-cta a::after{content:'';position:absolute;top:0;bottom:0;width:38%;
 left:-60%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.32),transparent);
 transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
a.btn:hover::after,.btn:hover::after,.nav-cta a:hover::after{left:130%}

.lb-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.3,1)}
.lb-rv.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
 .lb-rv{opacity:1!important;transform:none!important;transition:none!important}
 .lb-rb__slide img{transform:none!important;transition:none!important}
 a.btn::after,.btn::after,.nav-cta a::after{display:none}
}

/* marquee band (professional, reference-derived) */
.lb-mq{position:relative;overflow:hidden;background:#0b0c10;border-top:1px solid rgba(255,255,255,.10);
 border-bottom:1px solid rgba(255,255,255,.10)}
.lb-mq__in{display:flex;width:max-content;animation:lb-mq 34s linear infinite}
.lb-mq:hover .lb-mq__in{animation-play-state:paused}
.lb-mq__in span{display:inline-flex;align-items:center;gap:clamp(18px,3vw,44px);
 padding:clamp(11px,1.5vw,19px) clamp(14px,2vw,26px);color:#fff;font-family:var(--lb-disp,Inter),sans-serif;
 font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:clamp(11px,1.25vw,17px);white-space:nowrap}
.lb-mq__in span i{font-style:normal;color:var(--lb-acc,#e51924)}
@keyframes lb-mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.lb-mq__in{animation:none}}
</style>
<style id="lb-depth-css">
/* ==== LB DEPTH PACK — layered shadow + gradient surfaces ==== */
:root{
  --lb-acc: var(--acc, var(--accent, #e51924));
  --lb-ink: var(--ink, #14161a);
  --lb-paper: var(--paper, #ffffff);
  --lb-e1: 0 1px 2px rgba(8,10,14,.06), 0 2px 6px rgba(8,10,14,.05);
  --lb-e2: 0 2px 4px rgba(8,10,14,.07), 0 8px 18px -6px rgba(8,10,14,.14);
  --lb-e3: 0 4px 10px rgba(8,10,14,.09), 0 18px 40px -12px rgba(8,10,14,.22);
  --lb-hair: rgba(8,10,14,.10);
}
body{ -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

/* sections: soft accent-keyed gradient wash for depth, never a flat slab */
section{ position:relative; }
section::before{
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(120% 70% at 12% 0%, color-mix(in srgb, var(--lb-acc) 7%, transparent) 0%, transparent 58%),
    radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--lb-acc) 5%, transparent) 0%, transparent 60%);
}
section > *{ position:relative; z-index:1; }

/* cards / panels / figures: gradient surface + hairline + elevation, lift on hover */
.card,.cards > *,.panel,.tile,.service,.box,.grid > article,.grid > div,figure,.gal figure,.gallery figure{
  background:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 100%, transparent) 0%,
                                    color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  border:1px solid var(--lb-hair);
  border-radius:14px;
  box-shadow:var(--lb-e1);
  transition:transform .28s cubic-bezier(.2,.7,.3,1), box-shadow .28s, border-color .28s;
}
.card:hover,.cards > *:hover,.panel:hover,.tile:hover,.service:hover,.grid > article:hover,
.grid > div:hover,figure:hover,.gal figure:hover,.gallery figure:hover{
  transform:translateY(-4px); box-shadow:var(--lb-e3); border-color:color-mix(in srgb, var(--lb-acc) 34%, var(--lb-hair));
}

/* photographs: rounded, layered shadow, slight scrim so text over them stays legible */
section img, figure img, .gal img, .gallery img, .card img{
  border-radius:10px; box-shadow:var(--lb-e2); display:block;
}
figure, .gal figure, .gallery figure{ overflow:hidden; }
figure img, .gal img{ transform:scale(1.001); transition:transform .5s cubic-bezier(.2,.7,.3,1); }
figure:hover img, .gal figure:hover img, .gallery figure:hover img{ transform:scale(1.035); }

/* buttons: gradient fill, inset highlight, layered shadow */
a.btn,.btn,button.btn,.nav-cta a,.btn-primary{
  background-image:linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,0) 55%);
  box-shadow:var(--lb-e1), inset 0 1px 0 rgba(255,255,255,.22);
  border-radius:10px;
}
a.btn:hover,.btn:hover,button.btn:hover,.nav-cta a:hover{
  box-shadow:var(--lb-e3), inset 0 1px 0 rgba(255,255,255,.26);
}
.btn-ghost{ box-shadow:var(--lb-e1); }

/* nav: subtle vertical gradient + hairline for separation from the page */
.nav,nav,.site-header,header.nav{
  background-image:linear-gradient(180deg, color-mix(in srgb, var(--lb-paper) 96%, transparent) 0%,
                                         color-mix(in srgb, var(--lb-ink) 3%, var(--lb-paper)) 100%);
  box-shadow:0 1px 0 var(--lb-hair), 0 6px 20px -14px rgba(8,10,14,.28);
}

/* section heads get a hairline rule for structure (no risky text clipping) */
.sec-head{ border-bottom:1px solid var(--lb-hair); padding-bottom:.7rem; }
h1,h2,h3{ text-wrap:balance; }

/* footer: depth anchor */
footer{ box-shadow:0 -1px 0 var(--lb-hair), 0 -14px 40px -30px rgba(8,10,14,.5); }

/* dark surfaces get stronger, softer shadows */
@media (prefers-color-scheme: dark){ :root{ --lb-hair: rgba(255,255,255,.12); } }
@supports not (background: color-mix(in srgb, red 5%, blue)){
  section::before{ background:radial-gradient(120% 70% at 12% 0%, rgba(229,25,36,.06) 0%, transparent 58%); }
}
@media (prefers-reduced-motion: reduce){
  .card,.cards > *,.panel,.tile,figure,.gal figure, a.btn,.btn, img{ transition:none!important; transform:none!important; }
}
